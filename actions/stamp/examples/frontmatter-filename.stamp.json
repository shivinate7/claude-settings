{
  "defaultBranch": "main",
  "kinds": [
    {
      "id": "decision",
      "folder": "docs/decisions",
      "prefix": "D",
      "pad": 0,
      "location": "frontmatter+filename",
      "filenamePendingPrefix": "_",
      "filenameTemplate": "{prefix}{n}_{rest}.md",
      "idTemplate": "{prefix}{n}",
      "pendingRegex": "^id:[ \\t]*$",
      "order": "date",
      "numbering": "lowest_free",
      "slugField": "slug",
      "dateField": "date",
      "glossField": "gloss",
      "requireFieldsOnPending": ["date", "gloss"]
    },
    {
      "id": "finding",
      "folder": "docs/findings",
      "prefix": "F",
      "pad": 0,
      "location": "frontmatter+filename",
      "filenamePendingPrefix": "_",
      "filenameTemplate": "{prefix}{n}_{rest}.md",
      "idTemplate": "{prefix}{n}",
      "pendingRegex": "^id:[ \\t]*$",
      "order": "date",
      "numbering": "lowest_free",
      "slugField": "slug",
      "dateField": "date",
      "glossField": "gloss",
      "requireFieldsOnPending": ["date", "gloss"]
    }
  ],
  "cite": {
    "pattern": "\\[\\[([a-z0-9][a-z0-9._-]*)\\]\\]",
    "slugGroup": 1,
    "template": "{id}, {gloss}",
    "scanGlobs": ["**/*.md", "**/*.py", "**/*.csv"],
    "excludeGlobs": ["test/fixtures/**", "docs/citation-syntax.md"]
  }
}
