#!/usr/bin/env python3
# wait-until TIME [--timeout SECS]: wait until one clock time, then exit. It only waits; it runs no command and
# signals no process. Chain the command after it: `wait-until TIME && cmd`.
# TIME is an ISO-8601 instant with a zone: `Z` or a numeric offset (2026-11-06T22:48:00Z, 2026-11-06T17:48:00-05:00).
# Exit 0: the time has come, or was already past at the start. 124: still short of the time at --timeout
# (no --timeout means no cap: the target time ends the wait). 2: a bad argument, a bad time, or a time with no zone,
# at once, with no wait. While it waits, print "wait-until: still waiting until TIME, <s>s" every
# $WAIT_UNTIL_HEARTBEAT s (default 120), so a quiet background run does not trip the stall watch.
# The argument, heartbeat and poll parts are hooks/wait_common.py, shared with bin/wait-pid.
import os, sys, time
from datetime import datetime
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import wait_common  # noqa: E402  the one home of the argument, heartbeat and poll parts both wait helpers share
PROG = "wait-until"
USAGE = "usage: wait-until TIME [--timeout SECS]  (TIME: ISO-8601 with a zone, such as 2026-11-06T22:48:00Z)"
def parse_time(text):
    """The epoch seconds of an ISO-8601 instant that carries a zone; exit 2 for anything else."""
    try:
        when = datetime.fromisoformat(text[:-1] + "+00:00" if text[-1:] in ("Z", "z") else text)
        if when.utcoffset() is None:
            wait_common.die(PROG, "time %r has no zone. %s" % (text, USAGE))
        return when.timestamp()
    except (ValueError, OverflowError, OSError):
        wait_common.die(PROG, "bad time %r. %s" % (text, USAGE))
def main(argv):
    text, timeout = wait_common.split_args(PROG, USAGE, argv)
    if text is None: wait_common.die(PROG, USAGE)
    target = parse_time(text)
    if time.time() >= target:
        print("wait-until: %s is already past" % text, flush=True); return 0
    def step(elapsed):
        if time.time() >= target:
            print("wait-until: %s has come, after %.0fs" % (text, elapsed), flush=True); return 0
    return wait_common.wait_loop(PROG, step, timeout, wait_common.heartbeat_seconds("WAIT_UNTIL_HEARTBEAT"),
                                 lambda s: "still waiting until %s, %.0fs" % (text, s),
                                 lambda s: "%s has not come after %.0fs" % (text, s))
if __name__ == "__main__":
    for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")
    sys.exit(main(sys.argv[1:]))
