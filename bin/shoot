#!/usr/bin/env node
// shoot [--config F] [--out DIR]: one PNG per route x width x theme, then one verdict line.
// Beside each PNG it writes the rendered page as .html, for lint/label_once.py (ux-label-once).
// F defaults to .claude/shoot.json in the current folder. DIR defaults to a new shoot-* folder in the temp folder.
// Config keys (decision shoot-is-one-shared-command):
//   baseUrl (required; a path in it is kept: base http://h/app and route /a shoot http://h/app/a),
//   routes (required: "/path" strings or {name, path}; two routes with the same file name are a config error), sizes (widths, default 1440, 820, 390),
//   themes (light and dark, the default; set through prefers-color-scheme), height (default 900),
//   fullPage (default true), timeoutMs (per route and per route step, default 15000), simulator (an iOS simulator UDID, optional),
//   ignoreHTTPSErrors (boolean, default false; true shoots an app with a self-signed certificate).
// Route keys beyond name and path, both optional (a bad value is a config error):
//   steps (the route steps): a non-empty list, run in order after the page loads and its status passes, before the screenshot.
//     Each route step is {click: css} or {wait: css, state: "visible" | "hidden"} (state defaults to visible).
//     A route step that errors or times out fails the shot. A hidden wait passes at once when nothing matches the
//     selector, so it alone proves nothing: pair it with a wait for real content.
//   localStorage: {key: "value"}, strings only. Set before the page's own scripts run, in the top frame only.
//   A route with steps or localStorage runs in its own browser context, with ignoreHTTPSErrors carried into it. The context is closed
//     after the shot, so the route starts clean and leaves nothing behind (localStorage, cookies) for another route.
// Other keys, on the config or on a route, are ignored.
// A shot fails on a navigation error, a timeout, an HTTP status of 400 or more, or a blank image (one colour only).
// The simulator shot runs only when that device is already booted. This tool never boots one; not booted is a skip.
// Playwright: the installed package only. This tool never runs `playwright install`.
// Exit: 0 every shot passed, 1 a shot failed, 2 it could not run (usage, config, no Playwright, no browser).
// Touch per size: a width under 1024 (TOUCH_BELOW) gets hasTouch, so (pointer: coarse) matches; 1024 and wider has none. No config key.
//   Chromium drops the coarse match in a full-page capture however it is asked, and a resize to content height stretches each 100vh block.
//   So a touch shot with fullPage is stitched: one viewport screenshot per tile, scrolled to each, joined in a canvas on a second page of
//   the same browser. Tiles cover the root element's scroll width and height. A page that scrolls its body, not its root, gets a
//   smaller PNG than a plain full-page capture.
//   Tiles after the first hide position:fixed elements, fixed ::before and ::after, and the images of fixed backgrounds (the colour
//   stays), so each shows once, at its first-tile place. An element mixing fixed and scroll layers loses its scroll layers on those tiles.
//   For the whole stitch, sticky elements sit in the flow and the root does not scroll-snap. A canvas Chromium cannot read back fails that shot.
//   A desktop width takes the plain full-page capture.
// Cost: one browser process per run, closed at exit. Two files per shot (PNG and HTML). A stitched shot adds one screenshot per viewport tile
//   (columns across the scroll width times rows down the scroll height) and one extra page for the join. No daemon, no watcher.
// Test seam: SHOOT_PLAYWRIGHT names the module to load (default playwright).
"use strict";
const fs = require("fs");
const os = require("os");
const path = require("path");
const zlib = require("zlib");
const { createRequire } = require("module");
const { execFileSync } = require("child_process");

const TOUCH_BELOW = 1024;

function die(msg) { console.log("shoot: " + msg); process.exit(2); }

function args(argv) {
  const o = { config: path.join(".claude", "shoot.json"), out: null };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if ((a === "--config" || a === "--out") && i + 1 < argv.length) o[a.slice(2)] = argv[++i];
    else die("usage: shoot [--config FILE] [--out DIR]");
  }
  return o;
}

function readConfig(file) {
  let c;
  try { c = JSON.parse(fs.readFileSync(file, "utf8")); } catch (e) { die(`cannot read config ${file}: ${e.message.split("\n")[0]}`); }
  if (!c || typeof c.baseUrl !== "string" || !c.baseUrl) die(`config ${file} needs baseUrl`);
  if (!Array.isArray(c.routes) || !c.routes.length) die(`config ${file} needs a non-empty routes list`);
  const routes = c.routes.map((r) => (typeof r === "string" ? { path: r } : r));
  if (routes.some((r) => !r || typeof r.path !== "string")) die(`config ${file}: each route is a string or {name, path}`);
  const names = new Map();
  for (const r of routes) {
    const n = slug(r.name || r.path);
    if (names.has(n)) die(`config ${file}: routes ${names.get(n)} and ${r.path} both write ${n}-*.png`);
    names.set(n, r.path);
  }
  for (const r of routes) {
    if (r.steps !== undefined) checkSteps(file, r);
    if (r.localStorage !== undefined) checkStorage(file, r);
  }
  if (c.ignoreHTTPSErrors !== undefined && typeof c.ignoreHTTPSErrors !== "boolean") die(`config ${file}: ignoreHTTPSErrors is true or false`);
  const sizes = c.sizes ?? [1440, 820, 390];
  if (!Array.isArray(sizes) || !sizes.length || sizes.some((w) => !Number.isInteger(w) || w < 1)) die(`config ${file}: sizes is a list of widths`);
  const themes = c.themes ?? ["light", "dark"];
  if (!Array.isArray(themes) || !themes.length || themes.some((t) => t !== "light" && t !== "dark")) die(`config ${file}: themes holds light and dark only`);
  return {
    baseUrl: c.baseUrl, routes, sizes, themes,
    height: c.height ?? 900, fullPage: c.fullPage ?? true, timeoutMs: c.timeoutMs ?? 15000,
    simulator: c.simulator || null, ignoreHTTPSErrors: c.ignoreHTTPSErrors ?? false,
  };
}

const isObject = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
const isSelector = (v) => typeof v === "string" && v.trim() !== "";
const has = (o, k) => Object.prototype.hasOwnProperty.call(o, k);

function checkSteps(file, r) {
  const where = `config ${file}: route ${r.path}: steps`;
  if (!Array.isArray(r.steps) || !r.steps.length) die(`${where} is a non-empty list`);
  const form = `${where}: each route step is {click: css} or {wait: css, state: "visible" or "hidden"}`;
  for (const s of r.steps) {
    if (!isObject(s)) die(form);
    const keys = Object.keys(s);
    if (has(s, "click")) { if (keys.length !== 1 || !isSelector(s.click)) die(form); }
    else if (has(s, "wait")) {
      if (keys.some((k) => k !== "wait" && k !== "state") || !isSelector(s.wait)) die(form);
      if (has(s, "state") && s.state !== "visible" && s.state !== "hidden") die(form);
    } else die(form);
  }
}

function checkStorage(file, r) {
  if (!isObject(r.localStorage) || Object.values(r.localStorage).some((v) => typeof v !== "string")) {
    die(`config ${file}: route ${r.path}: localStorage is an object of strings`);
  }
}

// Runs in the page. The top frame only: a cross-origin frame (an embed) keeps its own, empty storage.
function seedStorage(entries) {
  if (window !== window.top) return;
  try { for (const [k, v] of entries) localStorage.setItem(k, v); } catch { /* storage blocked: the shot shows it */ }
}

// The installed package, from the global paths first, then the current repo's node_modules.
function loadPlaywright() {
  const id = process.env.SHOOT_PLAYWRIGHT || "playwright";
  for (const req of [require, createRequire(path.join(process.cwd(), "package.json"))]) {
    try { return req(id); } catch { /* next */ }
  }
  die(`FAIL: Playwright is missing: require('${id}') does not resolve. Install the playwright package; this tool never installs it.`);
}

// Joins as text, so a path in baseUrl survives a route that starts with "/" (new URL would drop it).
function join(base, p) { return base.replace(/\/+$/, "") + "/" + p.replace(/^\/+/, ""); }

function slug(s) { return s.replace(/^\/+/, "").replace(/[^A-Za-z0-9._-]+/g, "_").replace(/^_+|_+$/g, "") || "root"; }

// True when every pixel of an 8-bit, non-interlaced PNG (what Chromium writes) has one colour.
// Any other PNG form reads as not blank, so this check can only add a fail, never hide one.
function isBlank(buf) {
  const w = buf.readUInt32BE(16), h = buf.readUInt32BE(20), depth = buf[24], type = buf[25], lace = buf[28];
  const ch = { 2: 3, 6: 4 }[type];
  if (depth !== 8 || !ch || lace) return false;
  const idat = [];
  for (let p = 8; p < buf.length;) {
    const len = buf.readUInt32BE(p), kind = buf.toString("ascii", p + 4, p + 8);
    if (kind === "IDAT") idat.push(buf.subarray(p + 8, p + 8 + len));
    p += 12 + len;
  }
  const raw = zlib.inflateSync(Buffer.concat(idat)), stride = w * ch;
  let prev = Buffer.alloc(stride), first = null;
  for (let y = 0; y < h; y++) {
    const f = raw[y * (stride + 1)], row = Buffer.from(raw.subarray(y * (stride + 1) + 1, (y + 1) * (stride + 1)));
    for (let x = 0; x < stride; x++) {
      const a = x >= ch ? row[x - ch] : 0, b = prev[x], c = x >= ch ? prev[x - ch] : 0;
      let add = 0;
      if (f === 1) add = a; else if (f === 2) add = b; else if (f === 3) add = (a + b) >> 1;
      else if (f === 4) { const q = a + b - c, pa = Math.abs(q - a), pb = Math.abs(q - b), pc = Math.abs(q - c); add = pa <= pb && pa <= pc ? a : pb <= pc ? b : c; }
      row[x] = (row[x] + add) & 255;
    }
    if (!first) first = row.subarray(0, ch);
    for (let x = 0; x < stride; x += ch) if (row.compare(first, 0, ch, x, x + ch)) return false;
    prev = row;
  }
  return true;
}

// Runs in the page: for the whole stitch, sticky elements sit in the flow (a sticky one would otherwise jump per tile), as
// position:relative with no offsets, not static, so an absolute child keeps the element as its containing block. A sticky element
// always makes a stacking context and a relative one with z-index auto does not, so that gets z-index 0. The root does
// not snap (a snap point would move a tile off its scroll offset). on false restores the inline values, each with its priority.
function settleForStitch(on) {
  const root = document.documentElement;
  if (on) { if (root.__shootSnap === undefined) root.__shootSnap = root.style.scrollSnapType; root.style.scrollSnapType = "none"; }
  else if (root.__shootSnap !== undefined) { root.style.scrollSnapType = root.__shootSnap; delete root.__shootSnap; }
  const names = ["position", "top", "right", "bottom", "left", "z-index"];
  const set = (el, prop, value) => {
    if (el.__shootInline === undefined) el.__shootInline = {};
    if (!(prop in el.__shootInline)) el.__shootInline[prop] = [el.style.getPropertyValue(prop), el.style.getPropertyPriority(prop)];
    el.style.setProperty(prop, value, "important");
  };
  for (const el of document.querySelectorAll("*")) {
    if (on) {
      if (getComputedStyle(el).position !== "sticky") continue;
      const auto = getComputedStyle(el).zIndex === "auto";
      set(el, "position", "relative");
      if (auto) set(el, "z-index", "0");
      for (const side of ["top", "right", "bottom", "left"]) set(el, side, "auto");
    } else if (el.__shootInline !== undefined) {
      for (const prop of names) if (prop in el.__shootInline) el.style.setProperty(prop, ...el.__shootInline[prop]);
      delete el.__shootInline;
    }
  }
}

// Runs in the page: hide (or restore) each fixed element, each fixed ::before or ::after, and the images of each fixed background
// (the colour stays), on the element or on a pseudo-element, so a tile after the first repeats none of them. A pseudo-element has
// no inline style, so its host carries a mark and one constructed stylesheet hides the marked ones. A constructed sheet is CSSOM,
// so a page's style-src policy does not block it, as it would a style element. An element that mixes fixed and scroll layers
// loses its scroll layers too.
function hideFixed(on) {
  const sides = ["before", "after"];
  for (const el of document.querySelectorAll("*")) {
    if (on) {
      if (getComputedStyle(el).position === "fixed") {
        if (el.__shootVis === undefined) el.__shootVis = el.style.visibility;
        el.style.visibility = "hidden";
      }
      if (getComputedStyle(el).backgroundAttachment.includes("fixed")) {
        if (el.__shootBg === undefined) el.__shootBg = [el.style.getPropertyValue("background-image"), el.style.getPropertyPriority("background-image")];
        el.style.setProperty("background-image", "none", "important");
      }
      for (const s of sides) {
        const cs = getComputedStyle(el, "::" + s);
        if (cs.position === "fixed") el.setAttribute("data-shoot-fixed-" + s, "");
        if (cs.backgroundAttachment.includes("fixed")) el.setAttribute("data-shoot-fixed-bg-" + s, "");
      }
    } else {
      if (el.__shootVis !== undefined) { el.style.visibility = el.__shootVis; delete el.__shootVis; }
      if (el.__shootBg !== undefined) { el.style.setProperty("background-image", ...el.__shootBg); delete el.__shootBg; }
      for (const s of sides) { el.removeAttribute("data-shoot-fixed-" + s); el.removeAttribute("data-shoot-fixed-bg-" + s); }
    }
  }
  if (document.__shootSheet) {
    document.adoptedStyleSheets = document.adoptedStyleSheets.filter((x) => x !== document.__shootSheet);
    delete document.__shootSheet;
  }
  if (on) {
    const sheet = new CSSStyleSheet();
    sheet.replaceSync(sides.map((s) => `[data-shoot-fixed-${s}]::${s}{visibility:hidden!important}[data-shoot-fixed-bg-${s}]::${s}{background-image:none!important}`).join(""));
    document.adoptedStyleSheets = [...document.adoptedStyleSheets, sheet];
    document.__shootSheet = sheet;
  }
}

// Runs in a second page: join viewport tiles, rows of them, each tile at its scroll offset, into one PNG data URL. A tile draws
// only the rows and columns no earlier tile covered: the last row and the last column overlap the ones before them, and their
// hidden fixed elements must not blank what those tiles drew.
async function joinTiles([rows, width, height]) {
  const c = document.createElement("canvas");
  c.width = width; c.height = height;
  const g = c.getContext("2d");
  let coveredY = 0;
  for (const row of rows) {
    let coveredX = 0, rowBottom = coveredY;
    for (const t of row) {
      const img = new Image();
      img.src = "data:image/png;base64," + t.data;
      await img.decode();
      const sx = Math.max(0, coveredX - t.x), sy = Math.max(0, coveredY - t.y);
      const w = img.width - sx, h = img.height - sy;
      if (w > 0 && h > 0) g.drawImage(img, sx, sy, w, h, t.x + sx, t.y + sy, w, h);
      coveredX = Math.max(coveredX, t.x + img.width);
      rowBottom = Math.max(rowBottom, t.y + img.height);
    }
    coveredY = rowBottom;
  }
  return c.toDataURL("image/png");
}

// A full-page shot that keeps the page's touch emulation: viewport tiles, scrolled and joined (see the header).
async function stitchShot(browser, page, width, height, timeout) {
  const rows = [];
  let full;
  try {
    await page.evaluate(settleForStitch, true);
    full = await page.evaluate(() => ({ w: document.documentElement.scrollWidth, h: document.documentElement.scrollHeight }));
    for (let y = 0; y < full.h; y += height) {
      const row = [];
      for (let x = 0; x < full.w; x += width) {
        // The last row and column scroll only as far as the page allows, so each tile's real offset is read back.
        const at = await page.evaluate(([left, top]) => {
          window.scrollTo({ left, top, behavior: "instant" });
          return { x: window.scrollX, y: window.scrollY };
        }, [x, y]);
        if (x > 0 || y > 0) await page.evaluate(hideFixed, true);
        row.push({ ...at, data: (await page.screenshot({ timeout })).toString("base64") });
        await page.evaluate(hideFixed, false);
      }
      rows.push(row);
    }
  } finally {
    await page.evaluate(hideFixed, false).catch(() => {});
    await page.evaluate(settleForStitch, false).catch(() => {});
    await page.evaluate(() => window.scrollTo({ left: 0, top: 0, behavior: "instant" })).catch(() => {});
  }
  const joiner = await browser.newPage();
  try {
    const url = await joiner.evaluate(joinTiles, [rows, full.w, full.h]);
    if (!url.startsWith("data:image/png;base64,")) throw new Error(`touch full-page shot: the canvas for ${full.w} x ${full.h} px could not be read`);
    return Buffer.from(url.split(",")[1], "base64");
  } finally {
    await joiner.close().catch(() => {});
  }
}

// The simulator shot. Booted state comes from `simctl list`; a device not booted is a skip.
function simShot(udid, out) {
  let list;
  try { list = JSON.parse(execFileSync("xcrun", ["simctl", "list", "devices", "-j"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], timeout: 30000 })); }
  catch (e) { return { skip: `simulator ${udid}: simctl unavailable (${String(e.message).split("\n")[0]})` }; }
  const dev = Object.values(list.devices || {}).flat().find((d) => d && d.udid === udid);
  if (!dev) return { skip: `simulator ${udid}: no such device` };
  if (dev.state !== "Booted") return { skip: `simulator ${udid}: not booted (${dev.state}); shoot never boots one` };
  const file = path.join(out, `simulator-${udid}.png`);
  try { execFileSync("xcrun", ["simctl", "io", udid, "screenshot", file], { stdio: ["ignore", "pipe", "pipe"], timeout: 30000 }); }
  catch (e) { return { fail: `simulator ${udid}: screenshot failed (${String(e.message).split("\n")[0]})` }; }
  return fs.existsSync(file) ? { file } : { fail: `simulator ${udid}: screenshot wrote no file` };
}

async function main() {
  const o = args(process.argv.slice(2));
  const cfg = readConfig(o.config);
  const pw = loadPlaywright();
  const out = o.out ? path.resolve(o.out) : fs.mkdtempSync(path.join(os.tmpdir(), "shoot-"));
  fs.mkdirSync(out, { recursive: true });
  let browser;
  try { browser = await pw.chromium.launch(); }
  catch (e) { die(`FAIL: Chromium did not launch: ${String(e.message).split("\n")[0]}. This tool never runs playwright install.`); }
  const fails = [], skips = [];
  let shots = 0;
  try {
    for (const theme of cfg.themes) {
      for (const width of cfg.sizes) {
        const opts = { viewport: { width, height: cfg.height }, colorScheme: theme, ignoreHTTPSErrors: cfg.ignoreHTTPSErrors, hasTouch: width < TOUCH_BELOW };
        const ctx = await browser.newContext(opts);
        try {
          for (const r of cfg.routes) {
            shots++;
            const name = `${slug(r.name || r.path)}-${width}-${theme}`;
            const url = join(cfg.baseUrl, r.path);
            // Storage and cookies are per context, so a route with steps (a click can write them) or a seed gets its own.
            const own = r.localStorage !== undefined || r.steps !== undefined ? await browser.newContext(opts) : null;
            const page = await (own || ctx).newPage();
            try {
              if (r.localStorage !== undefined) await page.addInitScript(seedStorage, Object.entries(r.localStorage));
              const res = await page.goto(url, { waitUntil: "load", timeout: cfg.timeoutMs });
              if (res && res.status() >= 400) { fails.push(`${name}: HTTP ${res.status()} at ${url}`); continue; }
              for (const s of r.steps || []) {
                if (s.click !== undefined) await page.click(s.click, { timeout: cfg.timeoutMs });
                else await page.waitForSelector(s.wait, { state: s.state || "visible", timeout: cfg.timeoutMs });
              }
              const file = path.join(out, name + ".png");
              let png;
              if (cfg.fullPage && opts.hasTouch) { png = await stitchShot(browser, page, width, cfg.height, cfg.timeoutMs); fs.writeFileSync(file, png); }
              else png = await page.screenshot({ path: file, fullPage: cfg.fullPage, timeout: cfg.timeoutMs });
              if (isBlank(png)) fails.push(`${name}: blank image (one colour) at ${url}`);
              // Mark each element the browser does not show, so the probe skips it (a phone nav on a wide screen).
              // A display:contents wrapper has no box but shows its children, so it is never marked.
              await page.evaluate(() => { for (const el of document.body ? document.body.querySelectorAll("*") : []) if (el.checkVisibility && getComputedStyle(el).display !== "contents" && !el.checkVisibility({ visibilityProperty: true })) el.setAttribute("hidden", ""); });
              fs.writeFileSync(path.join(out, name + ".html"), await page.content());
            } catch (e) {
              fails.push(`${name}: ${String(e.message).split("\n")[0]}`);
            } finally {
              await page.close().catch(() => {});
              if (own) await own.close().catch(() => {});
            }
          }
        } finally {
          await ctx.close().catch(() => {});
        }
      }
    }
  } finally {
    await browser.close().catch(() => {});
  }
  if (cfg.simulator) {
    const s = simShot(cfg.simulator, out);
    if (s.skip) skips.push(s.skip);
    else { shots++; if (s.fail) fails.push(s.fail); }
  }
  for (const f of fails) console.log("shoot: FAIL " + f);
  for (const s of skips) console.log("shoot: SKIP " + s);
  console.log(`shoot: ${fails.length ? "FAIL" : "PASS"} ${shots} shots, ${fails.length} failed${skips.length ? `, ${skips.length} skipped` : ""}, out=${out}`);
  process.exit(fails.length ? 1 : 0);
}

if (require.main === module) main().catch((e) => die(`FAIL: ${String(e && e.stack || e).split("\n")[0]}`));
module.exports = { isBlank };
