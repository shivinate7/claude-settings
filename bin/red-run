#!/usr/bin/env python3
# red-run <commit> [--add <path>]... [--replace <path> <old> <new>]... -- <test cmd>: run a test command in a copy of an old commit.
# A test-author shows a new case red on the old code with it, and a mutant of a file runs in the same copy. The copy is the commit's
# tree from this repo, with no .git in it or above it, in a run folder of the test temp root (<temp>/claude-settings-test-temp/<pid>-<uuid>,
# lint/_test_temp.py). --add puts this checkout's file (or folder) at the same path in the copy; --replace swaps the one literal text
# <old> for <new> in a copy's file (a text that is not there, or is there twice, is STALE: exit 2). Paths are read from this
# checkout's cwd and must lie inside this repo. The test command runs in the copy, and its output is printed as it stands, then one line
# names the class of the run: pass, assert (a FAIL line, the red that counts), crash (red with no FAIL line) or timeout (hooks/mutate_shared.py
# classify_run). The copy goes at the end of the run, whichever way it ends, and on TERM, HUP or INT, which stop the test command and the
# processes below it first. A run folder that a live process holds is kept by the sweep (lint/_test_temp.py), so a long run keeps its copy.
# Exit: 0 for a pass; 1 for any other end of the test command; 2 for a bad call, an unknown commit, a stale --replace or a test command that cannot start.
import os
import shutil
import signal
import subprocess
import sys
import tempfile

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "hooks"))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "lint"))
import _nowindow  # noqa: E402  the one home of a no-window child start and of the stop of a process tree (hooks/_nowindow.py)
from mutate_shared import AmbiguousMutant, CLASSIFIERS, StaleMutant, apply_mutant  # noqa: E402  the one home of the run's class and the literal replace
from tree_export import export_tree, manifest_add  # noqa: E402  the one home of the export of a commit's tree (hooks/tree_export.py)
import _test_temp  # noqa: E402  the one home of the run folder and its sweep (lint/_test_temp.py)

USAGE = "usage: red-run <commit> [--add <path>]... [--replace <path> <old> <new>]... -- <test cmd>"
STOP_GRACE = 5  # seconds the test command has to end on TERM before it is killed


class BadCall(Exception):
    """A refusal that exits 2. The message is the whole report."""


def parse(argv):
    """(commit, ops, cmd): ops is [("add", path) or ("replace", path, old, new)] in the order given."""
    if "--" not in argv:
        raise BadCall("no `--` before the test command\n" + USAGE)
    split = argv.index("--")
    head, cmd = argv[:split], argv[split + 1:]
    if not cmd:
        raise BadCall("no test command after `--`\n" + USAGE)
    if not head or head[0].startswith("-"):
        raise BadCall("no commit first\n" + USAGE)
    ops, i = [], 1
    while i < len(head):
        flag = head[i]
        need = {"--add": 1, "--replace": 3}.get(flag)
        if need is None:
            raise BadCall("%s is not a flag of red-run\n%s" % (flag, USAGE))
        if len(head) - i - 1 < need:
            raise BadCall("%s needs %d argument(s) before `--`\n%s" % (flag, need, USAGE))
        ops.append((flag[2:],) + tuple(head[i + 1:i + 1 + need]))
        i += 1 + need
    return head[0], ops, cmd


def git_out(*args):
    done = _nowindow.run(["git", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    return done.stdout.strip() if done.returncode == 0 else None


def repo_path(top, arg):
    """`arg`, read from the cwd, as a path relative to the repo at `top`. A path outside the repo is a bad call."""
    rel = os.path.relpath(os.path.realpath(os.path.abspath(arg)), os.path.realpath(top))
    if rel == os.curdir or rel == os.pardir or rel.startswith(os.pardir + os.sep) or os.path.isabs(rel):
        raise BadCall("%s is not a path inside the repo at %s" % (arg, top))
    return rel


def stop_child(proc):
    """End the test command and every process below it: TERM, a short wait, then KILL to each pid reached."""
    if proc.poll() is not None:
        return  # reaped: its pid may be reused, so nothing is signalled
    known = _nowindow.kill_tree(proc, signal.SIGTERM)
    try:
        proc.wait(timeout=STOP_GRACE)
    except subprocess.TimeoutExpired:
        pass
    _nowindow.kill_tree(proc, getattr(signal, "SIGKILL", signal.SIGTERM), known)  # a grandchild that outlived the child, or ignored TERM
    proc.wait()


def main(argv, state):
    commit, ops, cmd = parse(argv)
    top = git_out("rev-parse", "--show-toplevel")
    sha = git_out("rev-parse", "--verify", "--quiet", commit + "^{commit}") if top else None
    if not sha:
        raise BadCall("%s is not a commit of the repo in the current folder" % commit)
    prepared = []
    for op in ops:  # every path is read before any folder is made, so a bad call leaves no copy
        rel = repo_path(top, op[1])
        if op[0] == "add" and not os.path.exists(os.path.join(top, rel)):
            raise BadCall("--add: %s is not in this checkout" % op[1])
        prepared.append((op[0], rel) + op[2:])
    state["folder"] = folder = _test_temp.run_folder()
    error = export_tree(top, sha, folder)
    if error:
        print("red-run: the export of %s failed: %s" % (sha[:7], error), file=sys.stderr)
        return 2
    for op in prepared:
        if op[0] == "add":
            src, dest = os.path.join(top, op[1]), os.path.join(folder, op[1])
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            if os.path.isdir(src):
                shutil.copytree(src, dest, dirs_exist_ok=True)
                added = [os.path.relpath(os.path.join(root, name), folder).replace(os.sep, "/")
                         for root, _, names in os.walk(dest) for name in names]
            else:
                shutil.copyfile(src, dest)
                added = [op[1].replace(os.sep, "/")]
            manifest_add(folder, added)  # the copy has no .git: its listing reads the manifest
        else:
            try:
                apply_mutant(folder, op[2], op[3], files=[op[1]])
            except (StaleMutant, AmbiguousMutant) as exc:
                raise BadCall(str(exc))
    with tempfile.TemporaryFile() as out:  # outside the copy, so the copy holds the commit's tree and what was added
        try:
            state["proc"] = proc = _nowindow.Popen(cmd, cwd=folder, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        except OSError as exc:  # no such program, not executable: no test ran, so no red either; exit 2 apart from a test that went red
            print("red-run: the test command cannot start: %s" % exc, file=sys.stderr)
            print("red-run %s: %s" % (sha[:7], CLASSIFIERS["fail_line"](1, "", False)))
            return 2
        code = proc.wait()
        out.seek(0)
        text = out.read().decode("utf-8", "replace")
    sys.stdout.write(text if text.endswith("\n") or not text else text + "\n")
    print("red-run %s: %s" % (sha[:7], CLASSIFIERS["fail_line"](code, text, False)))
    return 0 if code == 0 else 1


if __name__ == "__main__":
    _nowindow.end_on_signals()  # TERM and HUP end the run through the `finally` below, the path INT takes as a KeyboardInterrupt
    state = {}
    try:
        sys.exit(main(sys.argv[1:], state))
    except BadCall as exc:
        print("red-run: %s" % exc, file=sys.stderr)
        sys.exit(2)
    finally:
        # A second signal while this runs is ignored (end_on_signals), so the child and the copy go whatever ended the run.
        if state.get("proc"):
            stop_child(state["proc"])
        if state.get("folder"):
            shutil.rmtree(os.path.abspath(state["folder"]), ignore_errors=True)
