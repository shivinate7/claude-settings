#!/usr/bin/env python3
# verdict <cmd...>: run the command, keep the full output in a log, print only the verdict.
# Log: $VERDICT_LOG (appended, never truncated), else a new file in $TMPDIR. Exit code is the command's.
# While it runs, print "verdict: still running, <elapsed>, log=<path>" to stderr every $VERDICT_HEARTBEAT s (default 120), and append it to $STALL_WATCH_BEAT when set.
# Why stderr: a pipe on stdout (`verdict ... | grep`) hides the line, and the background output file keeps stderr. A quiet verdict over 300 s then draws a false STALL (decision stall-watch, "Tools that are quiet by design"). Why the file too: `2>&1 | grep` or `2>/dev/null` hides stderr as well, and the stall watch reads that file.
# Exit 0 is FAIL if the output holds a runner marker, no test ran (an XCTest `Executed 0 tests` line beats a unittest `Ran N tests` line; a unittest `Ran 0 tests in` line at a line start counts only when an `OK`, `FAILED` or `NO TESTS RAN` line follows it with no skips, and no other count is read), or a test run read no test count (a test success marker at a line start, or `xcodebuild test` or `swift test` as typed), else SKIP (`SKIP <cmd>, N skipped (<secs>s)`, exit 0) if N > 0 tests skipped, else PASS.
# N is the larger of two counts: the sum of the runner summaries in the run (`skipped=N`, `N skipped`, node's `# skipped N` and `ℹ skipped N`), and the lines that start `SKIP `, `SKIPPED` or `SKIP:`. A summary line `SKIP: N check` is not one of them, so it never counts on top of its cases. XCTest `Executed N tests, with M tests skipped` lines nest (class, bundle, All tests), so their max is one term of the sum. Colour codes (SGR) are ignored. A count of 10 or more digits reads as 10**9. A count of 0 is PASS. Why: a test that always skips must not read as a pass.
# Exit 0 is also FAIL (`cut`) for a pytest argv (`pytest`, `py.test`, `python -m pytest`, also through `env`, `uv run`, `uvx` and `bash -c`) with `-q` or a line-start session header, and no line-start summary: the run stopped early. A `-qq` run (no summary line) is complete when a line of progress chars ends `[100%]` (any padding, colour codes ignored), or, with `--co`, when it prints a `<file>: <count>` line. A `bash -c` script is read by its own scanner: a newline, `;`, `&`, `|` or `do`/`then`/`else`/`{`/`!` starts a command, a `#` starts a comment only at a word start, and heredoc text is no command.
# A run with no $VERDICT_LOG deletes verdict-*.log files older than 1 day from the temp folder: regular files whose first line is our own header only; errors skipped.
# Killed by signal N: exit 128+N. Ctrl-C: exit 130. Windows: bin/verdict.cmd.
import os, re, shutil, signal, subprocess, sys, tempfile, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import _nowindow  # noqa: E402  the one home of a no-window child start (hooks/_nowindow.py)
HOT = re.compile(r"FAIL|Error|assert|Traceback")
CAP = 30
CHUNK, OVERLAP = 1 << 20, 256  # OVERLAP > longest marker
KEEP = 86400
HEADER = b"=== verdict run "
EXEC = re.compile(r"Executed (\d+) tests?|Test run with (\d+) tests?\b.{0,100}?\bpassed after")  # XCTest summary, Swift Testing summary
UT_RAN = re.compile(rb"^Ran (\d{1,10}) tests? in\b[^\n]*(?:\n(?:[ \t\r]*\n)*(OK|FAILED|NO TESTS RAN)\b([^\n]*))?", re.M)  # unittest's summary at a line start, with the result line that follows it, if any: a line that quotes it is no count
UT_SKIPS = re.compile(rb"\bskipped=0*[1-9]")  # `OK (skipped=N)`: the run is a skip, which the skip count reports
ST_FAILED = re.compile(r"Test run with \d+ tests?\b.{0,100}?\bfailed after")  # `swift test` can exit 0 on it; its XCTest line says 0
SGR = rb"\x1b\[[0-9;]*m"
# XCTest first (its match swallows its own "M tests skipped"), then unittest, then pytest/jest/vitest/playwright/case_runner, then node (TAP `#`, spec `ℹ`) summaries.
# Gaps are runs of spaces because a blanked colour code becomes spaces. Digits and gaps are bounded: each match stays shorter than OVERLAP, and int() never meets a long run.
# A run of 10 or more digits before " skipped" matches only at its last 10 digits.
SKIPPED = re.compile(rb"(?m)Executed \d{1,10} tests?, with (\d{1,10}) tests? skipped|\bskipped=(\d{1,10})|(\b\d{1,9}|\d{10}) {1,64}skipped\b"
                     rb"|^ {0,64}(?:#|\xe2\x84\xb9) {1,64}skipped {1,64}(\d{1,10})")
TEST_OK = re.compile(rb"^(?:[ \t]|" + SGR + rb"){0,64}\*\* TEST (?:EXECUTE )?SUCCEEDED \*\*", re.M)  # only at a line start: a grep hit or source line that quotes it is no marker. Not "TEST BUILD SUCCEEDED": a build runs no test
SWIFT_INFO = {"list", "--list-tests", "-l", "--help", "-h", "--show-codecov-path", "--show-bin-path"}  # `swift test` with one of these runs no test
def test_argv(argv):  # read from the argv as typed, before which() rewrites argv[0]
    exe = re.split(r"[\\/]", argv[0])[-1].lower()
    if exe.endswith(".exe"): exe = exe[:-4]
    return (exe == "xcodebuild" and any(a in ("test", "test-without-building") for a in argv[1:])) or (exe == "swift" and argv[1:2] == ["test"] and not SWIFT_INFO.intersection(argv[2:]))
HUGE = 10 ** 9  # the count for a run of 10 or more digits; any such count still means skips
def count(digits): return int(digits) if len(digits) < 10 else HUGE
SKIP_LINE = re.compile(rb"^(?:" + SGR + rb")*SKIP(?:" + SGR + rb")*(?: |PED|:(?! *\d+ check(?:s|\(s\))?(?![A-Za-z])))", re.M)  # a runner may print one such line per skip, with or without a summary; `SKIP: <case>` counts, a `SKIP: N check` summary does not
# pytest's session header and summary, each at a line start (a quoted one is no marker). Every gap is bounded, so one 1 MiB line of `=` scans in linear time.
# The summary is `<counts> in <N>s`, with or without `=` bars around it (`-q` prints none). `N tests collected` or `N/M tests collected` (--collect-only) and `no tests ran` count as counts.
PY_START = re.compile(rb"^(?:" + SGR + rb")*={3,}(?:" + SGR + rb"| ){0,64}test session starts", re.M)
PY_SUMMARY = re.compile(rb"^(?:" + SGR + rb")*(?:={3,}(?:" + SGR + rb"| ){0,64})?(?:\d{1,9}(?:/\d{1,9})?(?:" + SGR + rb")* (?:" + SGR + rb")*(?:passed|failed|skipped|errors?|warnings?|deselected|xfailed|xpassed|tests? collected)|no tests ran)\b[^\n]{0,200}? in \d[\d.]{0,20}s\b", re.M)
# The last progress line of a complete `-qq` run, which prints no summary: any non-space progress chars (`.sxXFEu`, a plugin's own), colour codes anywhere, padding of any length, then `[100%]` at the line end. A cut run never reaches 100 percent.
# Every part is a disjoint set of chars, so one 1 MiB line scans in linear time. A line may be longer than OVERLAP, so `seen` reads a match at a later chunk's start as whole when it ends past OVERLAP.
PY_DONE = re.compile(rb"^(?:" + SGR + rb"| )*[^\s\[\x1b](?:" + SGR + rb"|[^\s\[\x1b]| )*\[100%\](?:" + SGR + rb")*[ \t\r]*$", re.M)
PY_COUNTS = re.compile(rb"^(?:" + SGR + rb")*[^\s:][^\n]{0,300}?: \d{1,9}(?:" + SGR + rb")*[ \t\r]*$", re.M)  # a `-qq --collect-only` run prints `<file>: <count>` lines and no summary
COLLECT = re.compile(r"(?<![\w-])--co(?:llect-only)?(?![\w-])")
def seen(rx, raw, pos, start):  # does rx match in this chunk? A later chunk starts mid-line, so a match at its index 0 counts only when the line was too long for the previous chunk to hold whole
    return any(pos == start or m.start() or m.end() > OVERLAP for m in rx.finditer(raw))
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
ENV_VAR = r"[A-Za-z_]\w*=.*"
UV_VALUE_OPTS = {"--with", "--with-editable", "--with-requirements", "--python", "-p", "--project", "--directory", "--group", "--extra", "--package", "--env-file", "--index", "--index-url", "--from", "--no-group", "--only-group", "-w"}
def exe_of(a):
    exe = re.split(r"[\\/]", a)[-1].lower()
    return exe[:-4] if exe.endswith(".exe") else exe
def quiet_level(rest): return sum(1 if a == "--quiet" else a.count("q") if re.fullmatch(r"-[a-zA-Z]+", a) else 0 for a in rest)  # `-q` is 1, `-qq` and `-q -q` are 2
def pytest_level(argv, depth=0):  # the -q level of the pytest run this argv starts, or None when it starts none; read as typed, through env, uv run, python -m pytest and bash -c
    i = 0
    while i < len(argv) and (re.fullmatch(ENV_VAR, argv[i]) or argv[i] in ("exec", "time", "nohup", "command")): i += 1
    argv = argv[i:]
    if not argv or depth > 4: return None
    exe, rest = exe_of(argv[0]), argv[1:]
    if exe in ("pytest", "py.test"): return quiet_level(rest)
    if re.fullmatch(r"py(?:thon[\d.]*)?", exe):
        for j, a in enumerate(rest):
            if a == "-m" and rest[j + 1:j + 2] == ["pytest"]: return quiet_level(rest[j + 2:])
            if a == "-mpytest": return quiet_level(rest[j + 1:])
        return None
    if exe == "env":
        j = 0
        while j < len(rest) and (rest[j].startswith("-") or re.fullmatch(ENV_VAR, rest[j])): j += 2 if rest[j] in ("-u", "-C", "-S", "--unset", "--chdir", "--split-string") else 1
        return pytest_level(rest[j:], depth + 1)
    if exe == "uvx" or (exe == "uv" and rest[:1] == ["run"]):
        j = 0 if exe == "uvx" else 1
        while j < len(rest) and rest[j].startswith("-"): j += 2 if rest[j] in UV_VALUE_OPTS else 1
        return pytest_level(rest[j:], depth + 1)
    if exe in SHELLS:
        for j, a in enumerate(rest):
            if re.fullmatch(r"-[a-zA-Z]*c[a-zA-Z]*", a) and j + 1 < len(rest): return script_level(rest[j + 1], depth + 1)
    return None
KEYWORDS = {"if", "then", "elif", "else", "while", "until", "do", "!", "{", "time"}  # a command may start after one of these
HEREDOC_WORD = re.compile(r"""[ \t]*(?:'([^']*)'|"([^"]*)"|\\?([^\s;&|()<>'"]+))""")
def shell_commands(script):  # the commands of a shell script, each a list of words; None when a quote never closes
    cmds, cmd, word, has, pend, i, n = [], [], [], False, [], 0, len(script)
    def end_word():
        nonlocal has
        if has: cmd.append("".join(word)); word.clear(); has = False
    def end_cmd():
        end_word()
        if cmd: cmds.append(cmd[:]); cmd.clear()
    while i < n:
        c = script[i]
        if c == "\\":
            if script[i + 1:i + 2] != "\n": word.append(script[i + 1:i + 2]); has = True
            i += 2
        elif c == "'":
            j = script.find("'", i + 1)
            if j < 0: return None
            word.append(script[i + 1:j]); has = True; i = j + 1
        elif c == '"':
            j = i + 1
            while j < n and script[j] != '"': j += 2 if script[j] == "\\" else 1
            if j >= n: return None
            word.append(script[i + 1:j]); has = True; i = j + 1
        elif c == "#" and not has:  # a comment starts only at the start of a word
            j = script.find("\n", i)
            i = n if j < 0 else j
        elif c == "\n":
            end_cmd(); i += 1
            for delim, dash in pend:  # heredoc bodies start on the line after their `<<`; their text is no command
                while i < n:
                    j = script.find("\n", i); j = n if j < 0 else j
                    line = script[i:j]; i = min(j + 1, n)
                    if (line.lstrip("\t") if dash else line) == delim: break
            pend = []
        elif c in " \t": end_word(); i += 1
        elif c == "<" and script.startswith("<<", i) and not script.startswith("<<<", i):
            end_cmd(); j = i + 2; dash = script[j:j + 1] == "-"; j += dash
            m = HEREDOC_WORD.match(script, j)
            if m: pend.append((m[1] if m[1] is not None else m[2] if m[2] is not None else m[3], dash)); j = m.end()
            i = j
        elif c in ";&|()<>`": end_cmd(); i += 1
        else: word.append(c); has = True; i += 1
    end_cmd()
    return cmds
def script_level(script, depth):  # a shell script string: the highest -q level among its pytest commands, or None. Quoted words stay one token, so `echo 'pytest -q'` runs no pytest
    cmds = shell_commands(script)
    if cmds is None: return None
    levels = []
    for cmd in cmds:
        while cmd and cmd[0] in KEYWORDS: cmd = cmd[1:]
        levels.append(pytest_level(cmd, depth))
    levels = [l for l in levels if l is not None]
    return max(levels) if levels else None
def pytest_argv(argv):  # (is pytest, -q level), read from the argv as typed
    level = pytest_level(argv)
    return level is not None, level or 0
TAIL = 1 << 20  # read at most the last 1 MiB of this run's output for the excerpt
def prune(folder, own):
    try:
        with os.scandir(folder) as it:
            for e in it:
                try:
                    if (e.name.startswith("verdict-") and e.name.endswith(".log") and os.path.normcase(e.path) != own
                            and e.is_file(follow_symlinks=False) and time.time() - e.stat(follow_symlinks=False).st_mtime > KEEP):
                        with open(e.path, "rb") as g: ours = g.read(len(HEADER)) == HEADER
                        if ours: os.remove(e.path)
                except OSError: pass
    except OSError: pass
def main(argv):

    for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")  # a cp1252 pipe cannot print the excerpt
    if not argv: sys.exit("usage: verdict <cmd...>")
    name = " ".join(argv)
    by_argv = test_argv(argv)
    is_pytest, qlevel = pytest_argv(argv)
    quiet = qlevel > 0
    collect = bool(COLLECT.search(" ".join(argv)))
    argv = [shutil.which(argv[0]) or argv[0]] + argv[1:]  # finds .cmd/.bat shims on Windows
    log = os.environ.get("VERDICT_LOG")
    if not log:
        fd, log = tempfile.mkstemp(prefix="verdict-", suffix=".log"); os.close(fd)
    t = time.time()
    note = ""
    if not os.environ.get("VERDICT_LOG"): prune(os.path.dirname(os.path.abspath(log)), os.path.normcase(os.path.abspath(log)))
    try: f = open(log, "ab")
    except OSError as e: print(f"FAIL {name} rc=1 cannot open log: {e} ({time.time() - t:.1f}s) log={log}"); return 1
    with f:
        f.write(f"=== verdict run {time.strftime('%Y-%m-%d %H:%M:%S')}: {name}\n".encode()); f.flush()
        start = f.tell()
        try: beat = int(os.environ.get("VERDICT_HEARTBEAT") or 120)
        except ValueError: beat = 120
        if beat < 1: beat = 120
        try: proc = _nowindow.Popen(argv, stdout=f, stderr=subprocess.STDOUT, start_new_session=True)  # its own group: a TERM or HUP to verdict reaches the child and its children
        except OSError as e: proc = None; f.write(f"verdict: cannot run {argv[0]}: {e}\n".encode()); rc = 127
        if proc:
            say, beat_file = True, os.environ.get("STALL_WATCH_BEAT")
            try:
              with _nowindow.forward_signals(proc):
                while True:
                    try: rc = proc.wait(timeout=beat); break
                    except subprocess.TimeoutExpired:
                        line = f"verdict: still running, {time.time() - t:.0f}s, log={log}"
                        if say:
                            try: print(line, file=sys.stderr, flush=True)
                            except OSError: say = False  # reader gone: keep waiting, keep the child's rc
                        if beat_file:  # apart from say: a gone stderr reader must not stop the beat to the watch
                            try:
                                with open(beat_file, "a", encoding="utf-8") as b: b.write(line + "\n")
                            except OSError: pass
            except KeyboardInterrupt:
                rc = 130
                try:
                    _nowindow.kill_group(proc, signal.SIGTERM)  # the child is in its own group, so the terminal's Ctrl-C no longer reaches its children
                    proc.wait(timeout=5)
                except (subprocess.TimeoutExpired, KeyboardInterrupt): pass
                finally: _nowindow.kill_group(proc, getattr(signal, "SIGKILL", signal.SIGTERM)); proc.kill(); proc.wait()
        f.flush(); end = f.tell()
    secs = f"{time.time() - t:.1f}s"
    if rc < 0: note, rc = f" killed by signal {-rc}", 128 - rc
    fail = zero = ran = marked = started = summed = done = False; lines = []
    summaries, xct, marks, ut = {}, {}, {}, {}  # absolute byte offset of a match -> its count; a match in the chunk overlap is read twice, counted once
    try:
        with open(log, "rb") as f:
            pos = start
            if os.fstat(f.fileno()).st_size < end: raise OSError("log shorter than this run")
            def rd(n):  # a short read means the log was truncated under us
                b = f.read(n)
                if len(b) != n: raise OSError("short read")
                return b
            while pos < end:  # scan the whole run region; OVERLAP keeps a marker cut by a chunk edge whole
                f.seek(pos); raw = rd(min(CHUNK, end - pos)); buf = raw.decode("utf-8", errors="replace")
                # A later chunk starts mid-line: a match at its index 0 is the tail of one the previous chunk holds whole, and may be cut ("2 skipped" of "12 skipped").
                # Colour codes become spaces of the same length: no word edge sits between a code and its number, and offsets stay true.
                for m in SKIPPED.finditer(re.sub(SGR, lambda g: b" " * len(g.group()), raw)):
                    if pos == start or m.start():  # a later chunk overwrites a count cut at its edge
                        if m.group(1): xct[pos + m.start()] = count(m.group(1))
                        else: summaries[pos + m.start()] = count(m.group(2) or m.group(3) or m.group(4))
                for m in SKIP_LINE.finditer(raw):
                    if pos == start or m.start(): marks[pos + m.start()] = 1
                started = started or any(pos == start or m.start() for m in PY_START.finditer(raw))  # a later chunk's index 0 may be mid-line
                summed = summed or any(pos == start or m.start() for m in PY_SUMMARY.finditer(raw))
                done = done or (qlevel > 1 and (seen(PY_DONE, raw, pos, start) or (collect and seen(PY_COUNTS, raw, pos, start))))
                fail = fail or "** TEST FAILED **" in buf or "** BUILD FAILED **" in buf or bool(ST_FAILED.search(buf))
                if not marked: marked = any(pos == start or m.start() for m in TEST_OK.finditer(raw))  # a later chunk's index 0 may be mid-line; the previous chunk holds that line whole
                for a, b in EXEC.findall(buf): n = a or b; zero, ran = zero or n == "0", ran or n != "0"
                for m in UT_RAN.finditer(raw):  # a later chunk's index 0 may be mid-line; the previous chunk holds that line whole. A later chunk overwrites a match cut at its edge
                    if pos == start or m.start(): ut[pos + m.start()] = (m[1] != b"0", m[2] is not None and not UT_SKIPS.search(m[3]))
                pos += CHUNK - OVERLAP if pos + CHUNK < end else CHUNK
            f.seek(max(start, end - TAIL))
            lines = rd(end - f.tell()).decode("utf-8", errors="replace").splitlines()
    except (OSError, ValueError):
        if rc == 0: print(f"FAIL {name} rc=1 log unreadable ({secs}) log={log}"); return 1
        note += " log unreadable"
    if rc == 0:
        if fail: rc, note = 1, " runner failure marker"
        elif (zero and not ran) or (any(c and not n for n, c in ut.values()) and not (ran or any(n for n, c in ut.values()))): rc, note = 1, " no tests ran"  # an `Executed 0` line beats a `Ran N` line; a `Ran 0` line, closed by an OK, FAILED or NO TESTS RAN line (`OK (skipped=N)` is a skip, not a zero), loses to any other count
        elif not (zero or ran) and (marked or by_argv): rc, note = 1, " no test count"
        elif is_pytest and (started or quiet) and not (summed or done): rc, note = 1, " cut before the pytest summary"
        else:
            skips = max(sum(summaries.values()) + max(xct.values(), default=0), len(marks))
            if skips: print(f"SKIP {name}, {skips} skipped ({secs})")
            else: print(f"PASS {name} ({secs})")
            return 0
    print(f"FAIL {name} rc={rc}{note} ({secs}) log={log}")
    hot = [l for l in lines if HOT.search(l)]
    print("\n".join((hot or lines)[-CAP:]))
    return rc
sys.exit(main(sys.argv[1:]))
