#!/usr/bin/env python3
# verdict <cmd...>: run the command, keep the full output in a log, print only the verdict.
# Log: $VERDICT_LOG (appended, never truncated), else a new file in $TMPDIR. Exit code is the command's.
# While it runs, print "verdict: still running, <elapsed>, log=<path>" to stderr every $VERDICT_HEARTBEAT s (default 120).
# Why stderr: a pipe on stdout (`verdict ... | grep`) hides the line, and the background output file keeps stderr. A quiet verdict over 300 s then draws a false STALL (decision stall-watch, "Tools that are quiet by design").
# Exit 0 is FAIL if the output holds a runner marker.
# A run with no $VERDICT_LOG deletes verdict-*.log files older than 7 days from the temp folder: regular files whose first line is our own header only; errors skipped.
# Killed by signal N: exit 128+N. Ctrl-C: exit 130. Windows: bin/verdict.cmd.
import os, re, shutil, subprocess, sys, tempfile, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import _nowindow  # noqa: E402  the one home of a no-window child start (hooks/_nowindow.py)
HOT = re.compile(r"FAIL|Error|assert|Traceback")
CAP = 30
CHUNK, OVERLAP = 1 << 20, 256  # OVERLAP > longest marker
KEEP = 7 * 86400
HEADER = b"=== verdict run "
EXEC = re.compile(r"Executed (\d+) tests?|Test run with (\d+) tests?\b.{0,100}?\bpassed after")  # XCTest summary, Swift Testing summary
ST_FAILED = re.compile(r"Test run with \d+ tests?\b.{0,100}?\bfailed after")  # `swift test` can exit 0 on it; its XCTest line says 0
TAIL = 1 << 20  # read at most the last 1 MiB of this run's output for the excerpt
def prune(folder, own):
    try:
        with os.scandir(folder) as it:
            for e in it:
                try:
                    if (e.name.startswith("verdict-") and e.name.endswith(".log") and os.path.normcase(e.path) != own
                            and e.is_file(follow_symlinks=False) and time.time() - e.stat(follow_symlinks=False).st_mtime > KEEP):
                        with open(e.path, "rb") as g: ours = g.read(len(HEADER)) == HEADER
                        if ours: os.remove(e.path)
                except OSError: pass
    except OSError: pass
def main(argv):

    for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")  # a cp1252 pipe cannot print the excerpt
    if not argv: sys.exit("usage: verdict <cmd...>")
    name = " ".join(argv)
    argv = [shutil.which(argv[0]) or argv[0]] + argv[1:]  # finds .cmd/.bat shims on Windows
    log = os.environ.get("VERDICT_LOG")
    if not log:
        fd, log = tempfile.mkstemp(prefix="verdict-", suffix=".log"); os.close(fd)
    t = time.time()
    note = ""
    if not os.environ.get("VERDICT_LOG"): prune(os.path.dirname(os.path.abspath(log)), os.path.normcase(os.path.abspath(log)))
    try: f = open(log, "ab")
    except OSError as e: print(f"FAIL {name} rc=1 cannot open log: {e} ({time.time() - t:.1f}s) log={log}"); return 1
    with f:
        f.write(f"=== verdict run {time.strftime('%Y-%m-%d %H:%M:%S')}: {name}\n".encode()); f.flush()
        start = f.tell()
        try: beat = int(os.environ.get("VERDICT_HEARTBEAT") or 120)
        except ValueError: beat = 120
        if beat < 1: beat = 120
        try: proc = _nowindow.Popen(argv, stdout=f, stderr=subprocess.STDOUT)
        except OSError as e: proc = None; f.write(f"verdict: cannot run {argv[0]}: {e}\n".encode()); rc = 127
        if proc:
            say = True
            try:
                while True:
                    try: rc = proc.wait(timeout=beat); break
                    except subprocess.TimeoutExpired:
                        if say:
                            try: print(f"verdict: still running, {time.time() - t:.0f}s, log={log}", file=sys.stderr, flush=True)
                            except OSError: say = False  # reader gone: keep waiting, keep the child's rc
            except KeyboardInterrupt:
                rc = 130
                try:
                    proc.terminate()
                    proc.wait(timeout=5)
                except (subprocess.TimeoutExpired, KeyboardInterrupt): pass
                finally: proc.kill(); proc.wait()
        f.flush(); end = f.tell()
    secs = f"{time.time() - t:.1f}s"
    if rc < 0: note, rc = f" killed by signal {-rc}", 128 - rc
    fail = zero = ran = False; lines = []
    try:
        with open(log, "rb") as f:
            pos = start
            if os.fstat(f.fileno()).st_size < end: raise OSError("log shorter than this run")
            def rd(n):  # a short read means the log was truncated under us
                b = f.read(n)
                if len(b) != n: raise OSError("short read")
                return b
            while pos < end:  # scan the whole run region; OVERLAP keeps a marker cut by a chunk edge whole
                f.seek(pos); buf = rd(min(CHUNK, end - pos)).decode("utf-8", errors="replace")
                fail = fail or "** TEST FAILED **" in buf or "** BUILD FAILED **" in buf or bool(ST_FAILED.search(buf))
                for a, b in EXEC.findall(buf): n = a or b; zero, ran = zero or n == "0", ran or n != "0"
                pos += CHUNK - OVERLAP if pos + CHUNK < end else CHUNK
            f.seek(max(start, end - TAIL))
            lines = rd(end - f.tell()).decode("utf-8", errors="replace").splitlines()
    except (OSError, ValueError):
        if rc == 0: print(f"FAIL {name} rc=1 log unreadable ({secs}) log={log}"); return 1
        note += " log unreadable"
    if rc == 0:
        if fail: rc, note = 1, " runner failure marker"
        elif zero and not ran: rc, note = 1, " no tests ran"
        else:
            print(f"PASS {name} ({secs})"); return 0
    print(f"FAIL {name} rc={rc}{note} ({secs}) log={log}")
    hot = [l for l in lines if HOT.search(l)]
    print("\n".join((hot or lines)[-CAP:]))
    return rc
sys.exit(main(sys.argv[1:]))
