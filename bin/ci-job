#!/usr/bin/env python3
# ci-job <job> [--workflow <file>] [--base <ref>] [--plan] [--lint] [--step NAME]...: run every step of one workflow job here,
# each through bin/verdict, and print one verdict per step. It runs on demand only: a lane never runs a full
# job, because the batch CI run is the only full run (lanes-run-no-full-ci-job). The one exception is --lint.
# --lint runs only the job's fast lint and check steps, chosen from the step commands in the workflow, never a
# list: a step whose whole run: is `python3 lint/<script>.py ...`, `python3 actions/<script>.py ...`,
# `bin/ste-changed ...` or a pinned `pipx run <tool>==<version> ...` (the pin read from the workflow), one command
# per line, no `&&`, `|` or `;`. A CI step with a `python3 hooks/test_<name>.py` or `python3 merge/test_<name>.py` line, with
# arguments or other lines around it, runs whole, as CI runs it, only when the one selector, `hooks/mutate_guard.py --lint-suites <base>`,
# picks that suite for a file of the diff <base>...HEAD. The selector follows imports: a suite is picked for a change to any
# module that a module it loads imports. A picked suite that fails is FAIL. A line before the suite that fails, so the
# shell never reaches the suite, makes the CI step unknown: ci-job echoes a marker right before a top-level first suite
# line (preamble_marked; not under pwsh) and reads a failure with no marker in the log as the preamble's. A selector that
# cannot run, or runs past its 60 s limit (SELECTOR_LIMIT), is unknown on each such CI step, exit 2. With no base or no
# pick, the CI step is `not run`. The job scope is the linted job only: the suites picked for the CI steps of another job
# print one `not run` line per job, naming the job and those suites, and run nowhere here. Cost: one selector process per
# lane lint (one git diff, one git ls-files, one parse of each tracked test_*.py and of each module they reach, once for
# the whole diff), plus one process per picked CI step. A mutation script (a name with "mutate")
# and every other command (bash, unpinned pipx, other uses:) is left out with one `not run` line naming the step and why, except a `uses:` of
# this repo's own action (`$/actions/...`, `./actions/...`) it cannot run: that prints one unknown line. After the
# last step, one line counts the steps run out of the job's total (--plan: "would run"). Neither it nor a `not run`
# line starts with FAIL or unknown or moves the exit code: merge.py's lane lint reads those two words.
# An install CI step is a run: whose every line is one install command (INSTALL_CMD: a lockfile install, or type
# generation such as `npx astro sync`), since a lint step that reads generated files fails on a bare checkout. --lint
# runs it, in order, only when a later lint step will run; its if: and env read as any step's. An install that fails
# or is unknown prints unknown, never FAIL (the tree, not the change, is at fault), and each later lint step prints
# unknown naming it and does not run. Three `uses:` it runs in place, each by its one home: actions/ste-lint as
# `bin/ste-changed <base>` (shared with the action through actions/ste-lint/run.sh), actions/code-check as its
# action.yml's command, `python3 code_check.py --base <base>`,
# and actions/zizmor as its run.sh with the step's `with: paths` in ZIZMOR_PATHS. The first two need a base; zizmor
# needs none, and with no pipx it is unknown ("tool missing: pipx"). The step's uses: picks which checkout, as CI
# does. A local uses: (`$/actions/...`, `./actions/...`) runs the repo under test's own code_check.py or run.sh,
# never another's: missing or failing, it FAILs. A remote uses: (`owner/repo/actions/code-check@ref`) with no
# pin to read (a run with neither --step nor --lint) runs the copy beside ci-job, else (code-check, zizmor) the one in the checkout
# the global rules file names, else the step is unknown and names the paths it looked at. Under a pin (--step or --lint),
# a pinned claude-settings action reads its own pin's tree only: a file missing there makes the step unknown, never a
# fallback to another copy. The code-check step's line names
# the code_check.py that ran. When every failure code_check.py reports is a pinned tool that could not start, the
# step is unknown; any other failure makes it FAIL, its reason naming the tools that could not start.
# --lint with no --base takes origin/main as CI does and says so
# in one line, because a run that skipped the pull-request steps read as a pass. With no origin/main, one unknown
# line names each pull-request step it skips, and each such lint step (its if: reads true on a pull-request run) prints
# unknown, not skipped. A lint CI step whose if: reads false on a pull-request run (it runs only off one) prints
# skipped and does not fail. A --lint run in which no lint CI step and no picked suite CI step ran prints one unknown line and exits 2, never 0. A lane runs `merge --lane-lint <pr>`, which runs this mode, before it
# joins a batch. Use it with a job such as checks.
# Workflow: the one file in .github/workflows/ at the git top level of the current folder that holds the job
# (checks.yml, check.yml, any name), unless --workflow names one. No file, or more than one, is unknown.
# Each step runs at that top level (or its working-directory) as GitHub's Linux runner runs it: no shell
# key is `bash -e`, `shell: bash` is `bash --noprofile --norc -eo pipefail`, `shell: pwsh` is pwsh.
# GH_TOKEN and GITHUB_TOKEN are unset unless the step's env: sets them, as on the runner (a session token would
# turn zizmor's offline audits online). Multi-line `run: |` steps run whole. Verdicts: PASS, SKIP (the step ran and skipped tests, exit 0), FAIL, unknown (tool missing, or an expression it
# cannot read), not run locally (a `uses:` action), skipped (a pull-request step with no base). Under --lint, a step
# it leaves out prints `not run`, which is no verdict.
# A step's `if:` reads every needs.scope.outputs flag (== 'true' or != 'false') as true, !cancelled(), always() and success() as true,
# and github.event_name == 'pull_request' as true only with a base. ${{ github.base_ref }} is --base without
# its remote; ${{ github.event.pull_request.head.sha }} is HEAD. Any other expression makes the step unknown.
# Each step's env sets GITHUB_BASE_REF to that value (the step's own env: wins), as GitHub does on a pull-request run; with no --base it is unset, as off one.
# A tool is missing when a line's command is not on PATH, or the step exits 127.
# --step NAME (repeatable) runs only the steps with those names, of any kind, each as a plain run (never with --lint, which
# picks steps by kind: that pair is a usage error, exit 2). Every other step is left out and prints nothing. A name no step
# of the job has prints one `unknown` line, and when any name is missing no step runs: exit 2. A named step that does not
# run (an action, a false if:) is also one `unknown` line, never a pass. The merge's ready checks run its declared
# merge.readyChecks this way. Exit codes as below.
# --step and --lint run claude-settings at the commits the job pins, as CI does (under --lint, each lint step that is not
# skipped; --lint --plan reads the pins and needs no clone, so a sha the clone lacks is no problem there): the refs of its
# `<owner>/claude-settings/actions/<name>@<ref>` uses: lines (lint/workflow_steps.py settings_pins), each a 40-hex sha or a
# moving ref such as the stable branch CI pins (R42 part 2). The ref is read from the workflow, never guessed. A moving ref is
# fetched from the clone's origin every run and resolved to the commit it names (git fetch origin <ref>, then FETCH_HEAD);
# --plan resolves none. Each pin is a tree exported with `git archive <commit>` (never a worktree; symlink
# members are not extracted) from CI_JOB_SETTINGS_CLONE, else this file's own clone, else the clone the global rules file names,
# a sha fetched from that clone's origin only when it lacks it (GIT_TERMINAL_PROMPT=0). A remote ste-lint, code-check or zizmor step
# runs from the tree of its own pin only (ste-lint as its bin/ste-changed: the lane lint runs the lint CI runs, decision
# action-pins-follow-sessions), as CI downloads each pin separately.
# CLAUDE_SETTINGS_DIR is set to the tree only when the job has exactly one distinct pin (the step's own env: wins). A local
# `uses:` step never gets it and never takes a pin.
# With two or more refs, a plain run step is one `unknown` line naming the refs (merge/merge.py lint_steps parses the `would run` lines). A ref that cannot
# be fetched or resolved, or a failed `npm ci`, makes each step that needs that tree one `unknown` line; the other steps run. With no
# pin, a step runs as before. Each tree is removed on every exit, a SIGTERM included.
# --plan prints each step's verdict-to-be and runs nothing. Output of each run: $VERDICT_LOG, else one new
# temp log per call, named on the last line. Exit: 1 if a step fails, else 2 if one is unknown, else 0 (but see a stale ste-lint pin, below).
# CI checks out with fetch-depth: 0. When the job's checkout step says so and the clone is shallow, ci-job first
# runs `git fetch --unshallow` once (--plan only says so); a failed fetch is one unknown line. Cost: one git fetch,
# only when shallow.
# A step's stdout is its one verdict line. verdict's "still running" heartbeat (every $VERDICT_HEARTBEAT s) goes to
# stderr as it arrives, so a quiet step still feeds the stall watch (decision stall-watch: a quiet tool prints a
# line at least every 120 s).
# Under --lint, the ste-lint action step runs bin/ste-changed with STE_CHANGED_PIN_NOTE=1: a stale pin of this repo's ste-lint or
# zizmor action never fails a passing lint, and its PASS line ends `; <the whole drift line>`, which starts with the marker
# `ste-changed: pin note: ` (hooks/pin_note.py). A --step run (merge's ready checks) never gets the variable: a drifted pin
# exits 3 and the step reads FAIL. No other step gets it either, even when the caller exports it. A failing lint is FAIL.
# Under a sha pin the ste-lint step runs the pinned tree's bin/ste-changed (see the pin paragraph) and gets no pin note: that
# tree has no .git, so ci-job fetches the stable branch's head (STABLE_BRANCH, "stable", R42 part 2) from the clone's origin and
# passes it with the clone (STE_CHANGED_COMPARE_TO, STE_CHANGED_CLONE), and ste-changed judges the pin's ste-lint files against it.
# A stale pin exits 3, which reads FAIL: the run exits 1 under --step, and 3 under --lint when stale pins are its only FAILs (any
# other FAIL makes it 1). A stable head that cannot be read makes the step unknown, never a pass. Only a ste-lint step that runs
# the local copy (a local uses:) passes with a note. Cost: one `git fetch origin stable` per run, when a ste-lint step holds a sha pin.
# Under --lint, lint CI steps run at once, up to N workers: CI_JOB_LINT_WORKERS when it is a positive integer, else min(CPU count, 4),
# at least 1 (a lane runs only the checks its change needs, decision lanes-run-no-full-ci-job; one CI step at a time, the lint run outlasted
# merge's 1200 s bound). N=1 is the serial run. An install CI step is
# a barrier: it runs alone, after every earlier CI step has finished, and before any later one starts. Each parallel CI step logs to a file of its
# own, so the reads from its start offset see only its output; each log is appended to $VERDICT_LOG in CI step order, and each verdict line
# prints in CI step order, whatever order the CI steps finish. A `start:` or heartbeat line is written whole, so two never mix. A plain run,
# --step and --plan stay serial.
# Cost: one process per CI step (bin/verdict and the CI step's shell), one log file; no timer, no lasting process. Under
# --lint each install CI step adds its processes, plus network and disk only when a job has one; a pip install writes to the active Python.
# Under --step or --lint with pins: one archive per distinct pinned ref a step that runs needs (a temp folder, about 24 MB,
# removed after, on a SIGTERM too; a SIGKILL leaves it in TMPDIR), a git fetch when the sha is absent or the ref moves, and an
# `npm ci --ignore-scripts` only when the pinned tree has a package-lock.json. --plan with a pin makes no fetch and no archive
# (under --step it reads the clone for the sha; under --lint it reads no clone). A --lint run pays this only when a lint step is not skipped.
# With N above 1, --lint adds one thread per worker, one temp folder, and one log file per lint CI step run, all deleted when ci-job ends, except a log whose copy into $VERDICT_LOG failed (then the folder stays)
# (a SIGKILL from merge's timeout reaches only ci-job: it leaves the folder in TMPDIR and may leave verdict children running). Each `not run` line,
# the summary and each CI step's `start: <name>` line on stderr (before it runs, so a caller sees which CI step is running)
# are one print.
import concurrent.futures, os, re, shutil, signal, subprocess, sys, tarfile, tempfile, threading
BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "hooks"))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "lint"))
import _nowindow  # noqa: E402  the one home of a no-window child start (hooks/_nowindow.py)
from git_bash import find_git_bash  # noqa: E402  the one home of the Git Bash lookup (never the WSL launcher)
from pin_note import ENV as PIN_NOTE_ENV, MARKER as PIN_NOTE_MARKER  # noqa: E402  the one home of the pin note's names (hooks/pin_note.py)
from workflow_steps import COMMIT_SHA, SETTINGS_ACTION, job_block, job_workflow, run_body, settings_pins, step_blocks, step_env, step_key, step_with, yaml_scalar  # noqa: E402  the one home of the step parser

SELECTOR_LIMIT = 60  # seconds the --lint-suites selector may run (about 10 s on this repo's 123 suites) before it reads unknown
PREAMBLE_MARK = "ci-job-preamble-done"
PREAMBLE_DONE = "echo; echo " + PREAMBLE_MARK  # the line preamble_marked adds right before a CI step's first suite line; the bare echo ends a preamble line that has no newline, so the mark lands at line start
SUITE_LINE = re.compile(r"python3 ((?:hooks|merge)/test_[\w.-]+\.py)(?: [^|&;`<>]*)?")  # a CI step's suite line, arguments allowed
USAGE = "usage: ci-job <job> [--workflow <file>] [--base <ref>] [--plan] [--lint] [--step NAME]..."
EXPR = re.compile(r"\$\{\{\s*(.*?)\s*\}\}")
BUILTINS = {"cd", "echo", "printf", "test", "[", "[[", "export", "set", "exit", "if", "then", "else", "elif", "fi",
            "for", "do", "done", "while", "until", "case", "esac", "true", "false", ":", "read", "local", "return",
            "shift", "eval", "source", ".", "trap", "unset", "wait", "{", "}", "(", ")", "!", "time", "exec", "command"}
KEYWORDS = {"if", "elif", "while", "until", "do", "then", "else", "!", "time"}  # a word a command may follow
RUNNERS = {"xargs", "env", "nice", "nohup"}  # a command whose first operand is the tool it runs
SHELLS = {None: ["bash", "-e"], "bash": ["bash", "--noprofile", "--norc", "-eo", "pipefail"], "sh": ["sh", "-e"],
          "python": ["python3"], "pwsh": ["pwsh", "-NoProfile", "-NonInteractive", "-File"]}


def shell_argv(shell, nt=None, environ=None):
    """The argv that runs a step's script under `shell`, or None when its shell is missing. On Windows, bash and sh
    are Git Bash's by full path: PATH's first bash there is the System32 WSL launcher, which runs the script in Linux."""
    argv = list(SHELLS[shell])
    if argv[0] not in ("bash", "sh"):
        return argv
    nt = os.name == "nt" if nt is None else nt
    if not nt:
        found = shutil.which(argv[0], path=(environ or os.environ).get("PATH"))
        return [found] + argv[1:] if found else None
    bash = find_git_bash(nt=True, environ=environ)
    if not bash:
        return None
    exe = bash if argv[0] == "bash" else os.path.join(os.path.dirname(bash), "sh.exe")
    return [exe] + argv[1:] if os.path.isfile(exe) else None


def slashed(path):
    """A path as a bash script names it: Git Bash reads `C:/x/y` as a path and `C:\\x\\y` as a command name."""
    return path.replace("\\", "/")


def no_shell(name, nt=None):
    """The detail of a step whose shell is missing."""
    if os.name == "nt" if nt is None else nt:
        return "tool missing: Git Bash (on Windows this runner never uses the WSL launcher System32\\bash.exe)"
    return "tool missing: %s" % name


def git(*args, cwd=None):
    done = _nowindow.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else None


def unshallow(block, top, dry, tally):
    """Fetch full history when CI's checkout does (fetch-depth: 0) and this clone is shallow. A failed fetch is unknown."""
    full = any((step_key(st, "uses") or "").startswith("actions/checkout") and
               re.search(r"^          fetch-depth:[ \t]*0[ \t]*$", st, re.M) for st in step_blocks(block))
    if not full or git("rev-parse", "--is-shallow-repository", cwd=top) != "true":
        return
    if dry:
        print("%-15s the clone is shallow and CI checks out full history: git fetch --unshallow" % "would fetch")
        return
    remotes = (git("remote", cwd=top) or "").split()
    done = _nowindow.run(["git", "fetch", "--unshallow", *(["origin"] if "origin" in remotes else remotes[:1])],
                         cwd=top, capture_output=True, text=True)
    if done.returncode == 0:
        print("%-15s the clone was shallow and CI checks out full history: ran git fetch --unshallow" % "fetched")
    else:
        tally["unknown"] += 1
        print("unknown         the clone is shallow and git fetch --unshallow failed: %s" %
              ((done.stderr.strip().splitlines() or ["no message"])[-1]))


def condition(text, pr):
    """True, False, or None when the expression holds a term this runner cannot read."""
    if not text:
        return True
    m = EXPR.fullmatch(text.strip())
    expr = m.group(1) if m else text.strip()
    expr = re.sub(r"needs\.scope\.outputs\.[\w-]+\s*(?:==\s*'true'|!=\s*'false')", " T ", expr)  # a flag reads as true
    expr = re.sub(r"github\.event_name\s*==\s*'pull_request'", " T " if pr else " F ", expr)
    expr = re.sub(r"github\.event_name\s*!=\s*'pull_request'", " F " if pr else " T ", expr)
    expr = re.sub(r"\b(?:cancelled|always|success|failure)\(\)", lambda x: " F " if x.group(0) in ("cancelled()", "failure()") else " T ", expr)
    expr = expr.replace("&&", " and ").replace("||", " or ").replace("!", " not ")
    if not re.fullmatch(r"[\sTF()]*(?:(?:and|or|not)[\sTF()]*)*", expr):
        return None
    return bool(eval(expr.replace("T", "True").replace("F", "False"), {"__builtins__": {}}))  # only T, F, and, or, not, ()


def expand(value, values):
    """value with each known ${{ }} replaced, or None when one is unknown."""
    missing = [m.group(1) for m in EXPR.finditer(value) if m.group(1) not in values]
    return None if missing else EXPR.sub(lambda m: values[m.group(1)], value)


def commands(script):
    """The command word of each simple command in a shell script, for the tool-missing check."""
    words, until = [], None
    for line in script.splitlines():
        if until is not None:  # a heredoc body is data, not commands
            until = None if line.strip() == until else until
            continue
        line = line.split(" #")[0].strip()
        if not line or line.startswith("#"):
            continue
        bare = re.sub(r"\$\(\(.*?\)\)|\"[^\"]*\"", "", line)  # arithmetic and double-quoted text hold no heredoc
        doc = re.search(r"(?<!<)<<(?!<)-?\s*['\"]?([A-Za-z_]\w*)['\"]?", bare)
        if doc:
            until = doc.group(1)
        for part in re.split(r"\|\||&&|[|;]", line):
            tokens = [t for t in part.split() if not re.fullmatch(r"[A-Za-z_]\w*=\S*", t)]
            while tokens and tokens[0] in KEYWORDS:  # if nosuchtool ...: the tool is nosuchtool
                tokens.pop(0)
            while len(tokens) > 1 and tokens[0] in RUNNERS:  # xargs -0 pipx ...: the tool is pipx
                words.append(tokens.pop(0))
                while len(tokens) > 1 and tokens[0].startswith("-"):
                    tokens.pop(0)
            if tokens and re.fullmatch(r"[\w./+-]+", tokens[0]) and tokens[0] not in BUILTINS and "/" not in tokens[0]:
                words.append(tokens[0])
    return words


def missing_in_log(log, start, script):
    """Each command the step's shell reported as not found, from this run's part of the log. A 127 that
    an `if`, a `!` or `|| true` swallowed still lands there, so the step is unknown, not PASS."""
    text = log_text(log, start)
    lead = re.escape(script)
    found = re.findall(r"^%s: (?:line \d+: )?(\S+): command not found$" % lead, text, re.M)
    found += re.findall(r"^%s: \d+: (\S+): not found$" % lead, text, re.M)
    return sorted(set(found))


LINT_CMD = re.compile(r"(?:python3 (?:lint|actions)/[\w./-]+\.py|bin/ste-changed|pipx run [\w.-]+==[\w.]+)"
                      r"(?: [^|&;`<>]*)?")
INSTALL_CMD = re.compile(r"(?:npm ci|(?:pnpm|yarn) install --(?:frozen-lockfile|immutable)|(?:python3 -m )?pip install(?: -[-\w]+)* -r [^\s|&;`<>$()]+"
                         r"|npx(?: --no-install)? [\w@./-]+ (?:sync|generate))(?: [^|&;`<>$()]*)?")
RUNNER_UNSET = {"GH_TOKEN", "GITHUB_TOKEN", "ZIZMOR_PATHS"}  # absent from a runner step's env unless its env: or the zizmor with: sets them
KNOWN_ACTION = re.compile(r"(?:\S*/)?actions/(ste-lint|code-check|zizmor)(?:@\S*)?")
LOCAL_ACTION = re.compile(r"[$.]/actions/\S+")  # this repo's own action: a check --lint should run
CODE_CHECK = os.path.join("actions", "code-check", "code_check.py")  # under a checkout of this repo
ZIZMOR_RUN = os.path.join("actions", "zizmor", "run.sh")  # the one home of the pinned zizmor run
PIN_NOTE = re.compile(r"^%s.+$" % re.escape(PIN_NOTE_MARKER), re.M)  # a whole drift line of bin/ste-changed, marker first


def action_file(top, step, rel, pinned=None):
    """(path, None) to the file `rel` of the action the step's uses: names; (None, looked-at) when a remote uses:
    finds none. A local uses: is always the repo under test's own file, even when missing, so the step fails here as
    in CI. A remote uses: is the file in the `pinned` tree when the workflow pins one (CI runs that commit, so a copy
    from anywhere else would test other code), else the copy beside this file, else the one in the pointer checkout."""
    if LOCAL_ACTION.fullmatch(uses(step)):
        return os.path.join(top, rel), None
    if pinned:
        path = os.path.join(pinned, rel)
        return (path, None) if os.path.isfile(path) else (None, path)
    roots = [os.path.dirname(BIN)]
    try:
        from guard_pointer import pointer_checkout  # the one Python reader of the global rules file's @-line
        roots.append(pointer_checkout())
    except ImportError:
        pass
    paths = [os.path.join(root, rel) for root in roots if root]
    found = next((p for p in paths if os.path.isfile(p)), None)
    return found, None if found else " or ".join(paths)


def code_check(top, step, pinned=None):
    return action_file(top, step, CODE_CHECK, pinned)


def uses(step):
    return yaml_scalar(step_key(step, "uses"))


def known_action(step):
    """ste-lint, code-check or zizmor when the step uses one of them, else None."""
    m = KNOWN_ACTION.fullmatch(uses(step))
    return m.group(1) if m else None


def is_lint(step):
    """True when the step's whole run: is fast lint/check commands: each line one lint command, no mutation script.
    The ste-lint, code-check and zizmor actions count: plan() runs each one's own command for it."""
    if known_action(step):
        return True
    lines = run_lines(step)
    return bool(lines) and all(LINT_CMD.fullmatch(ln) and "mutate" not in ln.split()[
        1 if ln.startswith("python3") else 2 if ln.startswith("pipx") else 0] for ln in lines)


def run_lines(step):
    """The step's run: lines, with no blank line and no comment."""
    return [ln.strip() for ln in (run_body(step) or "").splitlines() if ln.strip() and not ln.strip().startswith("#")]


def is_install(step):
    """True when the step's whole run: is install commands: a lockfile install or a framework's type generation."""
    lines = run_lines(step)
    return bool(lines) and all(INSTALL_CMD.fullmatch(ln) for ln in lines)


def pin_notes(log, start):
    """The drift lines bin/ste-changed printed in this run's part of the log, each whole, marker first."""
    try:
        with open(log, "rb") as f:
            f.seek(start)
            return [n.rstrip() for n in PIN_NOTE.findall(f.read().decode("utf-8", "replace"))]
    except OSError:
        return []


def could_not_start(log, start):
    """(each 'could not start' failure, True when every failure is one) from code_check.py's ::error lines in this
    run's part of the log. Only then is the step unknown: a failure that needed no tool is still a FAIL."""
    try:
        with open(log, "rb") as f:
            f.seek(start)
            text = f.read().decode("utf-8", "replace")
    except OSError:
        return [], False
    errors = re.findall(r"^::error title=code-check::(.*)$", text, re.M)
    unstarted = sorted(set(e for e in errors if re.match(r"\S+ could not start: ", e)))
    return unstarted, bool(errors) and len(unstarted) == len(set(errors))


def plan(step, pr, values, top, lint=False, pinned=None):
    """(state, detail, argv, env, cwd): state is run, not run locally, skipped or unknown. lint: the run is --lint.
    `pinned` is the claude-settings tree a --step or --lint run pins: a remote action's files are read from it."""
    if step_key(step, "continue-on-error") not in (None, "false"):
        return "unknown", "continue-on-error: this runner reads no step as allowed to fail", None, None, None
    action = known_action(step)
    if action == "zizmor":  # run.sh under the action's folder, with the step's with: paths; it needs no base
        if not shell_argv(None):
            return "unknown", no_shell("bash"), None, None, None
        if not shutil.which("pipx"):
            return "unknown", "tool missing: pipx", None, None, None
        path, looked = action_file(top, step, ZIZMOR_RUN, pinned)
        if not path:
            return "unknown", "no run.sh: looked for %s" % looked, None, None, None
        env = {}
        if "paths" in step_with(step):
            env["ZIZMOR_PATHS"] = expand(step_with(step)["paths"].strip("'\""), values)
            if env["ZIZMOR_PATHS"] is None:
                return "unknown", "with: paths needs an expression this runner cannot read: %s" % step_with(step)["paths"], None, None, None
        # A missing run.sh of a local uses: must FAIL, as in CI; bash alone would exit 127 and read as a missing tool.
        path = slashed(path)  # $BASH: the bash running this script, never a PATH lookup that may find the WSL launcher
        return "run", 'test -f "%s" || { echo "no run.sh at %s" >&2; exit 1; }\n"$BASH" "%s"\n' % (path, path, path), shell_argv(None), env, None
    if action:
        if not pr:
            return "skipped", "a pull-request step: pass --base to run it", None, None, None
        if not shell_argv(None):
            return "unknown", no_shell("bash"), None, None, None
        if not shutil.which("python3"):
            return "unknown", "tool missing: python3", None, None, None
        if action == "code-check":  # the action.yml's own command
            path, looked = code_check(top, step, pinned)
            if not path:
                return "unknown", "no code_check.py: looked for %s" % looked, None, None, None
            return "run", 'python3 "%s" --base "%s"' % (slashed(path), values["base"]), shell_argv(None), {}, None
        ste = os.path.join(BIN, "ste-changed")
        if pinned and not LOCAL_ACTION.fullmatch(uses(step)):  # CI runs the pinned commit's lint, so its command is the one to run
            ste, looked = action_file(top, step, os.path.join("bin", "ste-changed"), pinned)
            if not ste:
                return "unknown", "no bin/ste-changed in the pinned tree: looked for %s" % looked, None, None, None
        # A pinned tree's bin/ste-changed reads a stale pin itself (the caller sets STE_CHANGED_CLONE and STE_CHANGED_COMPARE_TO) and
        # exits 3: run_step reads that as a FAIL, and the run exits 1 under --step and 3 under --lint (decision action-pins-follow-sessions).
        # Only the local copy, which has no pin to judge, passes with a stale pin under --lint and says so.
        note = lint and not (pinned and not LOCAL_ACTION.fullmatch(uses(step)))
        return "run", '"%s" "%s"' % (slashed(ste), values["base"]), shell_argv(None), {PIN_NOTE_ENV: "1"} if note else {}, None
    if step_key(step, "uses") is not None:
        return "not run locally", "an action (uses: %s); CI runs it" % uses(step), None, None, None
    cond = condition(step_key(step, "if"), pr)
    if cond is None:
        return "unknown", "an if: this runner cannot read: %s" % step_key(step, "if"), None, None, None
    if not cond:
        why = "a pull-request step: pass --base to run it" if not pr else "a step that runs only off a pull request"
        return "skipped", why, None, None, None
    body = run_body(step)
    if body is None:
        return "unknown", "no run: and no uses:", None, None, None
    env = {}
    for name, raw in step_env(step).items():
        val = expand(raw.strip("'\""), values)
        if val is None:
            return "unknown", "env %s needs an expression this runner cannot read: %s" % (name, raw), None, None, None
        env[name] = val
    if EXPR.search(body):
        return "unknown", "run: holds an expression this runner cannot read", None, None, None
    shell = step_key(step, "shell")
    if shell not in SHELLS:
        return "unknown", "shell %s is not one this runner knows" % shell, None, None, None
    argv = shell_argv(shell)
    if argv is None:
        return "unknown", no_shell(SHELLS[shell][0]), None, None, None
    # A CI step with a suite scans only its suite lines: a preamble tool in a block the shell skips must not refuse it,
    # and one the shell reaches and cannot find still reads unknown, from missing_in_log.
    scanned = "\n".join(ln for ln in run_lines(step) if SUITE_LINE.fullmatch(ln)) if suite_paths(step) else body
    need = [argv[0]] + (commands(scanned) if shell in (None, "bash", "sh") else [])
    gone = sorted({w for w in need if not shutil.which(w)})
    if gone:
        return "unknown", "tool missing: %s" % ", ".join(gone), None, None, None
    return "run", body, argv, env, step_key(step, "working-directory")


def settings_clone():
    """The claude-settings clone a pin is read from: CI_JOB_SETTINGS_CLONE, else this file's own clone, else (a copy
    install, which is no clone) the one the global rules file names."""
    given = os.environ.get("CI_JOB_SETTINGS_CLONE")
    if given:
        return given
    own = os.path.dirname(BIN)
    top = git("rev-parse", "--show-toplevel", cwd=own)
    if top and os.path.realpath(top) == os.path.realpath(own):
        return own
    try:
        from guard_pointer import pointer_checkout  # the one Python reader of the global rules file's @-line
        return pointer_checkout() or own
    except ImportError:
        return own


def last_line(done):
    return (done.stderr.strip().splitlines() or done.stdout.strip().splitlines() or ["no message"])[-1]


def pin_of(text):
    """(ref, why): the one ref the workflow pins claude-settings actions at, a 40-hex sha or a moving ref such as the stable
    branch (pin_tree resolves it to its commit); (None, None) when it pins none; (None, why) when it pins two refs, since then
    there is no one tree CI would run."""
    refs = list(dict.fromkeys(ref for _, ref, _ in settings_pins(text)))
    if len(refs) > 1:
        return None, "the workflow pins claude-settings at %d refs (%s), so there is no one pinned tree" % (len(refs), ", ".join(refs))
    return (refs[0] if refs else None), None


def own_pin(step):
    """(ref, why) of the ref a remote claude-settings action step (code-check, zizmor, ste-lint) pins itself, as CI downloads
    each pinned ref separately; (None, None) when the step is no such action, so it takes the job's pin."""
    if not known_action(step):
        return None, None
    m = SETTINGS_ACTION.search(uses(step))
    return (m.group(2), None) if m else (None, None)


STABLE_BRANCH = "stable"  # the branch CI's child repos pin and sessions install from (R42 part 2, the stable-mover action); none exists on main yet
STABLE_HEADS = {}  # {clone: (sha or None, why none)}: the stable branch's head, fetched once per run
DRIFT_EXIT = 3  # ste-changed's exit for a stale pin; a --lint run whose only FAILs are stale pins exits with it
DRIFTED = []  # each ste-lint step that exited DRIFT_EXIT: a stale pin
PIN_TREES = {}  # {ref: (tree or None, why none)}: one fetch and one archive per ref per run
PIN_MADE = []  # every folder made, so the run's end deletes it even when the archive or the install failed
LIVE = []  # the bin/verdict processes now running: a SIGTERM ends them, not the steps they started


def pin_label(ref):
    """A pin as a message names it: a sha cut to 9 characters, a moving ref whole."""
    return ref[:9] if COMMIT_SHA.fullmatch(ref) else ref


def clone_problem(ref, clone, fetch):
    """Why `clone` cannot serve the pin `ref`, or None. Without `fetch` (--plan) a sha the clone lacks is a problem: it would
    have to be fetched, which --plan does not do. A moving ref is resolved only by a run, so --plan reads nothing of it."""
    label = pin_label(ref)
    if not os.path.isdir(clone):
        return "pin %s: %s is not a folder (CI_JOB_SETTINGS_CLONE, else this clone, else the global rules file's checkout)" % (label, clone)
    if git("rev-parse", "--git-dir", cwd=clone) is None:
        return "pin %s: %s is no git clone" % (label, clone)
    if not fetch and COMMIT_SHA.fullmatch(ref) and git("cat-file", "-e", ref + "^{commit}", cwd=clone) is None:
        return "pin %s: %s does not hold it, and --plan does not fetch, so a run would git fetch origin %s first" % (label, clone, ref)
    return None


def fetch_ref(clone, ref):
    """The failed `git fetch origin <ref>` result, or None when it worked. A credential prompt must fail, not hang the run."""
    got = _nowindow.run(["git", "fetch", "-q", "origin", ref], cwd=clone, capture_output=True, text=True,
                        env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
    return got if got.returncode != 0 else None


def stable_head(clone):
    """(sha, None): the commit the stable branch of `clone`'s origin names now, fetched once per run; (None, why) when it cannot
    be read. A pin is judged against it: a stale pin cannot read as a pass when the head is unknown."""
    if clone not in STABLE_HEADS:
        why = clone_problem(STABLE_BRANCH, clone, True)
        sha = None
        if not why:
            got = fetch_ref(clone, STABLE_BRANCH)
            sha = None if got else git("rev-parse", "--verify", "-q", "FETCH_HEAD^{commit}", cwd=clone)
            why = ("git fetch origin %s failed in %s: %s" % (STABLE_BRANCH, clone, last_line(got)) if got else
                   None if sha else "the stable branch names no commit in %s after the fetch" % clone)
        STABLE_HEADS[clone] = (sha, why)
    return STABLE_HEADS[clone]


def pin_tree(ref):
    """(tree, None): a fresh temp dir holding `git archive` of the commit `ref` names, the whole repo, with its npm packages
    when it has a lockfile; (None, why) when it cannot be made. `ref` is a 40-hex sha, fetched from the clone's origin only
    when the clone lacks it, or a moving ref such as the stable branch CI pins, which is fetched every run (the branch moves)
    and resolved to the commit it names first."""
    if ref in PIN_TREES:
        return PIN_TREES[ref]
    sha, label, clone = ref, pin_label(ref), settings_clone()
    why = clone_problem(ref, clone, True)
    if not why and COMMIT_SHA.fullmatch(ref):
        if git("cat-file", "-e", ref + "^{commit}", cwd=clone) is None:
            got = fetch_ref(clone, ref)
            if got:
                why = "pin %s: git fetch origin %s failed in %s: %s" % (label, ref, clone, last_line(got))
    elif not why:
        got = fetch_ref(clone, ref)
        sha = None if got else git("rev-parse", "--verify", "-q", "FETCH_HEAD^{commit}", cwd=clone)
        if got:
            why = "pin %s: git fetch origin %s failed in %s: %s" % (label, ref, clone, last_line(got))
        elif not sha:
            why = "pin %s: the ref names no commit in %s after the fetch" % (label, clone)
    tree = None
    if not why:
        tree = tempfile.mkdtemp(prefix="ci-job-pin-%s-" % sha[:7])
        PIN_MADE.append(tree)
        try:
            with _nowindow.Popen(["git", "archive", "--format=tar", sha], cwd=clone, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL) as proc, tarfile.open(fileobj=proc.stdout, mode="r|") as tar:
                for member in tar:  # the stream is read once; a member is extracted as it passes
                    if member.issym():
                        continue  # the harness reads no symlink, and a host that refuses os.symlink would fail the whole export
                    tar.extract(member, tree, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
            if proc.returncode != 0:
                why = "pin %s: git archive exited %d in %s" % (label, proc.returncode, clone)
        except (OSError, tarfile.TarError) as exc:
            why = "pin %s: git archive failed in %s (%s: %s)" % (label, clone, type(exc).__name__, exc)
    if not why and os.path.isfile(os.path.join(tree, "package-lock.json")):
        if not shutil.which("npm"):
            why = "pin %s: tool missing: npm (the pinned tree has a package-lock.json)" % label
        else:
            done = _nowindow.run(["npm", "ci", "--ignore-scripts"], cwd=tree, capture_output=True, text=True)
            if done.returncode != 0:
                why = "pin %s: npm ci failed in the pinned tree: %s" % (label, last_line(done))
    PIN_TREES[ref] = (None if why else tree, why)
    return PIN_TREES[ref]


def drop_pin_trees():
    """Delete every exported tree, each by its absolute path."""
    for tree in PIN_MADE:
        shutil.rmtree(os.path.abspath(tree), ignore_errors=True)
    PIN_MADE.clear()
    PIN_TREES.clear()


def end_on_sigterm():
    """Make a SIGTERM end the run through its `finally`s (drop_pin_trees runs at the end of __main__): each running
    bin/verdict is ended first, but the step it started gets no signal and may keep running. A second signal is ignored.
    Off the main thread nothing changes."""
    def stop(sig, frame):
        signal.signal(sig, signal.SIG_IGN)
        for proc in list(LIVE):
            if proc.poll() is None:
                proc.terminate()
        raise SystemExit(128 + sig)
    try:
        signal.signal(signal.SIGTERM, stop)
    except ValueError:
        pass


ERR_LOCK = threading.Lock()  # a parallel run writes stderr from several threads: one whole line at a time


def err_line(text):
    """One whole line to stderr, flushed at once: the stall watch reads it, and a caller sees which step is running."""
    with ERR_LOCK:
        try:
            sys.stderr.write(text)
            sys.stderr.flush()
        except OSError:
            pass  # reader gone: the step's verdict still prints


def lint_workers():
    """How many --lint steps run at once: CI_JOB_LINT_WORKERS when it is a positive integer, else the CPU count capped at 4, at least 1."""
    raw = os.environ.get("CI_JOB_LINT_WORKERS", "").strip()
    if raw.isascii() and raw.isdigit() and int(raw) > 0:
        return int(raw)
    return max(1, min(os.cpu_count() or 1, 4))


def run_step(name, step, install, detail, shell, env, cwd, ctx, log, suite=False, pinned=None):
    """Run one step through bin/verdict, its output appended to `log`: (state, the step's one line). ctx: (top, base,
    values). A parallel step gets a log of its own, so the reads from its start offset see only its output.
    suite: a CI step picked for its suite line, run whole, with the preamble marker (preamble_marked).
    pinned: the claude-settings tree of the step's own pin, for the code_check.py its line names."""
    top, base, values = ctx
    err_line("start: %s\n" % name)
    with tempfile.NamedTemporaryFile("w", suffix=".ps1" if shell[0] == "pwsh" else ".sh", delete=False,
                                     encoding="utf-8", newline="\n") as f:
        marked = preamble_marked(detail, shell[0]) if suite else None
        f.write("$ErrorActionPreference = 'stop'\n" + detail if shell[0] == "pwsh" else marked or detail)
        script = f.name
    try:
        start = os.path.getsize(log) if os.path.exists(log) else 0
        kept = []
        with _nowindow.Popen([sys.executable, os.path.join(BIN, "verdict"), *shell, script],
                             cwd=os.path.join(top, cwd) if cwd else top, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True,
                             env={**{k: v for k, v in os.environ.items() if k not in RUNNER_UNSET | {"GITHUB_BASE_REF", PIN_NOTE_ENV}},
                                  **({"GITHUB_BASE_REF": values["github.base_ref"]} if base else {}),
                                  **env, "VERDICT_LOG": log}) as proc:
            LIVE.append(proc)
            try:
                for line in proc.stdout:  # relay each heartbeat at once: the stall watch reads this job's output
                    if line.startswith("verdict: still running"):
                        err_line(line)
                    else:
                        kept.append(line)
            finally:
                LIVE.remove(proc)
        rc = proc.returncode
        gone = missing_in_log(log, start, script)
        preamble_ran = not marked or bool(re.search(r"(?m)^%s\r?$" % PREAMBLE_MARK, log_text(log, start)))
        unstarted, only = could_not_start(log, start) if known_action(step) == "code-check" else ([], False)
    finally:
        os.remove(script)
    first = next((ln.rstrip("\n") for ln in kept if ln.startswith(("PASS ", "SKIP ", "FAIL "))),
                 "(verdict printed no verdict line)")
    if known_action(step) == "code-check":
        first += " (code_check.py: %s)" % code_check(top, step, pinned)[0]
    if rc == 127 or gone:
        state = "unknown"
        first = "tool missing (%s); %s" % (", ".join(gone) or "exit 127", first)
    elif unstarted and only:
        state = "unknown"
        first = "tool missing (%s); %s" % ("; ".join(unstarted), first)
    else:
        state = "FAIL" if rc else "SKIP" if first.startswith("SKIP ") else "PASS"
        if install and state == "FAIL":  # the tree at fault, not the change: unknown, never FAIL
            state, first = "unknown", "install failed, so each lint step after it is unknown; " + first
        elif state == "FAIL" and not preamble_ran:  # the same rule for a line before the suite of a CI step: the tree at fault
            state, first = "unknown", "a line before the suite failed, so the suite did not run; " + first
        if unstarted:
            first = "%s; also tool missing (%s)" % (first, "; ".join(unstarted))
        if state == "FAIL" and rc == DRIFT_EXIT and known_action(step) == "ste-lint":
            DRIFTED.append(name)  # ste-changed's exit for a stale pin, which a --lint run reports as its own exit
        notes = pin_notes(log, start) if state == "PASS" and known_action(step) == "ste-lint" else []
        if notes:  # a passing lint with a stale pin: the lane keeps its place and moves the pin in a lane of its own
            first = "%s; %s" % (first, "; ".join(notes))
    return state, first


def append_log(src, dst, name):
    """Add a finished parallel CI step's log to the run's log, then delete it. A failed copy keeps the CI step's log and names
    it on stderr: its verdict names the run's log, which then lacks that output. Returns True when the log was kept."""
    try:
        with open(src, "rb") as f, open(dst, "ab") as g:
            shutil.copyfileobj(f, g)
    except OSError:
        err_line("ci-job: could not add the log of CI step %s to the run's log; its output is kept in %s\n" % (name, src))
        return True
    try:
        os.remove(src)
    except OSError:
        pass  # the copy is in; the folder's removal at the end of the run takes what is left
    return False


def suite_paths(step):
    """The suites a CI step runs: the path of each of its run: lines that is `python3 hooks|merge/test_<name>.py`, with
    arguments allowed. Any other line of the step stays in it, so a picked step runs whole, as CI runs it."""
    return [m.group(1) for ln in run_lines(step) if (m := SUITE_LINE.fullmatch(ln))]


def log_text(log, start):
    """This run's part of the log: from byte `start` on; empty when the log cannot be read."""
    try:
        with open(log, "rb") as f:
            f.seek(start)
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def preamble_marked(body, shell):
    """The CI step's run: body with PREAMBLE_DONE right before its first suite line, when a command line comes before it.
    The marker prints only when the shell reaches the suite line, so a failure with no marker in the log is the preamble's
    (a failed `[ -d x ] || npm ci`), and one after it is the suite's, even when a preamble block is skipped. None, so the
    CI step's failure reads as the suite's, when no command line precedes the suite line; when the suite line is indented,
    not plainly at the script's top level; when the line before it ends in `\\`, `&&`, `||` or `|`, so a marker would join that command list; and
    under pwsh, where a native command that fails does not stop the script, so a marker cannot show the preamble passed."""
    lines = body.splitlines()
    first = next((i for i, ln in enumerate(lines) if SUITE_LINE.fullmatch(ln.strip())), None)
    before = [ln for ln in lines[:first or 0] if ln.strip() and not ln.strip().startswith("#")]
    if shell == "pwsh" or not before or lines[first][:1].isspace() or before[-1].rstrip().endswith(("\\", "&&", "|")):  # "|" also ends "||"
        return None
    return "\n".join(lines[:first] + [PREAMBLE_DONE] + lines[first:]) + "\n"


def main(argv):
    args = list(argv)
    opts = {"--workflow": None, "--base": None}
    for key in opts:
        if key in args:
            i = args.index(key)
            if i + 1 >= len(args):
                print(USAGE)
                return 2
            opts[key] = args[i + 1]
            del args[i:i + 2]
    wanted = []  # --step names, in order given
    while "--step" in args:
        i = args.index("--step")
        if i + 1 >= len(args):
            print(USAGE)
            return 2
        wanted.append(args[i + 1])
        del args[i:i + 2]
    dry = "--plan" in args
    lint = "--lint" in args
    args = [a for a in args if a not in ("--plan", "--lint")]
    if len(args) != 1 or (wanted and lint):
        print(USAGE)
        return 2
    job = args[0]
    top = git("rev-parse", "--show-toplevel") or os.getcwd()
    workflow = opts["--workflow"]
    if not workflow:
        workflow, why = job_workflow(top, job)
        if why:
            print("unknown  cannot read the workflow: %s" % why)
            return 2
    try:
        with open(workflow, encoding="utf-8") as f:
            text = f.read()
        block = job_block(text, job)
    except OSError as e:
        print("unknown  cannot read the workflow: %s" % e)
        return 2
    if block is None:
        print("unknown  no job %r in %s" % (job, workflow))
        return 2
    if re.search(r"^    (?:env|defaults):", block, re.M):
        print("unknown  job %r sets a job-level env: or defaults:, which this runner does not read" % job)
        return 2
    steps = step_blocks(block)
    names = [step_key(st, "name") or ("step %d" % n) for n, st in enumerate(steps, 1)]
    absent = [w for w in dict.fromkeys(wanted) if w not in names]
    if absent:  # a typo is told at once and costs no run
        for w in absent:
            print("%-15s --step %s: no step of job %r has this name" % ("unknown", w, job))
        return 2
    base, no_base = opts["--base"], False
    if lint and not base:
        # A no-base lint run once read as a pass while CI's pull-request steps failed: default to CI's base.
        if git("rev-parse", "--verify", "-q", "origin/main^{commit}", cwd=top):
            base = "origin/main"
            print("base: origin/main (default; pass --base to change)")
        else:
            idle = {"base": "", "github.base_ref": "", "github.event.pull_request.head.sha": ""}
            unread = [step_key(st, "name") or ("step %d" % n) for n, st in enumerate(step_blocks(block), 1)
                      if is_lint(st) and plan(st, False, idle, top)[0] == "skipped"]
            if unread:
                print("unknown         no base resolved (origin/main is absent; pass --base), so these pull-request "
                      "steps are skipped: %s" % ", ".join(unread))
                no_base = True
    values = {"base": base or "", "github.base_ref": base.split("/", 1)[1] if base and "/" in base else (base or ""),
              "github.event.pull_request.head.sha": git("rev-parse", "HEAD", cwd=top) or ""}
    # Each step that runs gets the claude-settings tree it pins, as CI does: a named step (--step), or under --lint each lint
    # step that is not skipped. --lint --plan reads the pins but needs no clone (no fetch, no tree).
    trees, need, blocked, drift_env = {}, {}, {}, {}  # sha -> its tree; step index -> (sha, why); step index -> why it is unknown; step index -> env that lets its ste-changed judge the pin
    plain_sha = None  # the one sha the job pins, when it pins exactly one: a plain run step takes it
    asked = [n for n, st in enumerate(steps) if (names[n] in wanted if wanted else
                                                  lint and is_lint(st) and plan(st, bool(base), values, top, lint)[0] != "skipped")]
    if asked:
        plain_sha, plain_why = pin_of(block)  # the pins of this job's steps only
        for n in asked:
            if LOCAL_ACTION.fullmatch(uses(steps[n])):
                continue  # a local uses: runs the repo under test's own file: it needs no pin, tree or fetch
            sha, why = own_pin(steps[n])  # a "sha" here is any pinned ref: a commit sha or a moving ref
            need[n] = (sha, why) if sha or why else (plain_sha, plain_why)
        clone = settings_clone() if wanted or not dry else None
        for sha in dict.fromkeys(sha for sha, _ in need.values() if sha):  # one tree per distinct sha a step needs
            if dry:
                tree, why = None, clone_problem(sha, clone, False) if wanted else None  # --plan makes no fetch and no archive
            else:
                if not trees:
                    end_on_sigterm()  # before the first tree exists, so a signal while it is made still removes it
                tree, why = pin_tree(sha)
            if tree:
                trees[sha] = tree
            for n, (own, _) in need.items():
                if own == sha and why:  # no tree to run in: a step run against other code would be a guess
                    blocked[n] = why
        for n, (own, why) in need.items():  # a ste-lint step at a sha is judged against the stable branch's head: unread, it is unknown
            if not why and not dry and n not in blocked and known_action(steps[n]) == "ste-lint" and COMMIT_SHA.fullmatch(own or ""):
                head, why = stable_head(clone)
                if why:
                    blocked[n] = "pin %s: the stable branch head cannot be read, so drift is unknown: %s" % (pin_label(own), why)
                else:
                    drift_env[n] = {"STE_CHANGED_CLONE": clone, "STE_CHANGED_COMPARE_TO": head}
        for n, (_, why) in need.items():
            if why:
                blocked[n] = why
        if all(n in blocked for n in asked):  # a local step is never blocked: it still runs and prints
            for n in need:
                print("%-15s %s: %s" % ("unknown", names[n], blocked[n]))
            return 2
    own_tree = {n: trees.get(sha) for n, (sha, _) in need.items()}  # this step's own tree: its own sha, else the job's one

    def step_env_for(i, step, env):
        """The step's env with CLAUDE_SETTINGS_DIR at the job's one pinned tree (a local uses: gets none) and, for a pinned
        ste-lint step, the clone and commit its pin is judged against; the step's own env: wins."""
        return {**({"CLAUDE_SETTINGS_DIR": trees[plain_sha]} if plain_sha in trees and not LOCAL_ACTION.fullmatch(uses(step)) else {}),
                **drift_env.get(i, {}), **env}
    log = os.environ.get("VERDICT_LOG")
    if not log and not dry:
        fd, log = tempfile.mkstemp(prefix="ci-job-%s-" % re.sub(r"[^\w-]", "_", job), suffix=".log")
        os.close(fd)
    tally = {"FAIL": 0, "unknown": int(no_base)}
    unshallow(block, top, dry, tally)
    kind = ["lint" if is_lint(st) else "install" if is_install(st) else "" for st in steps] if lint else [""] * len(steps)
    suites = [suite_paths(st) if lint and not k else [] for st, k in zip(steps, kind)]  # each step's suite lines
    elsewhere = {}  # each other job: the suites of its CI steps, which this run does not run
    if lint and base:
        for other in re.findall(r"^  ([\w-]+):\s*$", text.split("\njobs:", 1)[-1], re.M):
            found = {path for st in step_blocks(job_block(text, other)) for path in suite_paths(st)} if other != job else set()
            if found:
                elsewhere[other] = found
    picked, why = None, "no base to read a diff"
    if base and (any(suites) or elsewhere):  # one selector process for the CI steps with a suite in every job
        why = "the selector did not run"
        try:
            done = _nowindow.run([sys.executable, os.path.join(os.path.dirname(BIN), "hooks", "mutate_guard.py"),
                                  "--lint-suites", base], cwd=top, capture_output=True, text=True, encoding="utf-8",
                                 stdin=subprocess.DEVNULL, timeout=SELECTOR_LIMIT)
            if done.returncode == 0:
                picked = set(done.stdout.split())
            else:
                why = ((done.stdout + done.stderr).strip().splitlines() or ["exit %d with no message" % done.returncode])[-1]
        except subprocess.TimeoutExpired:
            why = "the selector ran past %d s and was stopped" % SELECTOR_LIMIT
        except OSError as e:
            why = str(e)
    for i, found in enumerate(suites):  # a step with a picked suite runs as a lint step does
        if picked is not None and picked.intersection(found):
            kind[i] = "suite"
    planned = [plan(st, bool(base), values, top, lint, own_tree.get(i)) if k else None for i, (st, k) in enumerate(zip(steps, kind))]
    runs = [k == "lint" and p[0] == "run" and i not in blocked for i, (k, p) in enumerate(zip(kind, planned))]  # an install runs only if a lint step after it does
    ran, ran_lint, blocker = 0, 0, None  # blocker: the install step that did not finish
    ctx = (top, base, values)
    workers = lint_workers() if lint and not dry else 1
    pool = concurrent.futures.ThreadPoolExecutor(workers) if workers > 1 else None  # one worker is the serial path
    logdir = tempfile.mkdtemp(prefix="ci-job-lint-") if pool else None  # each parallel step's own log, until it is added to the run's
    kept_logs = False
    futures, logs = {}, {}  # by step index: the queued run, and its log
    try:
        for n, step in enumerate(steps, 1):
            name = names[n - 1]
            if wanted and name not in wanted:
                continue
            if n - 1 in blocked:
                tally["unknown"] += 1
                print("%-15s %s: %s" % ("unknown", name, blocked[n - 1]))
                continue
            pinned = own_tree.get(n - 1)
            if suites[n - 1] and base and picked is None:  # the selector could not run: never a pass with no suite run
                tally["unknown"] += 1
                print("%-15s %s: --lint could not select suites: %s" % ("unknown", name, why))
                continue
            if lint and not kind[n - 1]:
                if LOCAL_ACTION.fullmatch(uses(step)):
                    tally["unknown"] += 1
                    print("%-15s %s: --lint cannot run this repo's action %s" % ("unknown", name, uses(step)))
                else:
                    print("%-15s %s: --lint runs only lint and install steps; %s" % (
                        "not run", name, "this is an action (uses: %s)" % uses(step) if uses(step) else
                        "this is a suite the diff does not pick%s" % ("" if base else " (no base to read a diff)") if suites[n - 1]
                        else "its run: is neither a lint nor an install command"))
                continue
            if kind[n - 1] == "install" and (blocker or not any(runs[n:])):
                print("%-15s %s: %s" % ("not run", name, "install step %s did not finish" % blocker if blocker
                                        else "no lint step after it will run"))
                continue
            if kind[n - 1] == "lint" and blocker and runs[n - 1]:
                tally["unknown"] += 1
                print("%-15s %s: --lint did not run it: install step %s did not finish" % ("unknown", name, blocker))
                continue
            state, detail, shell, env, cwd = planned[n - 1] or plan(step, bool(base), values, top, lint, pinned)
            if lint and kind[n - 1] == "lint" and state == "skipped" and condition(step_key(step, "if"), True) is not False \
                    and not base:  # a required CI step (its if: reads true on a pull-request run) that did not run proved nothing
                state, detail = "unknown", "a pull-request step, skipped for want of a base (pass --base)"
            if state != "run":
                if wanted and state != "unknown":  # a named step that did not run proved nothing: never a pass
                    state, detail = "unknown", "--step named it, but it did not run (%s): %s" % (state, detail)
                print("%-15s %s: %s" % (state, name, detail))
                tally["unknown"] += state == "unknown"
                blocker = blocker or (name if kind[n - 1] == "install" and state == "unknown" else None)
                continue
            ran += 1
            ran_lint += kind[n - 1] in ("lint", "suite")  # a picked suite step that ran is a lint run too
            if dry:
                print("%-15s %s" % ("would run", name))
                continue
            install = kind[n - 1] == "install"
            if pool and kind[n - 1] == "lint":
                if n - 1 not in futures:  # the first step of a segment: queue each lint step up to the next install, in order
                    end = next((i for i in range(n, len(steps)) if kind[i] == "install"), len(steps))
                    for i in range(n - 1, end):
                        if runs[i]:
                            logs[i] = os.path.join(logdir, "%d.log" % i)
                            futures[i] = pool.submit(run_step, names[i], steps[i], False, planned[i][1], planned[i][2],
                                                     step_env_for(i, steps[i], planned[i][3]), planned[i][4], ctx, logs[i],
                                                     pinned=own_tree.get(i))
                state, first = futures.pop(n - 1).result()
                own = logs.pop(n - 1)
                if append_log(own, log, name):  # in CI step order, so the run's log reads as a serial run's
                    kept_logs = True
                first = first.replace(own, log)  # the verdict line names the log that stays
            else:
                state, first = run_step(name, step, install, detail, shell, step_env_for(n - 1, step, env), cwd, ctx, log,
                                        kind[n - 1] == "suite", pinned)
            tally["FAIL" if state == "FAIL" else "unknown"] += state not in ("PASS", "SKIP")
            blocker = blocker or (name if install and state == "unknown" else None)
            print("%-15s %s: %s" % (state, name, first))
    finally:
        if pool:
            pool.shutdown(cancel_futures=True)
            if not kept_logs:  # a log that did not reach the run's log stays in the folder for the reader
                shutil.rmtree(os.path.abspath(logdir), ignore_errors=True)
    if lint and not ran_lint and not tally["FAIL"] and not tally["unknown"]:  # a pass that ran no lint CI step proved nothing; any other line already gives the exit
        tally["unknown"] += 1
        print("%-15s no lint CI step %s: %d of the job's %d steps are lint CI steps, and each one is skipped, not run, or unknown" % (
            "unknown", "would run" if dry else "ran", sum(k == "lint" for k in kind), len(steps)))
    if lint:
        for other, found in elsewhere.items():  # one line per job: picked, but each CI step belongs to a job this run is not
            if picked is not None and picked.intersection(found):
                print("%-15s job %s: picked %s; job %s runs them, not %s" % ("not run", other, ", ".join(sorted(picked & found)), other, job))
        if picked is None and elsewhere and not any(suites):
            print("%-15s suites of other jobs: --lint could not select them: %s" % ("not run", why))
        print("summary: %s %d of %d steps" % ("would run" if dry else "ran", ran, len(steps)))
    if not dry:
        print("log=%s" % log)
    stale = len(DRIFTED) if lint else 0  # under --lint a stale pin is exit 3 when it is the only FAIL; under --step it is a FAIL like any other
    if tally["FAIL"] > stale:
        return 1
    return DRIFT_EXIT if tally["FAIL"] else 2 if tally["unknown"] else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    finally:
        drop_pin_trees()
