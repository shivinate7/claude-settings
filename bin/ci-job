#!/usr/bin/env python3
# ci-job <job> [--workflow <file>] [--base <ref>] [--plan] [--lint] [--pinned] [--step NAME]...: run every step of one workflow job here,
# each through bin/verdict, and print one verdict per step. It runs on demand only: a lane never runs a full
# job, because the batch CI run is the only full run (lanes-run-no-full-ci-job). The one exception is --lint.
# --lint runs only the job's fast lint and check steps, chosen from the step commands in the workflow, never a
# list: a step whose whole run: is `python3 lint/<script>.py ...`, `python3 actions/<script>.py ...`,
# `bin/ste-changed ...` or a pinned `pipx run <tool>==<version> ...` (the pin read from the workflow), one command
# per line, no `&&`, `|` or `;`. A CI step with a `python3 hooks/test_<name>.py` or `python3 merge/test_<name>.py` line, with
# arguments or other lines around it, runs whole, as CI runs it, only when the one selector, `hooks/mutate_guard.py --lint-suites <base>`,
# picks that suite for a file of the diff <base>...HEAD. The selector follows imports: a suite is picked for a change to any
# module that a module it loads imports. A picked suite that fails is FAIL. A line before the suite that fails, so the
# shell never reaches the suite, makes the CI step unknown: ci-job echoes a marker right before a top-level first suite
# line (preamble_marked; not under pwsh) and reads a failure with no marker in the log as the preamble's. A selector that
# cannot run, or runs past its 60 s limit (SELECTOR_LIMIT), is unknown on each such CI step, exit 2. With no base or no
# pick, the CI step is `not run`. The job scope is the linted job only: the suites picked for the CI steps of another job
# print one `not run` line per job, naming the job and those suites, and run nowhere here. Cost: one selector process per
# lane lint (one git diff, one git ls-files, one parse of each tracked test_*.py and of each module they reach, once for
# the whole diff), plus one process per picked CI step. A mutation script (a name with "mutate")
# and every other command (bash, unpinned pipx, other uses:) is left out with one `not run` line naming the step and why, except a `uses:` of
# this repo's own action (`$/actions/<name>`, `./actions/<name>`), which runs only when the read of its action.yml below accepts it, else prints one unknown line. After the
# last step, one line counts the steps run out of the job's total (--plan: "would run"). Neither it nor a `not run`
# line starts with FAIL or unknown or moves the exit code: merge.py's lane lint reads those two words.
# An install CI step is a run: whose every line is one install command (INSTALL_CMD: a lockfile install, or type
# generation such as `npx astro sync`), since a lint step that reads generated files fails on a bare checkout. --lint
# runs it, in order, only when a later lint step will run, or a later local action passes local_ready (its uses: step and
# the read of its action.yml before any step runs, below); its if: and env read as any step's. An install that fails
# or is unknown prints unknown, never FAIL (the tree, not the change, is at fault), and each later lint step prints
# unknown naming it and does not run. Three `uses:` it runs in place, each by its one home: actions/ste-lint as
# `bin/ste-changed <base>` (shared with the action through actions/ste-lint/run.sh), actions/code-check as its
# action.yml's command, `python3 code_check.py --base <base>`,
# and actions/zizmor as its run.sh with the step's `with: paths` in ZIZMOR_PATHS. The first two need a base; zizmor
# needs none, and with no pipx it is unknown ("tool missing: pipx"). The step's uses: picks which checkout, as CI
# does. A local uses: (`$/actions/...`, `./actions/...`) runs the repo under test's own code_check.py or run.sh,
# never another's: missing or failing, it FAILs. A remote uses: (`owner/repo/actions/code-check@ref`) runs the copy
# beside ci-job, else (code-check, zizmor) the one in the checkout the global rules file names, else the step is
# unknown and names the paths it looked at. The code-check step's line names
# the code_check.py that ran. When every failure code_check.py reports is a pinned tool that could not start, the
# step is unknown; any other failure makes it FAIL, its reason naming the tools that could not start.
# A local `uses:` that is none of those three runs only under --lint, from the tree under test's own actions/<name>/action.yml. The
# `uses:` step's own if: and continue-on-error: read as a run: step's do (a false if: is skipped, an unreadable one or a continue-on-error is
# unknown), and after a failed install the action reads unknown naming it. A uses: step with its own env: is unknown naming the env, since
# CI hands that env to the action's steps and this runner does not. A read of action.yml before any step runs refuses the action unless:
# runs.using is composite; every step is a `shell: bash` run: (no uses:, no working-directory); the only expression in a run: is
# `${{ github.action_path }}`, read as the relative folder actions/<name> (the quotes around that one token drop); and every run: line is
# a lint command, as above. A refusal runs no step, and its one unknown line names the file, the line or the expression. Each step then
# runs as a workflow step does (its if:, env:, shell), with GITHUB_WORKSPACE set to the top level, and the first FAIL ends the action, as
# in CI. The action prints one line: FAIL when a step fails (a probe's exit 1 and exit 2 both read FAIL, since CI is red on both), else
# unknown when a step is unknown, else PASS. A step whose env needs the PR body (github.event.pull_request.body) is unknown, since this
# runner has no PR body: an action with such a step reads unknown after its other steps ran, and a FAIL of those still wins. The real
# two-step actions/claude-md-cites reads unknown for another reason: its second step's run: holds
# `HEAD_SHA="$(git ...)"` and `export HEAD_SHA`, which are not lint commands, so the read refuses the whole action, names that first line,
# and runs none of its steps. Cost: one bin/verdict and one shell per step, in order on the main thread, never in the worker pool; one
# `git rev-parse` of the base per run with a base.
# --lint with no --base takes origin/main as CI does and says so
# in one line, because a run that skipped the pull-request steps read as a pass. With no origin/main, one unknown
# line names each pull-request step it skips, and each such lint step (its if: reads true on a pull-request run) prints
# unknown, not skipped. A lint CI step whose if: reads false on a pull-request run (it runs only off one) prints
# skipped and does not fail. A --lint run in which no lint CI step and no picked suite CI step ran prints one unknown line and exits 2, never 0. A lane runs `merge --lane-lint <pr>`, which runs this mode, before it
# joins a batch. Use it with a job such as checks.
# Workflow: the one file in .github/workflows/ at the git top level of the current folder that holds the job
# (checks.yml, check.yml, any name), unless --workflow names one. No file, or more than one, is unknown.
# Each step runs at that top level (or its working-directory) as GitHub's Linux runner runs it: no shell
# key is `bash -e`, `shell: bash` is `bash --noprofile --norc -eo pipefail`, `shell: pwsh` is pwsh.
# GH_TOKEN and GITHUB_TOKEN are unset unless the step's env: sets them, as on the runner (a session token would
# turn zizmor's offline audits online). Multi-line `run: |` steps run whole. Verdicts: PASS, SKIP (the step ran and skipped tests, exit 0), FAIL, unknown (tool missing, or an expression it
# cannot read), not run locally (a `uses:` action), skipped (a pull-request step with no base). Under --lint, a step
# it leaves out prints `not run`, which is no verdict.
# A step's `if:` reads a needs.scope.outputs flag (== 'true' or != 'false') as true, except under --lint with a base: there the repo's
# .github/scripts/ci-scope.sh runs as CI's scope job runs it (EVENT=pull_request, BASE_SHA the base, PR_HEAD the head, no GREEN_HEAD), and
# a step whose flag reads false prints skipped, as CI skips it. A script that is missing or fails, or a flag it omits, leaves the step to
# run and prints one `UNKNOWN scope` line (no exit change). Cost: one bash process and one temp file per --lint run with a base, 60 s at most.
# !cancelled(), always() and success() read as true,
# and github.event_name == 'pull_request' as true only with a base. ${{ github.base_ref }} is --base without
# its remote; ${{ github.event.pull_request.head.sha }} is CI_JOB_HEAD_SHA when it is set and not blank (the lane lint sets it to the
# pushed head, since its HEAD is a merge commit), else HEAD; ${{ github.event.pull_request.base.sha }} is the commit of --base. No step's env gets
# CI_JOB_HEAD_SHA. Any other expression makes the step unknown.
# Each step's env sets GITHUB_BASE_REF to that value (the step's own env: wins), as GitHub does on a pull-request run; with no --base it is unset, as off one.
# A tool is missing when a line's command is not on PATH, or the step exits 127.
# --step NAME (repeatable) runs only the steps with those names, of any kind, each as a plain run (never with --lint, which
# picks steps by kind: that pair is a usage error, exit 2). Every other step is left out and prints nothing. A name no step
# of the job has prints one `unknown` line, and when any name is missing no step runs: exit 2. A named step that does not
# run (an action, a false if:) is also one `unknown` line, never a pass. The merge's ready checks run its declared
# merge.readyChecks this way. Exit codes as below.
# --pinned is for merge's ready check: a step whose uses: is a remote `<owner>/claude-settings/actions/<code-check|zizmor>
# @<40-hex sha>` runs that harness from a tree exported at the sha, so the child is judged by the code it pins, not the local
# copy. The tree is `git archive <sha>` of the whole repo, from the clone beside this file, else the pointer checkout
# (hooks/guard_pointer.pointer_checkout); never a worktree on it. A sha the clone lacks is fetched once (`git fetch origin <sha>`,
# with GIT_TERMINAL_PROMPT=0; it writes objects and FETCH_HEAD into that clone); a failed fetch, or a tree without the harness file, makes the step unknown (exit 2), never a pass. The ste-lint step
# stays local under --pinned: the exported tree has no .git, so its bin/ste-changed could not see drift, and a stale ste-lint pin
# must keep exiting 3 with its remedy. A non-sha ref (@main) and a local uses: keep
# the local copy under --pinned, as does a run without it; --lint ignores --pinned. Cost: at most one fetch and one archive per
# distinct sha per run, into a fresh temp dir that is deleted when the run ends. The pin's sha pattern: hooks/action_pin.py.
# Symlink members are not extracted: the harness reads none, and a host that refuses os.symlink would fail the export.
# Limits: the uses: owner is not checked, since the fetch reads the clone's origin. An uppercase or quoted 40-hex pin does
# not match the sha pattern, so it runs the local copy. A SIGKILL from merge's timeout skips the cleanup and leaves the
# export in TMPDIR: one export per run, about 24 MB at worst.
# --plan prints each step's verdict-to-be and runs nothing. Output of each run: $VERDICT_LOG, else one new
# temp log per call, named on the last line. A run that makes its own log first removes ci-job-*.log files over 1 day old from the temp folder (one scandir). Exit: 1 if a step fails, else 2 if one is unknown, else 0.
# CI checks out with fetch-depth: 0. When the job's checkout step says so and the clone is shallow, ci-job first
# runs `git fetch --unshallow` once (--plan only says so); a failed fetch is one unknown line. Cost: one git fetch,
# only when shallow.
# A step's stdout is its one verdict line. verdict's "still running" heartbeat (every $VERDICT_HEARTBEAT s) goes to
# stderr as it arrives, so a quiet step still feeds the stall watch (decision stall-watch: a quiet tool prints a
# line at least every 120 s).
# Under --lint, the ste-lint action step runs bin/ste-changed with STE_CHANGED_PIN_NOTE=1: a stale pin of this repo's ste-lint or
# zizmor action never fails a passing lint, and its PASS line ends `; <the whole drift line>`, which starts with the marker
# `ste-changed: pin note: ` (hooks/pin_note.py). A --step run (merge's ready checks) never gets the variable: a drifted pin
# exits 3 and the step reads FAIL. No other step gets it either, even when the caller exports it. A failing lint is FAIL.
# Under --lint, lint CI steps run at once, up to N workers: CI_JOB_LINT_WORKERS when it is a positive integer, else min(CPU count, 4),
# at least 1 (a lane runs only the checks its change needs, decision lanes-run-no-full-ci-job; one CI step at a time, the lint run outlasted
# merge's 1200 s bound). N=1 is the serial run. An install CI step is
# a barrier: it runs alone, after every earlier CI step has finished, and before any later one starts. Each parallel CI step logs to a file of its
# own, so the reads from its start offset see only its output; each log is appended to $VERDICT_LOG in CI step order, and each verdict line
# prints in CI step order, whatever order the CI steps finish. A `start:` or heartbeat line is written whole, so two never mix. A plain run,
# --step and --plan stay serial.
# Cost: one process per CI step (bin/verdict and the CI step's shell), one log file; no timer, no lasting process. Under
# --lint each install CI step adds its processes, plus network and disk only when a job has one; a pip install writes to the active Python.
# With N above 1, --lint adds one thread per worker, one temp folder, and one log file per lint CI step run, all deleted when ci-job ends, except a log whose copy into $VERDICT_LOG failed (then the folder stays)
# (a SIGKILL from merge's timeout reaches only ci-job: it leaves the folder in TMPDIR and may leave verdict children running). Each `not run` line,
# the summary and each CI step's `start: <name>` line on stderr (before it runs, so a caller sees which CI step is running)
# are one print.
# Rerun cache: a step that passed is saved under its name, its script, the whole environment it runs with (VOLATILE_ENV aside), shell, directory, base
# commit, the pushed head (CI_JOB_HEAD_SHA, else HEAD) and HEAD's parents and message (an amend with a new message misses; a new lane lint merge of one pushed head hits; the checkout's path is not keyed, so the same commit in another worktree hits), a hash
# of the tree it tests as it stands when the step starts (the committed files plus uncommitted and untracked ones, minus ignored ones, so a step that
# follows a writing step keys on what that step wrote) and a hash of the bin/, hooks/ and lint/ trees of this install plus, in this install and the
# pointer checkout, the actions/ tree and the files bin/ste-changed names in LINT_FILES (never __pycache__ or .pyc). A rerun at the same key runs no
# such step and prints `PASS (cached)` for it. Never saved: an install step, or a step
# that failed, read unknown or skipped. A saved file that cannot be read is a miss. A pass ages from its save time: a hit does not refresh it, and
# it misses 7 days after the save. Cost: per step that may be cached, one set of git processes (a temp index, add, write-tree, rev-parse); per run, one
# read of those trees; per pass, one file of under 1 KB in $XDG_CACHE_HOME (else ~/.cache) /claude-settings/ci-job-pass. A save prunes files saved
# over 7 days ago, and the store holds at most 300 files. No timer, no lasting process. CI_JOB_NO_CACHE=1 turns the cache off.
import ast, concurrent.futures, hashlib, json, os, re, shutil, subprocess, sys, tempfile, threading, time
BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "hooks"))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "lint"))
import _nowindow  # noqa: E402  the one home of a no-window child start (hooks/_nowindow.py)
from tree_export import export_tree  # noqa: E402  the one home of the export of a commit's tree (hooks/tree_export.py)
from git_bash import find_git_bash  # noqa: E402  the one home of the Git Bash lookup (never the WSL launcher)
from pin_note import ENV as PIN_NOTE_ENV, MARKER as PIN_NOTE_MARKER  # noqa: E402  the one home of the pin note's names (hooks/pin_note.py)
from action_pin import pin_regex  # noqa: E402  the one home of the sha pin's pattern (hooks/action_pin.py)
from workflow_steps import job_block, job_workflow, run_body, step_blocks, step_env, step_key, step_with  # noqa: E402  the one home of the step parser

SELECTOR_LIMIT = 60  # seconds the --lint-suites selector may run (about 10 s on this repo's 123 suites) before it reads unknown
PREAMBLE_MARK = "ci-job-preamble-done"
PREAMBLE_DONE = "echo; echo " + PREAMBLE_MARK  # the line preamble_marked adds right before a CI step's first suite line; the bare echo ends a preamble line that has no newline, so the mark lands at line start
SUITE_LINE = re.compile(r"python3 ((?:hooks|merge)/test_[\w.-]+\.py)(?: [^|&;`<>]*)?")  # a CI step's suite line, arguments allowed
USAGE = "usage: ci-job <job> [--workflow <file>] [--base <ref>] [--plan] [--lint] [--pinned] [--step NAME]..."
EXPR = re.compile(r"\$\{\{\s*(.*?)\s*\}\}")
BUILTINS = {"cd", "echo", "printf", "test", "[", "[[", "export", "set", "exit", "if", "then", "else", "elif", "fi",
            "for", "do", "done", "while", "until", "case", "esac", "true", "false", ":", "read", "local", "return",
            "shift", "eval", "source", ".", "trap", "unset", "wait", "{", "}", "(", ")", "!", "time", "exec", "command"}
KEYWORDS = {"if", "elif", "while", "until", "do", "then", "else", "!", "time"}  # a word a command may follow
RUNNERS = {"xargs", "env", "nice", "nohup"}  # a command whose first operand is the tool it runs
SHELLS = {None: ["bash", "-e"], "bash": ["bash", "--noprofile", "--norc", "-eo", "pipefail"], "sh": ["sh", "-e"],
          "python": ["python3"], "pwsh": ["pwsh", "-NoProfile", "-NonInteractive", "-File"]}


def shell_argv(shell, nt=None, environ=None):
    """The argv that runs a step's script under `shell`, or None when its shell is missing. On Windows, bash and sh
    are Git Bash's by full path: PATH's first bash there is the System32 WSL launcher, which runs the script in Linux."""
    argv = list(SHELLS[shell])
    if argv[0] not in ("bash", "sh"):
        return argv
    nt = os.name == "nt" if nt is None else nt
    if not nt:
        found = shutil.which(argv[0], path=(environ or os.environ).get("PATH"))
        return [found] + argv[1:] if found else None
    bash = find_git_bash(nt=True, environ=environ)
    if not bash:
        return None
    exe = bash if argv[0] == "bash" else os.path.join(os.path.dirname(bash), "sh.exe")
    return [exe] + argv[1:] if os.path.isfile(exe) else None


def slashed(path):
    """A path as a bash script names it: Git Bash reads `C:/x/y` as a path and `C:\\x\\y` as a command name."""
    return path.replace("\\", "/")


def no_shell(name, nt=None):
    """The detail of a step whose shell is missing."""
    if os.name == "nt" if nt is None else nt:
        return "tool missing: Git Bash (on Windows this runner never uses the WSL launcher System32\\bash.exe)"
    return "tool missing: %s" % name


def git(*args, cwd=None):
    done = _nowindow.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else None


def unshallow(block, top, dry, tally):
    """Fetch full history when CI's checkout does (fetch-depth: 0) and this clone is shallow. A failed fetch is unknown."""
    full = any((step_key(st, "uses") or "").startswith("actions/checkout") and
               re.search(r"^          fetch-depth:[ \t]*0[ \t]*$", st, re.M) for st in step_blocks(block))
    if not full or git("rev-parse", "--is-shallow-repository", cwd=top) != "true":
        return
    if dry:
        print("%-15s the clone is shallow and CI checks out full history: git fetch --unshallow" % "would fetch")
        return
    remotes = (git("remote", cwd=top) or "").split()
    done = _nowindow.run(["git", "fetch", "--unshallow", *(["origin"] if "origin" in remotes else remotes[:1])],
                         cwd=top, capture_output=True, text=True)
    if done.returncode == 0:
        print("%-15s the clone was shallow and CI checks out full history: ran git fetch --unshallow" % "fetched")
    else:
        tally["unknown"] += 1
        print("unknown         the clone is shallow and git fetch --unshallow failed: %s" %
              ((done.stderr.strip().splitlines() or ["no message"])[-1]))


SCOPE_TERM = re.compile(r"needs\.scope\.outputs\.([\w-]+)\s*(==\s*'true'|!=\s*'false')")  # the two forms that read a flag as on; any other form stays unreadable
SCOPE_SCRIPT = ".github/scripts/ci-scope.sh"  # the one home of the scope flags: CI's scope job runs it too
SCOPE = {"flags": None, "why": None, "unknown": set()}  # flags: {name: "true"|"false"} from the script; None with a base: it did not run, why says so; unknown: the flags read as true


def scope_term(m):
    """T or F for one `needs.scope.outputs.X == 'true'` or `!= 'false'` term. Without flags, or for a flag the script did not give,
    it reads T (the step runs); the second case is listed in SCOPE["unknown"], which main() reports as UNKNOWN scope."""
    flags = SCOPE["flags"]
    if flags is None:
        if SCOPE["why"]:
            SCOPE["unknown"].add(m.group(1))
        return " T "
    value = flags.get(m.group(1))
    if value not in ("true", "false"):
        SCOPE["unknown"].add(m.group(1))
        return " T "
    return " T " if value == "true" else " F "


def scope_flags(top, base_sha, head_ref, head_sha):
    """(flags, why): the name=value lines the repo's ci-scope.sh writes for this diff, run as CI's scope job runs it on a pull
    request. (None, why) when the script is missing or fails: no flag is known, and each scope-gated step runs."""
    script = os.path.join(top, *SCOPE_SCRIPT.split("/"))
    if not os.path.isfile(script):
        return None, "no %s" % SCOPE_SCRIPT
    argv = shell_argv("bash")
    if not argv:
        return None, no_shell("bash")
    if not base_sha:
        return None, "the base does not resolve to a commit"
    fd, out = tempfile.mkstemp(prefix="ci-job-scope-", suffix=".out")
    os.close(fd)
    env = {k: v for k, v in os.environ.items() if k not in ("EVENT", "BASE_SHA", "HEAD_REF", "GREEN_HEAD", "PR_HEAD", "GITHUB_OUTPUT")}
    env.update(EVENT="pull_request", BASE_SHA=base_sha, HEAD_REF=head_ref, PR_HEAD=head_sha, GITHUB_OUTPUT=out)  # no GREEN_HEAD: unknown never skips
    try:
        done = _nowindow.run(argv + [slashed(script)], cwd=top, env=env, capture_output=True, text=True, encoding="utf-8",
                             stdin=subprocess.DEVNULL, timeout=SELECTOR_LIMIT)
        if done.returncode != 0:
            return None, ((done.stderr + done.stdout).strip().splitlines() or ["exit %d with no message" % done.returncode])[-1]
        with open(out, encoding="utf-8") as f:
            return dict(ln.strip().split("=", 1) for ln in f if "=" in ln), None
    except subprocess.TimeoutExpired:
        return None, "the script ran past %d s and was stopped" % SELECTOR_LIMIT
    except (OSError, ValueError) as e:
        return None, str(e)
    finally:
        try:
            os.remove(out)
        except OSError:
            pass


def condition(text, pr):
    """True, False, or None when the expression holds a term this runner cannot read."""
    if not text:
        return True
    m = EXPR.fullmatch(text.strip())
    expr = m.group(1) if m else text.strip()
    expr = SCOPE_TERM.sub(scope_term, expr)
    expr = re.sub(r"github\.event_name\s*==\s*'pull_request'", " T " if pr else " F ", expr)
    expr = re.sub(r"github\.event_name\s*!=\s*'pull_request'", " F " if pr else " T ", expr)
    expr = re.sub(r"github\.event\.pull_request\.draft", " F ", expr)  # a lint run reads a ready pull request
    expr = re.sub(r"\b(?:cancelled|always|success|failure)\(\)", lambda x:" F " if x.group(0) in ("cancelled()", "failure()") else " T ", expr)
    expr = expr.replace("&&", " and ").replace("||", " or ").replace("!", " not ")
    if not re.fullmatch(r"[\sTF()]*(?:(?:and|or|not)[\sTF()]*)*", expr):
        return None
    return bool(eval(expr.replace("T", "True").replace("F", "False"), {"__builtins__": {}}))  # only T, F, and, or, not, ()


def expand(value, values):
    """value with each known ${{ }} replaced, or None when one is unknown."""
    missing = [m.group(1) for m in EXPR.finditer(value) if m.group(1) not in values]
    return None if missing else EXPR.sub(lambda m: values[m.group(1)], value)


def commands(script):
    """The command word of each simple command in a shell script, for the tool-missing check."""
    words, until = [], None
    for line in script.splitlines():
        if until is not None:  # a heredoc body is data, not commands
            until = None if line.strip() == until else until
            continue
        line = line.split(" #")[0].strip()
        if not line or line.startswith("#"):
            continue
        bare = re.sub(r"\$\(\(.*?\)\)|\"[^\"]*\"", "", line)  # arithmetic and double-quoted text hold no heredoc
        doc = re.search(r"(?<!<)<<(?!<)-?\s*['\"]?([A-Za-z_]\w*)['\"]?", bare)
        if doc:
            until = doc.group(1)
        for part in re.split(r"\|\||&&|[|;]", line):
            tokens = [t for t in part.split() if not re.fullmatch(r"[A-Za-z_]\w*=\S*", t)]
            while tokens and tokens[0] in KEYWORDS:  # if nosuchtool ...: the tool is nosuchtool
                tokens.pop(0)
            while len(tokens) > 1 and tokens[0] in RUNNERS:  # xargs -0 pipx ...: the tool is pipx
                words.append(tokens.pop(0))
                while len(tokens) > 1 and tokens[0].startswith("-"):
                    tokens.pop(0)
            if tokens and re.fullmatch(r"[\w./+-]+", tokens[0]) and tokens[0] not in BUILTINS and "/" not in tokens[0]:
                words.append(tokens[0])
    return words


def missing_in_log(log, start, script):
    """Each command the step's shell reported as not found, from this run's part of the log. A 127 that
    an `if`, a `!` or `|| true` swallowed still lands there, so the step is unknown, not PASS."""
    text = log_text(log, start)
    lead = re.escape(script)
    found = re.findall(r"^%s: (?:line \d+: )?(\S+): command not found$" % lead, text, re.M)
    found += re.findall(r"^%s: \d+: (\S+): not found$" % lead, text, re.M)
    return sorted(set(found))


LINT_CMD = re.compile(r"(?:python3 (?:lint|actions)/[\w./-]+\.py|bin/ste-changed|pipx run [\w.-]+==[\w.]+)"
                      r"(?: [^|&;`<>]*)?")
INSTALL_CMD = re.compile(r"(?:npm ci|(?:pnpm|yarn) install --(?:frozen-lockfile|immutable)|(?:python3 -m )?pip install(?: -[-\w]+)* -r [^\s|&;`<>$()]+"
                         r"|npx(?: --no-install)? [\w@./-]+ (?:sync|generate))(?: [^|&;`<>$()]*)?")
RUNNER_UNSET = {"GH_TOKEN", "GITHUB_TOKEN", "ZIZMOR_PATHS"}  # absent from a runner step's env unless its env: or the zizmor with: sets them
# The pushed head, when HEAD is not it: merge.py's lane lint runs this in a merge commit of the base and the head. Kept from each step's env,
# so a step that runs ci-job on its own fixture repo reads that repo's HEAD.
HEAD_SHA_ENV = "CI_JOB_HEAD_SHA"
KNOWN_ACTION = re.compile(r"(?:\S*/)?actions/(ste-lint|code-check|zizmor)(?:@\S*)?")
SHA_PIN = pin_regex(("code-check", "zizmor"))  # a uses: pinned to a commit of this repo's action
LOCAL_ACTION = re.compile(r"[$.]/actions/\S+")  # this repo's own action: a check --lint should run
CODE_CHECK = os.path.join("actions", "code-check", "code_check.py")  # under a checkout of this repo
ZIZMOR_RUN = os.path.join("actions", "zizmor", "run.sh")  # the one home of the pinned zizmor run
PIN_NOTE = re.compile(r"^%s.+$" % re.escape(PIN_NOTE_MARKER), re.M)  # a whole drift line of bin/ste-changed, marker first


def action_file(top, step, rel):
    """(path, None) to the file `rel` of the action the step's uses: names; (None, looked-at) when a remote uses:
    finds none. A local uses: is always the repo under test's own file, even when missing, so the step fails here as
    in CI. A remote uses: is the copy beside this file, else the one in the pointer checkout."""
    if LOCAL_ACTION.fullmatch(uses(step)):
        return os.path.join(top, rel), None
    roots = [os.path.dirname(BIN)]
    try:
        from guard_pointer import pointer_checkout  # the one Python reader of the global rules file's @-line
        roots.append(pointer_checkout())
    except ImportError:
        pass
    paths = [os.path.join(root, rel) for root in roots if root]
    found = next((p for p in paths if os.path.isfile(p)), None)
    return found, None if found else " or ".join(paths)


PIN_TREES = {}  # {sha: (exported tree or None, why none)}: one fetch and one archive per sha per run


def pin_source():
    """The clone to export from: the one beside this file, else the pointer checkout; None when neither is a clone."""
    roots = [os.path.dirname(BIN)]
    try:
        from guard_pointer import pointer_checkout  # the one Python reader of the global rules file's @-line
        roots.append(pointer_checkout())
    except ImportError:
        pass
    return next((r for r in roots if r and os.path.exists(os.path.join(r, ".git"))), None)


def pin_tree(sha):
    """(tree, None): a fresh temp dir holding `git archive <sha>` of the whole repo; (None, why) when it cannot be made."""
    if sha in PIN_TREES:
        return PIN_TREES[sha]
    src = pin_source()
    if not src:
        PIN_TREES[sha] = (None, "no claude-settings clone beside ci-job or at the pointer checkout")
    elif git("cat-file", "-e", sha + "^{commit}", cwd=src) is None and _nowindow.run(
            ["git", "fetch", "-q", "origin", sha], cwd=src, capture_output=True, text=True,
            env=dict(os.environ, GIT_TERMINAL_PROMPT="0")).returncode != 0:  # a credential prompt must fail, not hang the run
        PIN_TREES[sha] = (None, "commit %s is not in %s and could not be fetched" % (sha[:7], src))
    else:
        tree = tempfile.mkdtemp(prefix="ci-job-pin-%d-%s-" % (os.getpid(), sha[:7]))  # the pid lets merge.py's sweep remove it after a run that died
        PIN_TREES[sha] = (tree, None)  # recorded first, so the run's end deletes it even if the archive fails
        error = export_tree(src, sha, tree)
        if error:
            PIN_TREES[sha] = (tree, "git archive of %s in %s failed (%s)" % (sha[:7], src, error))
    return PIN_TREES[sha]


def drop_pin_trees():
    """Delete every exported tree, each by its absolute path."""
    for tree, _ in PIN_TREES.values():
        if tree:
            shutil.rmtree(os.path.abspath(tree), ignore_errors=True)
    PIN_TREES.clear()


def pinned_file(step, rel):
    """For a step whose uses: pins a sha: (path of `rel` in the tree at the pin, None), or (None, why the step is unknown).
    (False, None) when the step is not pinned to a sha: the caller keeps the local copy."""
    m = SHA_PIN.fullmatch(uses(step))
    if not m:
        return False, None
    sha = m.group(2)
    tree, why = pin_tree(sha)
    lead = "pin %s of %s: " % (sha[:7], m.group(1))
    move = "; move the pin in a lane of its own"
    if why:
        return None, lead + why + move
    path = os.path.join(tree, rel)
    if not os.path.isfile(path):
        return None, lead + "the tree at the pin has no %s%s" % (rel.replace("\\", "/"), move)
    return path, None


def code_check(top, step, pinned=False):
    """(path, None) of the code_check.py a step runs; (None, why or looked-at) when there is none. pinned: the pin's tree first."""
    path, why = pinned_file(step, CODE_CHECK) if pinned else (False, None)
    return (path, None) if path else (None, why) if path is None else action_file(top, step, CODE_CHECK)


def uses(step):
    return (step_key(step, "uses") or "").split(" #")[0].strip()


def known_action(step):
    """ste-lint, code-check or zizmor when the step uses one of them, else None."""
    m = KNOWN_ACTION.fullmatch(uses(step))
    return m.group(1) if m else None


def is_lint(step):
    """True when the step's whole run: is fast lint/check commands: each line one lint command, no mutation script.
    The ste-lint, code-check and zizmor actions count: plan() runs each one's own command for it."""
    if known_action(step):
        return True
    lines = run_lines(step)
    return bool(lines) and all(lint_line(ln) for ln in lines)


def lint_line(ln):
    """True when the run: line is one lint command and not a mutation script."""
    return bool(LINT_CMD.fullmatch(ln)) and "mutate" not in ln.split()[
        1 if ln.startswith("python3") else 2 if ln.startswith("pipx") else 0]


def run_lines(step):
    """The step's run: lines, with no blank line and no comment."""
    return [ln.strip() for ln in (run_body(step) or "").splitlines() if ln.strip() and not ln.strip().startswith("#")]


def is_install(step):
    """True when the step's whole run: is install commands: a lockfile install or a framework's type generation."""
    lines = run_lines(step)
    return bool(lines) and all(INSTALL_CMD.fullmatch(ln) for ln in lines)


def pin_notes(log, start):
    """The drift lines bin/ste-changed printed in this run's part of the log, each whole, marker first."""
    try:
        with open(log, "rb") as f:
            f.seek(start)
            return [n.rstrip() for n in PIN_NOTE.findall(f.read().decode("utf-8", "replace"))]
    except OSError:
        return []


def could_not_start(log, start):
    """(each 'could not start' failure, True when every failure is one, True when any ::error line printed) from
    code_check.py's ::error lines in this run's part of the log. Only the middle one makes the step unknown: a failure that
    needed no tool is still a FAIL. A ::error line of any title is a failure signal for a dead verdict; only a code-check
    title can name a missing tool."""
    try:
        with open(log, "rb") as f:
            f.seek(start)
            text = f.read().decode("utf-8", "replace")
    except OSError:
        return [], False, False
    errors = re.findall(r"^::error title=code-check::(.*)$", text, re.M)
    unstarted = sorted(set(e for e in errors if re.match(r"\S+ could not start: ", e)))
    return unstarted, bool(errors) and len(unstarted) == len(set(errors)), bool(re.search(r"^::error\b", text, re.M))


def if_held(step, pr):
    """(state, why) when the step's if: stops it: unknown for an if: this runner cannot read, skipped for one that reads false. None when it runs."""
    cond = condition(step_key(step, "if"), pr)
    if cond is None:
        return "unknown", "an if: this runner cannot read: %s" % step_key(step, "if")
    if not cond:
        if pr and SCOPE["flags"] is not None and "needs.scope.outputs." in (step_key(step, "if") or ""):
            return "skipped", "CI's scope job skips it for this diff (%s)" % SCOPE_SCRIPT
        return "skipped", "a pull-request step: pass --base to run it" if not pr else "a step that runs only off a pull request"
    return None


def plan(step, pr, values, top, lint=False, pinned=False):
    """(state, detail, argv, env, cwd): state is run, not run locally, skipped or unknown. lint: the run is --lint.
    pinned: --pinned on a run that executes, so a step pinned to a sha runs the harness of the tree at that sha."""
    if step_key(step, "continue-on-error") not in (None, "false"):
        return "unknown", "continue-on-error: this runner reads no step as allowed to fail", None, None, None
    action = known_action(step)
    if action == "zizmor":  # run.sh under the action's folder, with the step's with: paths; it needs no base
        if not shell_argv(None):
            return "unknown", no_shell("bash"), None, None, None
        if not shutil.which("pipx"):
            return "unknown", "tool missing: pipx", None, None, None
        path, looked = pinned_file(step, ZIZMOR_RUN) if pinned else (False, None)
        if path is None:
            return "unknown", looked, None, None, None
        if not path:
            path, looked = action_file(top, step, ZIZMOR_RUN)
        if not path:
            return "unknown", "no run.sh: looked for %s" % looked, None, None, None
        env = {}
        if "paths" in step_with(step):
            env["ZIZMOR_PATHS"] = expand(step_with(step)["paths"].strip("'\""), values)
            if env["ZIZMOR_PATHS"] is None:
                return "unknown", "with: paths needs an expression this runner cannot read: %s" % step_with(step)["paths"], None, None, None
        # A missing run.sh of a local uses: must FAIL, as in CI; bash alone would exit 127 and read as a missing tool.
        path = slashed(path)  # $BASH: the bash running this script, never a PATH lookup that may find the WSL launcher
        return "run", 'test -f "%s" || { echo "no run.sh at %s" >&2; exit 1; }\n"$BASH" "%s"\n' % (path, path, path), shell_argv(None), env, None
    if action:
        if not pr:
            return "skipped", "a pull-request step: pass --base to run it", None, None, None
        if not shell_argv(None):
            return "unknown", no_shell("bash"), None, None, None
        if not shutil.which("python3"):
            return "unknown", "tool missing: python3", None, None, None
        if action == "code-check":  # the action.yml's own command
            path, looked = code_check(top, step, pinned)
            if not path:
                return "unknown", looked if pinned and SHA_PIN.fullmatch(uses(step)) else "no code_check.py: looked for %s" % looked, None, None, None
            return "run", 'python3 "%s" --base "%s"' % (slashed(path), values["base"]), shell_argv(None), {}, None
        # Always the local bin/ste-changed, even under --pinned: only a checkout with .git can see pin drift. A --lint run passes with a
        # stale pin and says so (decision action-pins-follow-sessions); a --step or plain run still exits 3.
        return "run", '"%s" "%s"' % (slashed(os.path.join(BIN, "ste-changed")), values["base"]), shell_argv(None), {PIN_NOTE_ENV: "1"} if lint else {}, None
    if step_key(step, "uses") is not None:
        return "not run locally", "an action (uses: %s); CI runs it" % step_key(step, "uses").split(" #")[0], None, None, None
    held = if_held(step, pr)
    if held:
        return held[0], held[1], None, None, None
    body = run_body(step)
    if body is None:
        return "unknown", "no run: and no uses:", None, None, None
    env = {}
    for name, raw in step_env(step).items():
        val = expand(raw.strip("'\""), values)
        if val is None:
            return "unknown", "env %s needs an expression this runner cannot read: %s" % (name, raw), None, None, None
        env[name] = val
    if EXPR.search(body):
        return "unknown", "run: holds an expression this runner cannot read", None, None, None
    shell = step_key(step, "shell")
    if shell not in SHELLS:
        return "unknown", "shell %s is not one this runner knows" % shell, None, None, None
    argv = shell_argv(shell)
    if argv is None:
        return "unknown", no_shell(SHELLS[shell][0]), None, None, None
    # A CI step with a suite scans only its suite lines: a preamble tool in a block the shell skips must not refuse it,
    # and one the shell reaches and cannot find still reads unknown, from missing_in_log.
    scanned = "\n".join(ln for ln in run_lines(step) if SUITE_LINE.fullmatch(ln)) if suite_paths(step) else body
    need = [argv[0]] + (commands(scanned) if shell in (None, "bash", "sh") else [])
    gone = sorted({w for w in need if not shutil.which(w)})
    if gone:
        return "unknown", "tool missing: %s" % ", ".join(gone), None, None, None
    return "run", body, argv, env, step_key(step, "working-directory")


ACTION_FOLDER = re.compile(r"[$.]/(actions/[\w-]+)")  # a local uses: this runner can read: one folder directly under actions/
ACTION_PATH = re.compile(r'"\$\{\{\s*github\.action_path\s*\}\}([^"\s$`]*)"|\$\{\{\s*github\.action_path\s*\}\}')  # the quoted token, rest of path in group 1, or the bare one


def action_steps(top, step):
    """([(name, step text)], None): the steps of a local uses: action, each laid out and expanded as a workflow step.
    (None, why) when it refuses the action. It reads every step before any runs, so a refused action runs nothing."""
    ref = uses(step)
    m = ACTION_FOLDER.fullmatch(ref)
    if not m:
        return None, "uses: %s is not a folder directly under actions/, which this runner cannot read" % ref
    folder = m.group(1)
    rel = folder + "/action.yml"
    try:
        with open(os.path.join(top, rel), encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, UnicodeError) as e:
        return None, "cannot read %s in the tree under test: %s" % (rel, getattr(e, "strerror", None) or e)
    # A comment above step depth (under three spaces) would end the steps list below: drop it. A deeper one is a step's own
    # text, or sits above the first `    - `: the layout check below skips it, and step_blocks drops what comes before a step.
    lines = [ln for ln in lines if not (ln.strip().startswith("#") and len(ln) - len(ln.lstrip()) < 3)]
    runs = next((i for i, ln in enumerate(lines) if re.fullmatch(r"runs:\s*", ln)), None)
    body = []
    for ln in lines[runs + 1:] if runs is not None else []:
        if ln.strip() and not ln.startswith(" "):
            break
        body.append(ln)
    using = next((m.group(1) for m in (re.fullmatch(r"  using:\s*(\S+)\s*", ln) for ln in body) if m), None)
    if using != "composite":
        return None, "%s has runs.using: %s, and only composite runs here" % (rel, using)
    header = next((i for i, ln in enumerate(body) if re.fullmatch(r"  steps:\s*", ln)), None)
    raw = []
    for ln in body[header + 1:] if header is not None else []:
        if ln.strip() and not ln.startswith("   "):
            break
        raw.append(ln)
    first = next((ln for ln in raw if ln.strip() and not ln.lstrip().startswith("#")), "")
    if not first:
        return None, "%s has no steps, so a pass would prove nothing" % rel
    if not first.startswith("    - "):
        return None, "%s lays its steps out other than `    - ` under runs: steps:, which this runner cannot read" % rel
    # Two more spaces give the layout step_blocks and step_key read: steps at six spaces, keys at eight.
    out = []
    for n, st in enumerate(step_blocks("".join(("  " + ln if ln.strip() else ln) + "\n" for ln in raw)), 1):
        name = step_key(st, "name") or "step %d" % n
        why = None
        if step_key(st, "uses") is not None:
            why = "uses %s, and --lint runs no action inside an action" % step_key(st, "uses").split(" #")[0]
        elif step_key(st, "working-directory") is not None:
            why = "sets working-directory, which the relative action path does not survive"
        elif step_key(st, "shell") != "bash":
            why = "has shell: %s, and only bash runs here" % step_key(st, "shell")
        elif run_body(st) is None:
            why = "has no run:"
        if why:
            return None, "%s: step %r %s" % (rel, name, why)
        st = ACTION_PATH.sub(lambda x: folder + (x.group(1) or ""), st)
        left = EXPR.search(run_body(st))
        if left:
            return None, "%s: step %r: run: holds an expression this runner cannot read: %s" % (rel, name, left.group(0))
        bad = next((ln for ln in run_lines(st) if not lint_line(ln)), None)
        if bad is not None or not run_lines(st):
            return None, "%s: step %r: %s is not a lint command" % (rel, name, "`%s`" % bad if bad is not None else "an empty run:")
        out.append((name, st))
    return out, None


def local_ready(step, top, base):
    """(steps, None) when a local uses: action will start; (None, (state, why)) when its uses: step or the read of its
    action.yml before any step runs stops it. The one home of that read: an install before the action runs only when it passes."""
    # The uses: step's own continue-on-error: and if: read as plan() reads a run: step's.
    if step_key(step, "continue-on-error") not in (None, "false"):
        return None, ("unknown", "continue-on-error: this runner reads no step as allowed to fail")
    held = if_held(step, bool(base))
    if held and held[0] == "skipped" and not base and condition(step_key(step, "if"), True) is not False:
        held = "unknown", "a pull-request step, skipped for want of a base (pass --base)"
    if held:
        return None, held
    env = step_env(step)
    if env:
        return None, ("unknown", "env %s: CI hands a uses: step's env to the action's steps, and this runner does not"
                      % ", ".join(sorted(env)))
    steps, why = action_steps(top, step)
    return (steps, None) if steps is not None else (None, ("unknown", why))


def local_action(name, step, ctx, log, dry, ready):
    """(state, the action's one line, True when a step ran or would run). ready: local_ready()'s result for the step.
    state: FAIL, unknown, PASS, skipped, or would run (--plan). FAIL beats unknown, and the first FAIL ends the action, as in CI."""
    top, base, values, _ = ctx
    steps, held = ready
    if held:
        return held[0], held[1], False
    parts, states, started = [], [], False
    for sname, st in steps:
        state, detail, shell, env, cwd = plan(st, bool(base), values, top, True)
        if state == "skipped" and not base and condition(step_key(st, "if"), True) is not False:
            state, detail = "unknown", "a pull-request step, skipped for want of a base (pass --base)"
        if state == "run":
            started = True
            if dry:
                state = "would run"
            else:
                state, detail = run_step(sname, st, False, detail, shell, {**env, "GITHUB_WORKSPACE": top}, cwd, ctx, log)
                cached = detail.startswith(CACHE_MARK)  # still counts as started; its part of the line says so
                detail = detail[len(CACHE_MARK):] if cached else detail
                # verdict names a run's shell and its temp script, which differ on every run: name the step's own lines instead
                detail = re.sub(r"^(PASS|SKIP|FAIL) .*? (?=(?:rc=\d+ )?\(\d+\.\d+s\))",
                                lambda m: "%s %s " % (m.group(1), " ; ".join(run_lines(st))), detail, count=1)
                parts.append("%s: %s%s" % (sname, "(cached) " if cached else "", detail))
        else:
            parts.append("%s: %s: %s" % (sname, state, detail))
        states.append(state)
        if state == "FAIL":
            break
    final = ("FAIL" if "FAIL" in states else "unknown" if "unknown" in states else
             ("would run" if dry else "PASS") if started else "skipped")
    return final, "; ".join(parts), started


ERR_LOCK = threading.Lock()  # a parallel run writes stderr from several threads: one whole line at a time


def err_line(text):
    """One whole line to stderr, flushed at once: the stall watch reads it, and a caller sees which step is running."""
    with ERR_LOCK:
        try:
            sys.stderr.write(text)
            sys.stderr.flush()
        except OSError:
            pass  # reader gone: the step's verdict still prints


def lint_workers():
    """How many --lint steps run at once: CI_JOB_LINT_WORKERS when it is a positive integer, else the CPU count capped at 4, at least 1."""
    raw = os.environ.get("CI_JOB_LINT_WORKERS", "").strip()
    if raw.isascii() and raw.isdigit() and int(raw) > 0:
        return int(raw)
    return max(1, min(os.cpu_count() or 1, 4))


CACHE_MARK = "(cached) "  # the start of a cached step's line: its caller prints PASS (cached) and drops the mark
CACHE_FILES, CACHE_DAYS = 300, 7
VOLATILE_ENV = {"GITHUB_WORKSPACE", "VERDICT_LOG", "CI_JOB_LINT_WORKERS", "CI_JOB_NO_CACHE", "PWD", "OLDPWD", "SHLVL", "_", "COLUMNS", "LINES",
               "CLAUDE_CODE_SESSION_ID", "CLAUDE_PID", "TRACEPARENT", "CCR_SPAWN_TIMESTAMP_MS"}  # a variable that differs between runs and changes no step's result; GITHUB_WORKSPACE repeats the repo path, which the key holds once
TOOL_TREES = ("bin", "hooks", "lint")  # the folders of this install that a step may run or import
TOOL_KEYS, TOOL_LOCK = {}, threading.Lock()  # the install's hash, read once per run: no step of a run changes the tool


def cache_folder():
    base = os.environ.get("XDG_CACHE_HOME") or (os.environ.get("LOCALAPPDATA") if os.name == "nt" else None) \
        or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "claude-settings", "ci-job-pass")


def tree_key(top):
    """A hash of the tree under `top`: the committed files, plus every uncommitted and untracked file that .gitignore does not hide.
    The temp index is a copy of the real one, so the real index is never written. None when git cannot read the tree: nothing is cached.
    Read at each step's start, since an earlier step may have written into the tree."""
    tmp = tempfile.mkdtemp(prefix="ci-job-index-")
    try:
        real = git("rev-parse", "--path-format=absolute", "--git-path", "index", cwd=top)
        index = os.path.join(tmp, "index")
        if real and os.path.isfile(real):
            shutil.copyfile(real, index)
        kw = dict(cwd=top, capture_output=True, text=True, env={**os.environ, "GIT_INDEX_FILE": index},
                  timeout=120, stdin=subprocess.DEVNULL)
        if _nowindow.run(["git", "add", "-A"], **kw).returncode == 0:
            done = _nowindow.run(["git", "write-tree"], **kw)
            if done.returncode == 0 and re.fullmatch(r"[0-9a-f]{40,64}", done.stdout.strip()):
                return done.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return None


def lint_files():
    """The files bin/ste-changed names in its LINT_FILES (the files the ste-lint CI step runs), read from its source, never copied here.
    () when that source cannot be read or holds no such tuple: those files are then not keyed, and bin/ itself still is."""
    try:
        with open(os.path.join(BIN, "ste-changed"), encoding="utf-8") as f:
            tree = ast.parse(f.read())
        for node in tree.body:
            if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "LINT_FILES" for t in node.targets):
                return tuple(v for v in ast.literal_eval(node.value) if isinstance(v, str))
    except (OSError, SyntaxError, ValueError):
        pass
    return ()


def tool_roots():
    """The roots a remote uses: step or the ste-lint step runs files from: this install, then the pointer checkout when there is one."""
    roots = [os.path.dirname(BIN)]
    try:
        from guard_pointer import pointer_checkout  # the one Python reader of the global rules file's @-line
        roots.append(pointer_checkout())
    except ImportError:
        pass
    return [r for r in dict.fromkeys(os.path.realpath(r) for r in roots if r) if os.path.isdir(r)]


def tool_key():
    """A hash of every file a step may run or import, each named by its path (never __pycache__ or .pyc), or None when one cannot be read: the
    bin/, hooks/ and lint/ folders of this install, then in this install and the pointer checkout the actions/ folder (a remote uses: step
    runs its files from there) and the files bin/ste-changed names in LINT_FILES. A file that is absent is left out. Read once per run."""
    with TOOL_LOCK:
        if "key" not in TOOL_KEYS:
            digest = hashlib.sha256()
            try:
                root = os.path.dirname(BIN)

                def add(rel, base):
                    with open(os.path.join(base, rel), "rb") as f:
                        digest.update(base.encode() + b"\0" + rel.replace(os.sep, "/").encode() + b"\0" + hashlib.sha256(f.read()).digest())

                def add_tree(tree, base):
                    for dirpath, dirs, names in os.walk(os.path.join(base, tree)):
                        dirs[:] = sorted(d for d in dirs if d != "__pycache__")
                        for fname in sorted(names):
                            if not fname.endswith(".pyc"):
                                add(os.path.relpath(os.path.join(dirpath, fname), base), base)

                for tree in TOOL_TREES:
                    add_tree(tree, root)
                for base in tool_roots():
                    add_tree("actions", base)
                    for rel in lint_files():
                        if os.path.isfile(os.path.join(base, rel)):
                            add(rel, base)
                TOOL_KEYS["key"] = digest.hexdigest()
            except OSError:
                TOOL_KEYS["key"] = None
        return TOOL_KEYS["key"]


def child_env(env, base, values):
    """The whole environment a step runs with: this process's, less what a runner step lacks, then the step's own. The one home: the key reads it as the step does."""
    return {**{k: v for k, v in os.environ.items() if k not in RUNNER_UNSET | {"GITHUB_BASE_REF", PIN_NOTE_ENV, HEAD_SHA_ENV}},
            **({"GITHUB_BASE_REF": values["github.base_ref"]} if base else {}), **env}


def cache_key(name, install, detail, shell, env, cwd, ctx, suite):
    """The file name of a step's saved pass, or None when the step is never saved or its tree is unreadable."""
    top, base, values, pinned = ctx
    if install or os.environ.get("CI_JOB_NO_CACHE") or not detail:
        return None
    # The commit, as the pushed head plus HEAD's parents and message, never HEAD's own sha: the lane lint makes a new merge commit of one
    # pushed head on each run, and its sha would never repeat. A step may read the message, which an amend changes under one tree, and HEAD's committer date
    # (lint/check_hook_stubs.py ends its window there); the key holds the message and not the date, because a new lint merge of one pushed head has a new date.
    tree, tool, commit = tree_key(top), tool_key(), git("show", "-s", "--format=%P%n%B", "HEAD", cwd=top)
    head = values.get("github.event.pull_request.head.sha", "")
    if tree is None or tool is None or not commit or not head:
        return None
    parts = [name, detail, shell[0], cwd or "", str(bool(suite)), str(bool(pinned)), values.get("base", ""),
             values.get("github.event.pull_request.base.sha", ""), head, commit, tree, tool,
             *("%s=%s" % kv for kv in sorted(child_env(env, base, values).items()) if kv[0] not in VOLATILE_ENV)]
    return hashlib.sha256("\0".join(parts).encode("utf-8", "replace")).hexdigest()


def cache_load(key, name):
    """The saved one-line verdict of a passed step, or None for a missing, empty, garbled or foreign file."""
    path = os.path.join(cache_folder(), key)
    try:
        with open(path, "rb") as f:
            saved = json.loads(f.read().decode("utf-8"))
        if isinstance(saved, dict) and saved.get("key") == key and saved.get("name") == name \
                and isinstance(saved.get("first"), str) and saved["first"].startswith("PASS "):
            if time.time() - os.path.getmtime(path) > CACHE_DAYS * 86400:  # the age runs from the save: a hit never refreshes it
                return None
            return saved["first"]
    except (OSError, ValueError):
        pass
    return None


def cache_save(key, name, first):
    """Save a pass: one small file, written whole then renamed. Then prune the store. A failed write loses only the speed-up."""
    folder = cache_folder()
    try:
        os.makedirs(folder, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".new-", dir=folder)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"key": key, "name": name, "first": first}, f)
        os.replace(tmp, os.path.join(folder, key))
        with os.scandir(folder) as it:
            files = sorted(((e.stat(follow_symlinks=False).st_mtime, e.path) for e in it if e.is_file(follow_symlinks=False)), reverse=True)
        old = time.time() - CACHE_DAYS * 86400
        for i, (mtime, path) in enumerate(files):
            if i >= CACHE_FILES or mtime < old:
                try:
                    os.remove(path)
                except OSError:
                    pass
    except OSError:
        pass


def run_step(name, step, install, detail, shell, env, cwd, ctx, log, suite=False):
    """run_step_uncached behind the rerun cache: a step that passed at the same key returns (PASS, CACHE_MARK + its saved line) and runs
    nothing; any other step runs and, when it passed, is saved. A hit makes the log file, since a parallel caller appends it."""
    key = cache_key(name, install, detail, shell, env, cwd, ctx, suite)
    saved = cache_load(key, name) if key else None
    if saved:
        try:
            open(log, "ab").close()
        except OSError:
            pass
        return "PASS", CACHE_MARK + saved
    state, first = run_step_uncached(name, step, install, detail, shell, env, cwd, ctx, log, suite)
    if key and state == "PASS" and first.startswith("PASS "):
        cache_save(key, name, first)
    return state, first


def run_step_uncached(name, step, install, detail, shell, env, cwd, ctx, log, suite=False):
    """Run one step through bin/verdict, its output appended to `log`: (state, the step's one line). ctx: (top, base,
    values, pinned). A parallel step gets a log of its own, so the reads from its start offset see only its output.
    suite: a CI step picked for its suite line, run whole, with the preamble marker (preamble_marked)."""
    top, base, values, pinned = ctx
    err_line("start: %s\n" % name)
    with tempfile.NamedTemporaryFile("w", suffix=".ps1" if shell[0] == "pwsh" else ".sh", delete=False,
                                     encoding="utf-8", newline="\n") as f:
        marked = preamble_marked(detail, shell[0]) if suite else None
        f.write("$ErrorActionPreference = 'stop'\n" + detail if shell[0] == "pwsh" else marked or detail)
        script = f.name
    try:
        start = os.path.getsize(log) if os.path.exists(log) else 0
        kept = []
        with _nowindow.Popen([sys.executable, os.path.join(BIN, "verdict"), *shell, script],
                             cwd=os.path.join(top, cwd) if cwd else top, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True,
                             env={**child_env(env, base, values), "VERDICT_LOG": log}) as proc:
            for line in proc.stdout:  # relay each heartbeat at once: the stall watch reads this job's output
                if line.startswith("verdict: still running"):
                    err_line(line)
                else:
                    kept.append(line)
        rc = proc.returncode
        gone = missing_in_log(log, start, script)
        preamble_ran = not marked or bool(re.search(r"(?m)^%s\r?$" % PREAMBLE_MARK, log_text(log, start)))
        unstarted, only, errored = could_not_start(log, start)
        if known_action(step) != "code-check":
            unstarted, only = [], False
    finally:
        os.remove(script)
    line = next((ln.rstrip("\n") for ln in kept if ln.startswith(("PASS ", "SKIP ", "FAIL "))), None)
    first = line or "(verdict printed no verdict line)"
    if known_action(step) == "code-check":
        first += " (code_check.py: %s)" % code_check(top, step, pinned)[0]
    if rc == 127 or gone:
        state = "unknown"
        first = "tool missing (%s); %s" % (", ".join(gone) or "exit 127", first)
    elif unstarted and only:
        state = "unknown"
        first = "tool missing (%s); %s" % ("; ".join(unstarted), first)
    else:
        state = "FAIL" if rc else "SKIP" if first.startswith("SKIP ") else "PASS"
        if line is None:  # a verdict that died or went silent never reads PASS or a bare FAIL, whatever its exit code (a signal kill too)
            # It keeps FAIL only for a failure signal: a printed ::error line from any step, a failed install, or a failed
            # line before the suite. Install and preamble failures read unknown below, with their note. Any other dead read is unknown.
            state = "FAIL" if rc and (errored or install or not preamble_ran) else "unknown"
        if install and state == "FAIL":  # the tree at fault, not the change: unknown, never FAIL
            state, first = "unknown", "install failed, so each lint step after it is unknown; " + first
        elif state == "FAIL" and not preamble_ran:  # the same rule for a line before the suite of a CI step: the tree at fault
            state, first = "unknown", "a line before the suite failed, so the suite did not run; " + first
        if unstarted:
            first = "%s; also tool missing (%s)" % (first, "; ".join(unstarted))
        notes = pin_notes(log, start) if state == "PASS" and known_action(step) == "ste-lint" else []
        if notes:  # a passing lint with a stale pin: the lane keeps its place and moves the pin in a lane of its own
            first = "%s; %s" % (first, "; ".join(notes))
    return state, first


def append_log(src, dst, name):
    """Add a finished parallel CI step's log to the run's log, then delete it. A failed copy keeps the CI step's log and names
    it on stderr: its verdict names the run's log, which then lacks that output. Returns True when the log was kept."""
    try:
        with open(src, "rb") as f, open(dst, "ab") as g:
            shutil.copyfileobj(f, g)
    except OSError:
        err_line("ci-job: could not add the log of CI step %s to the run's log; its output is kept in %s\n" % (name, src))
        return True
    try:
        os.remove(src)
    except OSError:
        pass  # the copy is in; the folder's removal at the end of the run takes what is left
    return False


def suite_paths(step):
    """The suites a CI step runs: the path of each of its run: lines that is `python3 hooks|merge/test_<name>.py`, with
    arguments allowed. Any other line of the step stays in it, so a picked step runs whole, as CI runs it."""
    return [m.group(1) for ln in run_lines(step) if (m := SUITE_LINE.fullmatch(ln))]


def log_text(log, start):
    """This run's part of the log: from byte `start` on; empty when the log cannot be read."""
    try:
        with open(log, "rb") as f:
            f.seek(start)
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def preamble_marked(body, shell):
    """The CI step's run: body with PREAMBLE_DONE right before its first suite line, when a command line comes before it.
    The marker prints only when the shell reaches the suite line, so a failure with no marker in the log is the preamble's
    (a failed `[ -d x ] || npm ci`), and one after it is the suite's, even when a preamble block is skipped. None, so the
    CI step's failure reads as the suite's, when no command line precedes the suite line; when the suite line is indented,
    not plainly at the script's top level; when the line before it ends in `\\`, `&&`, `||` or `|`, so a marker would join that command list; and
    under pwsh, where a native command that fails does not stop the script, so a marker cannot show the preamble passed."""
    lines = body.splitlines()
    first = next((i for i, ln in enumerate(lines) if SUITE_LINE.fullmatch(ln.strip())), None)
    before = [ln for ln in lines[:first or 0] if ln.strip() and not ln.strip().startswith("#")]
    if shell == "pwsh" or not before or lines[first][:1].isspace() or before[-1].rstrip().endswith(("\\", "&&", "|")):  # "|" also ends "||"
        return None
    return "\n".join(lines[:first] + [PREAMBLE_DONE] + lines[first:]) + "\n"


LOG_KEEP = 86400  # a run with no $VERDICT_LOG removes the ci-job-*.log files in the temp folder that are over a day old


def prune_own_logs(folder, now=None):
    """Remove each regular ci-job-*.log in FOLDER whose mtime is over a day old. Errors are skipped; a fresh log (a parallel run's) stays."""
    now = time.time() if now is None else now
    try:
        with os.scandir(folder) as it:
            for e in it:
                try:
                    if (e.name.startswith("ci-job-") and e.name.endswith(".log") and e.is_file(follow_symlinks=False)
                            and now - e.stat(follow_symlinks=False).st_mtime > LOG_KEEP):
                        os.remove(e.path)
                except OSError:
                    pass
    except OSError:
        pass


def main(argv):
    args = list(argv)
    opts = {"--workflow": None, "--base": None}
    for key in opts:
        if key in args:
            i = args.index(key)
            if i + 1 >= len(args):
                print(USAGE)
                return 2
            opts[key] = args[i + 1]
            del args[i:i + 2]
    wanted = []  # --step names, in order given
    while "--step" in args:
        i = args.index("--step")
        if i + 1 >= len(args):
            print(USAGE)
            return 2
        wanted.append(args[i + 1])
        del args[i:i + 2]
    dry = "--plan" in args
    lint = "--lint" in args
    pinned = "--pinned" in args and not (dry or lint)
    args = [a for a in args if a not in ("--plan", "--lint", "--pinned")]
    if len(args) != 1 or (wanted and lint):
        print(USAGE)
        return 2
    job = args[0]
    top = git("rev-parse", "--show-toplevel") or os.getcwd()
    workflow = opts["--workflow"]
    if not workflow:
        workflow, why = job_workflow(top, job)
        if why:
            print("unknown  cannot read the workflow: %s" % why)
            return 2
    try:
        with open(workflow, encoding="utf-8") as f:
            text = f.read()
        block = job_block(text, job)
    except OSError as e:
        print("unknown  cannot read the workflow: %s" % e)
        return 2
    if block is None:
        print("unknown  no job %r in %s" % (job, workflow))
        return 2
    if re.search(r"^    (?:env|defaults):", block, re.M):
        print("unknown  job %r sets a job-level env: or defaults:, which this runner does not read" % job)
        return 2
    steps = step_blocks(block)
    names = [step_key(st, "name") or ("step %d" % n) for n, st in enumerate(steps, 1)]
    absent = [w for w in dict.fromkeys(wanted) if w not in names]
    if absent:  # a typo is told at once and costs no run
        for w in absent:
            print("%-15s --step %s: no step of job %r has this name" % ("unknown", w, job))
        return 2
    base, no_base = opts["--base"], False
    if lint and not base:
        # A no-base lint run once read as a pass while CI's pull-request steps failed: default to CI's base.
        if git("rev-parse", "--verify", "-q", "origin/main^{commit}", cwd=top):
            base = "origin/main"
            print("base: origin/main (default; pass --base to change)")
        else:
            idle = {"base": "", "github.base_ref": "", "github.event.pull_request.head.sha": "", "github.token": ""}
            unread = [step_key(st, "name") or ("step %d" % n) for n, st in enumerate(step_blocks(block), 1)
                      if is_lint(st) and plan(st, False, idle, top)[0] == "skipped"]
            if unread:
                print("unknown         no base resolved (origin/main is absent; pass --base), so these pull-request "
                      "steps are skipped: %s" % ", ".join(unread))
                no_base = True
    base_sha = git("rev-parse", "--verify", "-q", base + "^{commit}", cwd=top) if base else None
    values = {"base": base or "", "github.base_ref": base.split("/", 1)[1] if base and "/" in base else (base or ""),
              "github.event.pull_request.head.sha": os.environ.get(HEAD_SHA_ENV, "").strip() or git("rev-parse", "HEAD", cwd=top) or "",
              **({"github.event.pull_request.base.sha": base_sha} if base_sha else {}),  # a base that does not resolve leaves the expression unread
              "github.token": ""}  # no runner token here (RUNNER_UNSET): a step that maps it into GH_TOKEN reads gh's own login
    log = os.environ.get("VERDICT_LOG")
    if not log and not dry:
        prune_own_logs(tempfile.gettempdir())
        fd, log = tempfile.mkstemp(prefix="ci-job-%s-" % re.sub(r"[^\w-]", "_", job), suffix=".log")
        os.close(fd)
    tally = {"FAIL": 0, "unknown": int(no_base)}
    unshallow(block, top, dry, tally)
    SCOPE.update(flags=None, why=None, unknown=set())
    if lint and base:  # the flags CI's scope job gives this diff, so a step CI skips is skipped here
        SCOPE["flags"], SCOPE["why"] = scope_flags(top, base_sha, git("rev-parse", "--abbrev-ref", "HEAD", cwd=top) or "",
                                                   values["github.event.pull_request.head.sha"])
    kind = ["lint" if is_lint(st) else "install" if is_install(st) else "local" if LOCAL_ACTION.fullmatch(uses(st)) else ""
            for st in steps] if lint else [""] * len(steps)
    suites = [suite_paths(st) if lint and not k else [] for st, k in zip(steps, kind)]  # each step's suite lines
    elsewhere = {}  # each other job: the suites of its CI steps, which this run does not run
    if lint and base:
        for other in re.findall(r"^  ([\w-]+):\s*$", text.split("\njobs:", 1)[-1], re.M):
            found = {path for st in step_blocks(job_block(text, other)) for path in suite_paths(st)} if other != job else set()
            if found:
                elsewhere[other] = found
    picked, why = None, "no base to read a diff"
    if base and (any(suites) or elsewhere):  # one selector process for the CI steps with a suite in every job
        why = "the selector did not run"
        try:
            done = _nowindow.run([sys.executable, os.path.join(os.path.dirname(BIN), "hooks", "mutate_guard.py"),
                                  "--lint-suites", base], cwd=top, capture_output=True, text=True, encoding="utf-8",
                                 stdin=subprocess.DEVNULL, timeout=SELECTOR_LIMIT)
            if done.returncode == 0:
                picked = set(done.stdout.split())
            else:
                why = ((done.stdout + done.stderr).strip().splitlines() or ["exit %d with no message" % done.returncode])[-1]
        except subprocess.TimeoutExpired:
            why = "the selector ran past %d s and was stopped" % SELECTOR_LIMIT
        except OSError as e:
            why = str(e)
    for i, found in enumerate(suites):  # a step with a picked suite runs as a lint step does
        if picked is not None and picked.intersection(found):
            kind[i] = "suite"
    planned = [plan(st, bool(base), values, top, lint) if k not in ("", "local") else None for st, k in zip(steps, kind)]
    runs = [k == "lint" and p[0] == "run" for k, p in zip(kind, planned)]  # the lint steps the pool may queue
    ready = [local_ready(st, top, base) if k == "local" else (None, None) for st, k in zip(steps, kind)]
    # An install runs only if a lint step after it runs, or a local action after it that local_ready lets start.
    starts = [r or s is not None for r, (s, _) in zip(runs, ready)]
    ran, ran_lint, blocker = 0, 0, None  # blocker: the install step that did not finish
    ctx = (top, base, values, pinned)
    if SCOPE["unknown"]:
        gated = ", ".join(sorted(SCOPE["unknown"]))
        print("UNKNOWN scope   %s: each step gated on %s runs" % (SCOPE["why"] or "%s did not give %s" % (SCOPE_SCRIPT, gated), gated))
    workers = lint_workers() if lint and not dry else 1
    pool = concurrent.futures.ThreadPoolExecutor(workers) if workers > 1 else None  # one worker is the serial path
    logdir = tempfile.mkdtemp(prefix="ci-job-lint-%d-" % os.getpid()) if pool else None  # each parallel step's own log, until it is added to the run's
    kept_logs = False
    futures, logs = {}, {}  # by step index: the queued run, and its log
    try:
        for n, step in enumerate(steps, 1):
            name = names[n - 1]
            if wanted and name not in wanted:
                continue
            if suites[n - 1] and base and picked is None:  # the selector could not run: never a pass with no suite run
                tally["unknown"] += 1
                print("%-15s %s: --lint could not select suites: %s" % ("unknown", name, why))
                continue
            if lint and "failure()" in (step_key(step, "if") or "") and condition(step_key(step, "if"), True) is False:  # the red-job wake step: a green lint run never reaches it (decision ci-wait-reads-run-status)
                print("%-15s %s: runs only after a failed job; a lint run has none" % ("not run", name))
                continue
            if kind[n - 1] == "local":  # one line for the whole action, run here in order, never in the pool
                if blocker:  # a step after a failed install runs nothing, as a lint step does
                    tally["unknown"] += 1
                    print("%-15s %s: --lint did not run it: install step %s did not finish" % ("unknown", name, blocker))
                    continue
                state, line, started = local_action(name, step, ctx, log, dry, ready[n - 1])
                ran += started
                ran_lint += started
                print("%-15s %s" % (state, name) if state == "would run" else "%-15s %s: %s" % (state, name, line))
                if state in ("FAIL", "unknown"):
                    tally[state] += 1
                continue
            if lint and not kind[n - 1]:
                print("%-15s %s: --lint runs only lint and install steps; %s" % (
                    "not run", name, "this is an action (uses: %s)" % uses(step) if uses(step) else
                    "this is a suite the diff does not pick%s" % ("" if base else " (no base to read a diff)") if suites[n - 1]
                    else "its run: is neither a lint nor an install command"))
                continue
            if kind[n - 1] == "install" and (blocker or not any(starts[n:])):
                print("%-15s %s: %s" % ("not run", name, "install step %s did not finish" % blocker if blocker
                                        else "no lint step after it will run"))
                continue
            if kind[n - 1] == "lint" and blocker and runs[n - 1]:
                tally["unknown"] += 1
                print("%-15s %s: --lint did not run it: install step %s did not finish" % ("unknown", name, blocker))
                continue
            state, detail, shell, env, cwd = planned[n - 1] or plan(step, bool(base), values, top, lint, pinned)
            if lint and kind[n - 1] == "lint" and state == "skipped" and condition(step_key(step, "if"), True) is not False \
                    and not base:  # a required CI step (its if: reads true on a pull-request run) that did not run proved nothing
                state, detail = "unknown", "a pull-request step, skipped for want of a base (pass --base)"
            if state != "run":
                if wanted and state != "unknown":  # a named step that did not run proved nothing: never a pass
                    state, detail = "unknown", "--step named it, but it did not run (%s): %s" % (state, detail)
                print("%-15s %s: %s" % (state, name, detail))
                tally["unknown"] += state == "unknown"
                blocker = blocker or (name if kind[n - 1] == "install" and state == "unknown" else None)
                continue
            ran += 1
            ran_lint += kind[n - 1] in ("lint", "suite")  # a picked suite step that ran is a lint run too
            if dry:
                print("%-15s %s" % ("would run", name))
                continue
            install = kind[n - 1] == "install"
            if pool and kind[n - 1] == "lint":
                if n - 1 not in futures:  # the first step of a segment: queue each lint step up to the next install, in order
                    end = next((i for i in range(n, len(steps)) if kind[i] == "install"), len(steps))
                    for i in range(n - 1, end):
                        if runs[i]:
                            logs[i] = os.path.join(logdir, "%d.log" % i)
                            futures[i] = pool.submit(run_step, names[i], steps[i], False, planned[i][1], planned[i][2],
                                                     planned[i][3], planned[i][4], ctx, logs[i])
                state, first = futures.pop(n - 1).result()
                own = logs.pop(n - 1)
                if append_log(own, log, name):  # in CI step order, so the run's log reads as a serial run's
                    kept_logs = True
                first = first.replace(own, log)  # the verdict line names the log that stays
            else:
                state, first = run_step(name, step, install, detail, shell, env, cwd, ctx, log, kind[n - 1] == "suite")
            tally["FAIL" if state == "FAIL" else "unknown"] += state not in ("PASS", "SKIP")
            blocker = blocker or (name if install and state == "unknown" else None)
            if first.startswith(CACHE_MARK):  # a cached pass: the state reads PASS (cached), and counts as PASS above
                state, first = "PASS (cached)", first[len(CACHE_MARK):]
            print("%-15s %s: %s" % (state, name, first))
    finally:
        if pool:
            pool.shutdown(cancel_futures=True)
            if not kept_logs:  # a log that did not reach the run's log stays in the folder for the reader
                shutil.rmtree(os.path.abspath(logdir), ignore_errors=True)
    if lint and not ran_lint and not tally["FAIL"] and not tally["unknown"]:  # a pass that ran no lint CI step proved nothing; any other line already gives the exit
        tally["unknown"] += 1
        print("%-15s no lint CI step %s: %d of the job's %d steps are lint CI steps, and each one is skipped, not run, or unknown" % (
            "unknown", "would run" if dry else "ran", sum(k == "lint" for k in kind), len(steps)))
    if lint:
        for other, found in elsewhere.items():  # one line per job: picked, but each CI step belongs to a job this run is not
            if picked is not None and picked.intersection(found):
                print("%-15s job %s: picked %s; job %s runs them, not %s" % ("not run", other, ", ".join(sorted(picked & found)), other, job))
        if picked is None and elsewhere and not any(suites):
            print("%-15s suites of other jobs: --lint could not select them: %s" % ("not run", why))
        print("summary: %s %d of %d steps" % ("would run" if dry else "ran", ran, len(steps)))
    if not dry:
        print("log=%s" % log)
    return 1 if tally["FAIL"] else 2 if tally["unknown"] else 0


if __name__ == "__main__":
    _nowindow.end_on_signals()  # TERM and HUP end the run through the `finally` below, so the log folder, the pin trees and the work folder go
    try:
        sys.exit(main(sys.argv[1:]))
    finally:
        drop_pin_trees()
