#!/usr/bin/env node
// render FILE_OR_URL [--out FILE] [--width N] [--height N] [--theme light|dark] [--no-full-page]:
// one PNG of one page, then one verdict line. For a mockup or any page a lane wants to look at once.
// FILE_OR_URL is an http(s) or file URL, or a path to an HTML file. --out defaults to a new render-* folder in the temp folder.
// Defaults: width 1440, height 900, theme light, full page.
// Why this tool: a bare Playwright or Puppeteer Chromium on macOS asks for the owner's keychain password ("Chromium Safe Storage").
//   This tool launches Chromium with --use-mock-keychain and --password-store=basic, so nothing asks. The guard rule
//   browser-keychain (decision render-browser-no-keychain) refuses a launch without both. For many routes, sizes and themes use shoot.
// A render fails on a navigation error, a timeout, or an HTTP status of 400 or more.
// Playwright: the installed package only. This tool never runs `playwright install`.
// Exit: 0 the render passed, 1 it failed, 2 it could not run (usage, no Playwright, no browser).
// Cost: one browser process per run, closed at exit. One PNG. No daemon, no watcher.
// Test seam: RENDER_PLAYWRIGHT names the module to load (default playwright).
"use strict";
const fs = require("fs");
const os = require("os");
const path = require("path");
const { createRequire } = require("module");

// The two switches. The guard reads the same two literals (hooks/guard_browser.py BROWSER_FLAGS).
const CHROMIUM_ARGS = ["--use-mock-keychain", "--password-store=basic"];

function die(msg) { console.log("render: " + msg); process.exit(2); }

const USAGE = "usage: render FILE_OR_URL [--out FILE] [--width N] [--height N] [--theme light|dark] [--no-full-page]";

function args(argv) {
  const o = { target: null, out: null, width: 1440, height: 900, theme: "light", fullPage: true };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--no-full-page") o.fullPage = false;
    else if (["--out", "--width", "--height", "--theme"].includes(a) && i + 1 < argv.length) o[a.slice(2)] = argv[++i];
    else if (!a.startsWith("--") && o.target === null) o.target = a;
    else die(USAGE);
  }
  if (o.target === null) die(USAGE);
  for (const k of ["width", "height"]) {
    o[k] = Number(o[k]);
    if (!Number.isInteger(o[k]) || o[k] < 1) die(`--${k} is a whole number of pixels`);
  }
  if (o.theme !== "light" && o.theme !== "dark") die("--theme is light or dark");
  return o;
}

function loadPlaywright() {
  const id = process.env.RENDER_PLAYWRIGHT || "playwright";
  for (const req of [require, createRequire(path.join(process.cwd(), "package.json"))]) {
    try { return req(id); } catch { /* next */ }
  }
  die(`FAIL: Playwright is missing: require('${id}') does not resolve. Install the playwright package; this tool never installs it.`);
}

function toUrl(target) {
  if (/^(https?|file):/i.test(target)) return target;
  const file = path.resolve(target);
  if (!fs.existsSync(file)) die(`no such file: ${file}`);
  return "file://" + file.split(path.sep).map(encodeURIComponent).join("/");
}

async function main() {
  const o = args(process.argv.slice(2));
  const url = toUrl(o.target);
  const pw = loadPlaywright();
  const file = o.out ? path.resolve(o.out) : path.join(fs.mkdtempSync(path.join(os.tmpdir(), "render-")), "render.png");
  fs.mkdirSync(path.dirname(file), { recursive: true });
  let browser;
  try { browser = await pw.chromium.launch({ args: CHROMIUM_ARGS }); }
  catch (e) { die(`FAIL: Chromium did not launch: ${String(e.message).split("\n")[0]}. This tool never runs playwright install.`); }
  let failure = "";
  try {
    const page = await browser.newPage({ viewport: { width: o.width, height: o.height }, colorScheme: o.theme });
    const res = await page.goto(url, { waitUntil: "load", timeout: 15000 });
    if (res && res.status() >= 400) failure = `HTTP ${res.status()} at ${url}`;
    else await page.screenshot({ path: file, fullPage: o.fullPage, timeout: 15000 });
  } catch (e) {
    failure = `${String(e.message).split("\n")[0]} at ${url}`;
  } finally {
    await browser.close().catch(() => {});
  }
  if (failure) { console.log(`render: FAIL ${failure}`); process.exit(1); }
  console.log(`render: PASS 1 shot, 0 failed -> ${file}`);
}

if (require.main === module) main().catch((e) => die(`FAIL: ${String(e.message).split("\n")[0]}`));
module.exports = { CHROMIUM_ARGS };
