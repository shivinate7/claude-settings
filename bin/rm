#!/bin/sh
# claude-settings-rm-shim
# rm shim, ahead of the real rm on PATH (install.sh puts ~/.claude/bin first). Line 2 is the marker: the
# search for the real rm skips every file whose line 2 is this line, so two copies never call each other.
# CLAUDECODE unset, or uname -s says MINGW, MSYS or CYGWIN (each python start costs two more processes
# there): exec the real rm at once, with no python. CLAUDECODE set: a recursive call is refused
# whole when an operand is /, home, the cwd or a parent of the cwd (symlinks resolved), read by
# _rm_target_bad in hooks/guard_rm_var.py. No usable python, or a helper that cannot load or run: warn once,
# exec the real rm (decision rm-path-wrapper). install.ps1 does not land this file.
# On MINGW, MSYS and CYGWIN the shim never refuses: it execs the real rm, and guard.py judges the command text instead.

# Sets REAL to the first rm on PATH that is not a copy of this shim, else /bin/rm. No fork, no grep.
find_real() {
  REAL=/bin/rm
  _ifs=$IFS
  IFS=:
  for _d in $PATH; do
    IFS=$_ifs
    _p=${_d:-.}/rm
    if [ -f "$_p" ] && [ -x "$_p" ]; then
      _l1='' _l2=''
      { IFS= read -r _l1; case $_l1 in '#!'*) IFS= read -r _l2 ;; esac; } < "$_p" 2>/dev/null
      IFS=$_ifs
      if [ "$_l2" != "# claude-settings-rm-shim" ]; then REAL=$_p; return 0; fi
    fi
    IFS=:
  done
  IFS=$_ifs
}

find_real
[ -n "${CLAUDECODE:-}" ] || exec "$REAL" "$@"

# A call with no flag that holds r or R cannot be recursive: skip python. A superset of the python test.
_maybe=
for _a in "$@"; do case $_a in -*[rR]*) _maybe=1 ;; esac; done
[ -n "$_maybe" ] || exec "$REAL" "$@"

case $(uname -s 2>/dev/null) in MINGW*|MSYS*|CYGWIN*) exec "$REAL" "$@" ;; esac

# Python as the hook launchers in settings.json find it: python3, then python, never a WindowsApps (Store alias) path.
PY=
for _p in python3 python; do
  _c=$(command -v "$_p" 2>/dev/null) || continue
  case $_c in */[Ww]indows[Aa]pps/*) continue ;; esac
  PY=$_c
  break
done
if [ -z "$PY" ]; then
  echo "rm shim: python not found, so this call is not judged; running the real rm" >&2
  exec "$REAL" "$@"
fi

"$PY" -I - "$0" "$@" <<'PYEOF'
import os, sys

me, args = os.path.realpath(sys.argv[1]), sys.argv[2:]
rec, ops, flags = False, [], True
for a in args:   # flags are read anywhere before `--`: strict where BSD rm would not be
    if flags and a == "--":
        flags = False
    elif flags and a.startswith("--"):
        rec = rec or a == "--recursive"
    elif flags and a.startswith("-") and a != "-":
        rec = rec or "r" in a or "R" in a
    else:
        ops.append(a)
if not rec:
    sys.exit(0)
try:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(me)), "hooks"))
    from guard_rm_var import _rm_target_bad
    try:
        cwd = os.getcwd()
    except OSError:   # the cwd was removed: judge absolute operands against "/" and home, skip the rest
        cwd = None
    bad = [o for o in ops if (cwd is not None or o.startswith("/")) and _rm_target_bad(o, cwd or "/")]
except Exception as e:
    sys.stderr.write("rm shim: cannot judge this call (%s); running the real rm\n" % e)
    sys.exit(0)
if bad:
    sys.stderr.write(
        "rm: refused in a Claude session. Operand %r is /, the home folder, the working folder or a parent "
        "of it, and no part of the call ran. Name a narrower folder, or ask the owner to do it. "
        "No override lifts this refusal, because the shim runs inside the command, after the guard.\n" % bad[0])
    sys.exit(3)
PYEOF
[ $? -eq 3 ] && exit 1
exec "$REAL" "$@"
