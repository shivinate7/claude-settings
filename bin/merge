#!/usr/bin/env python3
# Shim for the merge tool. Finds the claude-settings checkout and starts merge/launch.py there.
# No merge logic lives here. Plan: plans/shared-merge-tool.md, "How the command finds claude-settings".
import os, re, subprocess, sys, tempfile
OK = r"(https://github\.com/|git@github\.com:)shivinate7/claude-settings(\.git)?/?"
def origin(d):
    r = subprocess.run(["git", "-C", d, "config", "--get", "remote.origin.url"], capture_output=True, text=True)
    return re.fullmatch(OK, r.stdout.strip()) is not None
def find():
    d = os.environ.get("CLAUDE_SETTINGS_DIR")
    if d: return d
    md = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "CLAUDE.md")
    try: text = open(md, encoding="utf-8-sig").read()
    except OSError: text = ""
    m = re.search(r"^@(\S.*?)[/\\]CLAUDE\.md\s*$", text, re.M)
    if m: return os.path.expanduser(m.group(1))
    d = tempfile.mkdtemp(prefix="claude-settings-")  # the repo is public: no credential needed
    if subprocess.run(["git", "clone", "-q", "https://github.com/shivinate7/claude-settings", d]).returncode: sys.exit("merge: clone of claude-settings failed")
    return d
d = find()
if not origin(d): sys.exit(f"merge: {d} is not a checkout of shivinate7/claude-settings; stopped before any PR read")
sys.exit(subprocess.run([sys.executable, os.path.join(d, "merge", "launch.py"), d] + sys.argv[1:]).returncode)
