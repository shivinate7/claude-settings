#!/usr/bin/env python3
# wait-pid PID [--timeout SECS]: wait until one pid ends. It only watches; it never signals the pid.
# Why: after a stall watch trips, the session holds a stranded job's pid and no loop may wait on it
# (hooks/guard_stream.py). This is the one allowed form. Ownership is judged by
# guard_kill.pid_is_session_job (the one home); the session id is $CLAUDE_CODE_SESSION_ID.
# Exit 0: the pid ended, or was not running at the start. 124: still running at --timeout
# (default 540, under Bash's 600 s cap; 0 means no cap). 2: a bad argument, pid 0, 1 or -1, or a
# pid that is not this session's ("not this session", at once, no wait).
# While it waits, print "wait-pid: still waiting for pid N, <s>s" every $WAIT_PID_HEARTBEAT s
# (default 120), so a quiet background run does not trip the stall watch.
# A pid reused by another process has a new start time, so a changed start time means it ended.
# Limits: the pid is not this helper's child, so its exit code cannot be recovered. Windows is not covered.
import os, re, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import guard_kill  # noqa: E402  the one home of the ownership read (hooks/guard_kill.py)
DEFAULT_TIMEOUT = 540.0
USAGE = "usage: wait-pid PID [--timeout SECS]"
LINUX = sys.platform.startswith("linux")
POLL = 0.25 if LINUX else 1.0
def snapshot(pid):
    """(state, start time) of the pid, or None when it is gone or a zombie."""
    try:
        if LINUX:
            with open("/proc/%d/stat" % pid, "rb") as f: data = f.read().decode("utf-8", "replace")
            rest = data[data.rindex(")") + 2:].split()  # fields 3 on; the name in field 2 may hold spaces
            state, start = rest[0], rest[19]  # field 22, the start time in ticks since boot
        else:
            out = subprocess.run(["ps", "-o", "stat=,lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=10).stdout.split()
            if not out: return None
            state, start = out[0], " ".join(out[1:])
    except (OSError, ValueError, IndexError, subprocess.SubprocessError): return None
    return None if state.startswith(("Z", "X")) else (state, start)
def die(message):
    print("wait-pid: " + message, file=sys.stderr); sys.exit(2)
def number(text, name):
    try: value = float(text)
    except ValueError: value = -1.0
    if value < 0 or value != value or value == float("inf"): die("bad %s %r. %s" % (name, text, USAGE))
    return value
def parse(argv):
    pid, timeout = None, DEFAULT_TIMEOUT
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--timeout" and args: timeout = number(args.pop(0), "timeout")
        elif arg.startswith("--timeout="): timeout = number(arg[len("--timeout="):], "timeout")
        elif pid is None and re.fullmatch(r"-?[0-9]+", arg): pid = int(arg)
        else: die("bad argument %r. %s" % (arg, USAGE))
    if pid is None: die(USAGE)
    if pid in (0, 1, -1): die("pid %d is never waited on. %s" % (pid, USAGE))
    return pid, timeout
def main(argv):
    pid, timeout = parse(argv)
    first = snapshot(pid)
    if first is None:
        print("wait-pid: pid %d is not running" % pid); return 0
    if not guard_kill.pid_is_session_job(pid, os.environ.get("CLAUDE_CODE_SESSION_ID", "")):
        print("wait-pid: pid %d is not this session's: not this session, so not waited on" % pid); return 2
    try: beat = float(os.environ.get("WAIT_PID_HEARTBEAT") or 120)
    except ValueError: beat = 120.0
    if beat <= 0: beat = 120.0
    t = time.monotonic()
    next_beat = t + beat
    while True:
        time.sleep(POLL)
        now = time.monotonic()
        current = snapshot(pid)
        if current is None or current[1] != first[1]:
            print("wait-pid: pid %d ended after %.0fs" % (pid, now - t), flush=True); return 0
        if timeout and now - t >= timeout:
            print("wait-pid: pid %d is still running after %.0fs" % (pid, now - t), flush=True); return 124
        if now >= next_beat:
            print("wait-pid: still waiting for pid %d, %.0fs" % (pid, now - t), flush=True)
            next_beat = now + beat
if __name__ == "__main__":
    for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")
    sys.exit(main(sys.argv[1:]))
