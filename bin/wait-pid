#!/usr/bin/env python3
# wait-pid PID [--timeout SECS]: wait until one pid ends. It only watches; it never signals the pid.
# Why: after a stall watch trips, the session holds a stranded job's pid and no loop may wait on it
# (hooks/guard_stream.py). This is the one allowed form. Ownership is judged by
# guard_kill.pid_is_session_job (the one home); the session id is $CLAUDE_CODE_SESSION_ID.
# Exit 0: the pid ended, or was not running at the start. 124: still running at --timeout
# (default 540, under Bash's 600 s cap; 0 means no cap). 2: a bad argument, pid 0, 1 or -1, or a
# pid that is not this session's ("not this session", at once, no wait). 3: unknown. The liveness
# read failed or timed out, so the helper cannot tell whether the pid lives; it is never taken as
# "ended". (`ps` exit 1 with no output at all is the one "gone" answer on non-Linux.)
# While it waits, print "wait-pid: still waiting for pid N, <s>s" every $WAIT_PID_HEARTBEAT s
# (default 120), so a quiet background run does not trip the stall watch.
# A pid reused by another process has a new start time, so a changed start time means it ended.
# Limits: the pid is not this helper's child, so its exit code cannot be recovered. Windows is not covered.
import errno, os, re, subprocess, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import guard_kill  # noqa: E402  the one home of the ownership read (hooks/guard_kill.py)
import _nowindow  # noqa: E402  the one home of a no-window child start (hooks/_nowindow.py)
import wait_common  # noqa: E402  the one home of the argument, heartbeat and poll parts both wait helpers share
PROG = "wait-pid"
USAGE = "usage: wait-pid PID [--timeout SECS]"
LINUX = sys.platform.startswith("linux")
POLL = 0.25 if LINUX else 1.0  # off Linux each poll starts `ps`
UNKNOWN = "unknown"  # snapshot's answer when the read failed: neither running nor gone
def snapshot(pid):
    """(state, start time) of the pid; None when it is gone or a zombie; UNKNOWN when the read failed."""
    try:
        if LINUX:
            try:
                with open("/proc/%d/stat" % pid, "rb") as f: data = f.read().decode("utf-8", "replace")
            except OSError as e:
                return None if e.errno in (errno.ENOENT, errno.ESRCH) else UNKNOWN
            rest = data[data.rindex(")") + 2:].split()  # fields 3 on; the name in field 2 may hold spaces
            state, start = rest[0], rest[19]  # field 22, the start time in ticks since boot
        else:
            done = _nowindow.run(["ps", "-o", "stat=,lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=10)
            out = done.stdout.split()
            if not out:
                # `ps` exits 1 with no output at all for no such process; any other empty answer is a failure
                return None if done.returncode == 1 and not done.stderr.strip() else UNKNOWN
            if done.returncode != 0: return UNKNOWN
            state, start = out[0], " ".join(out[1:])
    except (OSError, ValueError, IndexError, subprocess.SubprocessError): return UNKNOWN
    return None if state.startswith(("Z", "X")) else (state, start)
def unknown(pid):
    print("wait-pid: pid %d: liveness unknown, the read of its state failed; not taken as ended" % pid, flush=True); return 3
def parse(argv):
    text, timeout = wait_common.split_args(PROG, USAGE, argv)
    if text is None or not re.fullmatch(r"-?[0-9]+", text):
        wait_common.die(PROG, USAGE if text is None else "bad argument %r. %s" % (text, USAGE))
    pid = int(text)
    if pid in (0, 1, -1): wait_common.die(PROG, "pid %d is never waited on. %s" % (pid, USAGE))
    return pid, timeout
def main(argv):
    pid, timeout = parse(argv)
    first = snapshot(pid)
    if first == UNKNOWN: return unknown(pid)
    if first is None:
        print("wait-pid: pid %d is not running" % pid); return 0
    if not guard_kill.pid_is_session_job(pid, os.environ.get("CLAUDE_CODE_SESSION_ID", "")):
        print("wait-pid: pid %d is not this session's: not this session, so not waited on" % pid); return 2
    def step(elapsed):
        current = snapshot(pid)
        if current == UNKNOWN: return unknown(pid)
        if current is None or current[1] != first[1]:
            print("wait-pid: pid %d ended after %.0fs" % (pid, elapsed), flush=True); return 0
    return wait_common.wait_loop(PROG, step, timeout, wait_common.heartbeat_seconds("WAIT_PID_HEARTBEAT"),
                                 lambda s: "still waiting for pid %d, %.0fs" % (pid, s),
                                 lambda s: "pid %d is still running after %.0fs" % (pid, s), POLL)
if __name__ == "__main__":
    for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")
    sys.exit(main(sys.argv[1:]))
