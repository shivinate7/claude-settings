#!/usr/bin/env python3
"""Writes Tokens.swift from tokens/tokens.json, the one source of colours and spacing.

    python3 tools/gen-tokens.py            write it
    python3 tools/gen-tokens.py --check    exit 1 when the committed file differs from a fresh build

Run from the repo root. Never edit Tokens.swift by hand. Standard library only.
"""
import json
import re
import sys

SOURCE = "tokens/tokens.json"
OUTPUT = "native/__APP__Kit/Sources/__APP__Kit/Tokens.swift"
HEX = re.compile(r"^#([0-9A-Fa-f]{6})$")
NAME = re.compile(r"^[a-z][A-Za-z0-9]*$")


def color(value):
    match = HEX.match(value)
    if not match:
        raise ValueError("not a #RRGGBB colour: %r" % value)
    return "Color(rgb: 0x%s)" % match.group(1).upper()


def render(tokens):
    colors, space = tokens["color"], tokens["space"]
    for name in list(colors) + list(space):
        if not NAME.match(name):
            raise ValueError("not a Swift name: %r" % name)
    out = ["// Generated by tools/gen-tokens.py from %s. Do not edit." % SOURCE, "import SwiftUI", "",
           "public struct ThemeColors: Sendable {"]
    out += ["    public let %s: Color" % name for name in colors]
    for theme in ("light", "dark"):
        values = ", ".join("%s: %s" % (name, color(colors[name][theme])) for name in colors)
        out.append("    public static let %s = ThemeColors(%s)" % (theme, values))
    out += ["}", "", "public enum Space {"]
    out += ["    public static let %s: CGFloat = %s" % (name, space[name]) for name in space]
    out += ["}", "", "extension Color {",
            "    init(rgb: UInt32) {",
            "        self.init(red: Double((rgb >> 16) & 0xFF) / 255, green: Double((rgb >> 8) & 0xFF) / 255,",
            "                  blue: Double(rgb & 0xFF) / 255)",
            "    }", "}", ""]
    return "\n".join(out)


def main(argv):
    with open(SOURCE, encoding="utf-8") as f:
        text = render(json.load(f))
    if argv == ["--check"]:
        try:
            with open(OUTPUT, encoding="utf-8") as f:
                same = f.read() == text
        except OSError:
            same = False
        if not same:
            print("%s is stale: run `make tokens`" % OUTPUT, file=sys.stderr)
            return 1
        return 0
    if argv:
        print(__doc__, file=sys.stderr)
        return 2
    with open(OUTPUT, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
