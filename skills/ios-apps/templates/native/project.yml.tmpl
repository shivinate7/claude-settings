# XcodeGen spec. `make project` writes __APP__.xcodeproj from it. Never commit the .xcodeproj.
name: __APP__
options:
  bundleIdPrefix: __BUNDLE_PREFIX__
  deploymentTarget:
    iOS: "26.0"
settings:
  base:
    SWIFT_VERSION: "6.0"
    CODE_SIGN_STYLE: Automatic
    # ios-ship sets the build number at archive time, so each upload rises.
    CURRENT_PROJECT_VERSION: "1"
    MARKETING_VERSION: "1.0"
packages:
  __APP__Kit:
    path: __APP__Kit
targets:
  __APP__:
    type: application
    platform: iOS
    sources: [__APP__]
    dependencies:
      - package: __APP__Kit
    info:
      path: __APP__/Info.plist
      properties:
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        CFBundleShortVersionString: $(MARKETING_VERSION)
        UILaunchScreen: {}
        ITSAppUsesNonExemptEncryption: false
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: __BUNDLE_ID__
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
  __APP__UITests:
    type: bundle.ui-testing
    platform: iOS
    sources: [__APP__UITests]
    dependencies:
      - target: __APP__
    settings:
      base:
        GENERATE_INFOPLIST_FILE: YES
schemes:
  __APP__:
    build:
      targets:
        __APP__: all
    test:
      targets: [__APP__UITests]
