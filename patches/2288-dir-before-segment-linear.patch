+            at = len(self.before)
+            self.before.append(None if self.skipping else self.where)
+            self.last = segments[at]
+            self._pass(at)
+        if number >= len(segments):
+            return self.where
+        return None if self.skipping else self.where
+
+    def _end(self, at):
