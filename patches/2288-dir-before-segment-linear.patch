+class _DirWalk:
+    """One walk over a command's segments, kept so that the next `dir_before_segment` call on the same
+    segments resumes it. A rule that judges every segment asks for each one's folder in turn: a walk from
+    the first segment for each ask grows as the square of the segments, so the walk runs ahead only as
+    far as the furthest ask and answers an earlier ask from what it saw. The segments and ends are read,
+    never changed, while a walk is kept."""
+
+    def __init__(self, segments, ends, shell_cwd, failed_cd_stays):
+        self.segments, self.ends, self.failed_cd_stays = segments, ends, failed_cd_stays
+        self.size = (len(segments), len(ends))
+        self.powershell = POWERSHELL_CALL[0]
+        self.where = shell_cwd if shell_cwd and os.path.isabs(shell_cwd) else None
+        self.prev, self.stack = None, []
+        self.skipping = False   # a failed cd ended in `&&`: the rest of the chain does not run
+        self.last = None   # the segment last walked past
+        self.before = []   # before[at]: what `dir_before_segment` answers for segments[at], for each one walked past
+        self.background = {}   # at: `_in_background_list` for a segment that starts at paren depth 0
+
+    def fresh_for(self, segments, ends):
+        """True when this walk still reads these segments: no segment was added, and the last one it
+        walked past is the same text object."""
+        return (self.size == (len(segments), len(ends))
+                and (not self.before or segments[len(self.before) - 1] is self.last))
+
+    def folder_before(self, number):
+        segments = self.segments
+        if number < len(self.before):
+            return self.before[number]
