+    def _in_background_list(self, at: int) -> bool:
+        """True when `segments[at]` is in a list that a lone `&` ends (an end of `&`, as `_split_jobs` gives
+        it). Bash runs that whole list in a subshell: in `cd a && b &` the `cd` moves no shell, as in
+        `cd a &`. The list runs on through `&&`, `||` and `|` up to its first other end. A `&` inside a
+        `( ... )` that opens after the segment ends that group's own list, not this one. A scan that
+        reaches a segment at paren depth 0 reads on as that segment's own scan would, so every such
+        segment it passed gets the one answer, and a chain of `cd a && cd b && ...` is read once."""
+        depth, answer, starts = 0, False, []
+        for later in range(at, len(self.segments)):
+            if not depth:
+                if later in self.background:
+                    answer = self.background[later]
+                    break
+                starts.append(later)
+            opens, closes = _cd_facts(self.segments[later], self.powershell)[:2]
+            depth += opens - closes
+            if depth < 0:
+                break   # the group that holds the segment closes: its own paren restores the folder
+            if depth:
